---
// The v1 request form. Sends through Web3Forms (free, works on a static site) to info@aefactorysales.com.
// kind="visit" (default): asks for a free site visit, then goes to /thank-you/.
// kind="screens": screen shoppers fill this in and a rep calls them with a quote. Confirms in place.
import { SITE } from '../data/site';
interface Props { id?: string; compact?: boolean; source?: string; kind?: 'visit' | 'screens'; garage?: boolean }
const { id = 'visit', compact = false, source = 'Website', kind = 'visit', garage = false } = Astro.props;
const scr = kind === 'screens';
---
<p class="fast">Prefer to talk? Call <a href={SITE.phoneHref}>{SITE.phone}</a>, 9 am to 5 pm, 7 days a week.</p>
<div class="qf-wrap">
<form class="form quote-form" id={id} data-key={SITE.formKey} data-next={scr ? undefined : '/thank-you/'} data-inline={scr ? '1' : undefined} data-invalid="Please add your name, phone, street address and a 5-digit ZIP code so we can reach you." novalidate>
  <input type="hidden" name="subject" value={scr ? 'SCREEN QUOTE request from aefactorysales.com' : 'New site visit request from aefactorysales.com'} />
  <input type="hidden" name="request" value={scr ? 'Screens: rep to call with a quote' : 'Site visit'} />
  <input type="hidden" name="from_name" value="AE website" />
  <input type="hidden" name="lead_source" value={source} />
  <input type="hidden" name="estimate" value="" />
  <label class="hp" aria-hidden="true">Leave this empty <input type="checkbox" name="botcheck" tabindex="-1" /></label>
  <div class="field"><label for={`${id}-name`}>Name</label><input id={`${id}-name`} name="name" autocomplete="name" maxlength="80" required /></div>
  <div class="field"><label for={`${id}-phone`}>Phone</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="20" pattern="[0-9()+.\- ]{10,20}" required /></div>
  <div class="field"><label for={`${id}-email`}>Email (optional)</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="120" /></div>
  <div class="field full"><label for={`${id}-street`}>Street address of the project</label><input id={`${id}-street`} name="street" autocomplete="street-address" maxlength="120" required /></div>
  <div class="field"><label for={`${id}-city`}>City</label><input id={`${id}-city`} name="city" autocomplete="address-level2" maxlength="60" /></div>
  <div class="field"><label for={`${id}-zip`}>ZIP code</label><input id={`${id}-zip`} name="zip" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}" maxlength="5" required /></div>
  {!compact && (
    <>
      <div class="field"><label for={`${id}-project`}>What are you thinking about?</label>
        <select id={`${id}-project`} name="project">
          {scr ? (
            <>
              <option>Not sure which screen</option>
              <option>Hexfold retractable screens</option>
              <option>Fixed stainless steel screens</option>
              <option selected={garage}>Garage screen</option>
              <option>Screen door</option>
            </>
          ) : (
            <>
              <option>Not sure yet</option>
              <option>3-season room (polycarbonate panels)</option>
              <option>Hexfold retractable screens</option>
              <option>Fixed stainless steel screens</option>
              <option>Mix of panels and screens</option>
              <option>Garage screen</option>
            </>
          )}
        </select>
      </div>
      {garage ? (
        <div class="field"><label for={`${id}-size`}>Garage door</label>
          <select id={`${id}-size`} name="patio_size">
            <option>Not sure</option>
            <option>Single door (about 8 or 9 ft wide)</option>
            <option>Double door (about 16 ft wide)</option>
            <option>Two or three separate doors</option>
            <option>Wider than 16 ft</option>
          </select>
        </div>
      ) : (
        <div class="field"><label for={`${id}-size`}>Patio size</label>
          <select id={`${id}-size`} name="patio_size">
            <option>Not sure</option>
            <option>Small (about 12 × 10 ft)</option>
            <option>Medium (about 20 × 12 ft, two open sides)</option>
            <option>Large (about 22 × 14 ft, three open sides, or bigger)</option>
          </select>
        </div>
      )}
    </>
  )}
  <div class="field"><label for={`${id}-time`}>Best time to call</label>
    <select id={`${id}-time`} name="best_time"><option>Any time</option><option>Morning</option><option>Afternoon</option><option>Evening</option></select>
  </div>
  <div class="field"><label for={`${id}-hoa`}>HOA?</label>
    <select id={`${id}-hoa`} name="hoa"><option>Not sure</option><option>Yes</option><option>No</option></select>
  </div>
  <div class="field full"><label for={`${id}-notes`}>Anything we should know? (optional)</label><textarea id={`${id}-notes`} name="message" maxlength="1500"></textarea></div>
  <input type="hidden" name="consent_text" value="By sending this, you agree AE Factory Sales may call, text or email you about your request. Message and data rates may apply. We never sell your information." />
  <div class="form-foot">
    <button class="btn" type="submit">{scr ? 'Have a rep call me about a quote' : 'Request my site visit'}</button>
    <small>{scr ? <>A rep calls you to go over your screens and give you a quote. Have photos? Text them to {SITE.phone}.</> : <>We call you back to set a time. No pressure, no obligation. Have photos? Text them to {SITE.phone}.</>}</small>
  </div>
  <p class="fine qf-priv">By sending this, you agree AE Factory Sales may call, text or email you about your request. Message and data rates may apply. We never sell your information. <a href="/privacy/">Privacy</a></p>
  <p class="form-note" role="status" hidden></p>
</form>
{scr && (
  <div class="cb-done qf-done" hidden>
    <p class="cb-big">Got it.</p>
    <p>A rep will reply within 1 business day with a quote for your screens. Need us now? <a href={SITE.phoneHref}>Call {SITE.phone}</a></p>
  </div>
)}
</div>
<style>
  .qf-done { display: grid; gap: 10px; border: 2px solid var(--yellow); padding: 20px; }
  .qf-done[hidden] { display: none; }
  .qf-done .cb-big { font-weight: 900; font-stretch: 70%; font-size: 1.8rem; text-transform: uppercase; color: var(--yellow); }
</style>

<script>
  import '../scripts/forms';
</script>
