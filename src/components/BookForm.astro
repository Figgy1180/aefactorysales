---
// "Book free design visit": the short form. Contact details and project address, with optional size notes and photos.
// The price questionnaire lives at /free-quote/ ("Get my estimate now").
import { SITE } from '../data/site';
interface Props { id?: string; source?: string }
const { id = 'book', source = 'Book free design visit' } = Astro.props;
const photos = SITE.photoUploads || !!import.meta.env.PUBLIC_PREVIEW; // preview shows the field; forms send nothing there
---
<form class="form quote-form book-form" id={id} data-key={SITE.formKey} data-next="/thank-you/" enctype="multipart/form-data" data-invalid="Please add your name, phone, street address and a 5-digit ZIP code so we can reach you." novalidate>
  <input type="hidden" name="subject" value="Design visit request" />
  <input type="hidden" name="from_name" value="AE website" />
  <input type="hidden" name="lead_source" value={source} />
  <label class="hp" aria-hidden="true">Leave this empty <input type="checkbox" name="botcheck" tabindex="-1" /></label>

  <fieldset class="bf-group">
    <legend>Your contact details</legend>
    <div class="field"><label for={`${id}-name`}>Name</label><input id={`${id}-name`} name="name" autocomplete="name" maxlength="80" required /></div>
    <div class="field"><label for={`${id}-phone`}>Phone</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="20" pattern="[0-9()+.\- ]{10,20}" required /></div>
    <div class="field full"><label for={`${id}-email`}>Email (optional)</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="120" /></div>
  </fieldset>

  <fieldset class="bf-group">
    <legend>Where is the patio?</legend>
    <div class="field full"><label for={`${id}-street`}>Street address</label><input id={`${id}-street`} name="street" autocomplete="street-address" maxlength="120" required /></div>
    <div class="field"><label for={`${id}-city`}>City</label><input id={`${id}-city`} name="city" autocomplete="address-level2" maxlength="60" /></div>
    <div class="field"><label for={`${id}-zip`}>ZIP code</label><input id={`${id}-zip`} name="zip" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}" maxlength="5" required /></div>
  </fieldset>

  <fieldset class="bf-group">
    <legend>Help us prepare <span class="opt-tag">optional</span></legend>
    <div class="field"><label for={`${id}-openings`}>Number of open sides</label>
      <select id={`${id}-openings`} name="open_sides"><option value="">Not sure</option><option>1</option><option>2</option><option>3</option><option>4 or more</option></select>
    </div>
    <div class="field"><label for={`${id}-dims`}>Rough size of each opening</label><input id={`${id}-dims`} name="estimated_dimensions" maxlength="200" placeholder="e.g. 16 ft wide × 9 ft tall" /></div>
    {photos ? (
      <div class="field full"><label for={`${id}-photos`}>Photos of your patio</label>
        <input id={`${id}-photos`} name="attachment" type="file" accept="image/jpeg,image/png,image/heic,image/webp" multiple data-max-files="3" data-max-mb="5" />
        <small class="hint">Up to 3 photos, 5 MB each. A straight-on shot of each open side helps most.</small>
      </div>
    ) : (
      <p class="field full hint">Have photos? Text them to <a href={SITE.phoneHref}>{SITE.phone}</a> after you book, or reply to our email.</p>
    )}
    <div class="field full"><label for={`${id}-notes`}>Anything else? (optional)</label><textarea id={`${id}-notes`} name="message" maxlength="1500" placeholder="Best days or times for a visit, HOA, pets, anything else"></textarea></div>
  </fieldset>
  <input type="hidden" name="consent_text" value="By sending this, you agree AE Factory Sales may call, text or email you about your request. Message and data rates may apply. We never sell your information." />

  <div class="form-foot">
    <button class="btn btn-big" type="submit">Book my free design visit</button>
    <p class="form-note" role="status" hidden></p>
  </div>
  <p class="fine">By sending this, you agree AE Factory Sales may call, text or email you about your request. Message and data rates may apply. We never sell your information. <a href="/privacy/">Privacy</a></p>
  <p class="fine">Prefer to talk? Call <a href={SITE.phoneHref}>{SITE.phone}</a>, 9 am to 5 pm, 7 days a week.</p>
</form>
<script>
  import '../scripts/forms';
  // Keep photo picks within limits before anything is sent.
  document.querySelectorAll<HTMLInputElement>('input[type=file][data-max-files]').forEach((inp) => {
    inp.addEventListener('change', () => {
      const max = Number(inp.dataset.maxFiles), mb = Number(inp.dataset.maxMb);
      const files = Array.from(inp.files || []);
      const bad = files.length > max || files.some((f) => f.size > mb * 1024 * 1024 || !/^image\//.test(f.type || 'image/heic'));
      inp.setCustomValidity(bad ? `Please choose up to ${max} photos, ${mb} MB each.` : '');
      if (bad) inp.reportValidity();
    });
  });
</script>
<style>
  .form.book-form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px; }
  .book-form .hint.field { display: block; }
  .bf-group { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 16px; }
  .bf-group legend { font-family: var(--font-head); font-weight: 700; font-size: 1.12rem; margin-bottom: 4px; display: flex; gap: 8px; align-items: baseline; }
  .opt-tag { font-family: var(--mono); font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--ink-2); }
  .bf-group .full { grid-column: 1 / -1; }
  .hint { font-size: .9rem; color: var(--ink-2); }
  .book-form input[type=file] { width: 100%; padding: 10px; border: 1.5px dashed var(--line); border-radius: var(--radius); background: transparent; color: var(--ink); font: inherit; }
  .book-form .fine a, .book-form .hint a { color: var(--yellow); }
  @media (max-width: 560px) { .bf-group { grid-template-columns: minmax(0, 1fr); } }
</style>
