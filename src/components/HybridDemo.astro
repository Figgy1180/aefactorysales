---
// Hybrid operation diagram. Two independent fan-folding layers on the same opening, each tracked top and bottom:
// metal mesh stacks at the left end, polycarbonate stacks at the right end. Handles sit on the moving leading edges.
// Schematic only (not to scale); stack size depends on the configuration, so no exact dimension is shown.
---
<figure class="hd" data-hd data-state="mesh">
  <div class="hd-ctrl" role="group" aria-label="Show the Hybrid in this position">
    <button type="button" data-s="mesh" aria-pressed="true">Mesh closed</button>
    <button type="button" data-s="pc" aria-pressed="false">Panels closed</button>
    <button type="button" data-s="open" aria-pressed="false">Both open</button>
  </div>
  <svg viewBox="0 0 640 340" role="img" aria-labelledby="hd-t hd-d">
    <title id="hd-t">Hybrid system diagram</title>
    <desc id="hd-d">A patio opening with a top track and a bottom track. A metal mesh layer folds out from a stack on the left, and a polycarbonate panel layer folds out from a stack on the right. Either layer can cover the whole opening, or both can fold back to the ends.</desc>
    <defs>
      <pattern id="hd-mesh" width="7" height="8" patternUnits="userSpaceOnUse">
        <path d="M3.5 0L7 2v4L3.5 8 0 6V2z" fill="none" stroke="#D9D2C7" stroke-width=".6" opacity=".8" />
      </pattern>
      <pattern id="hd-fold" width="18" height="10" patternUnits="userSpaceOnUse">
        <rect width="9" height="10" fill="#000" opacity=".22" />
        <rect x="8.4" width="1.2" height="10" fill="#fff" opacity=".35" />
      </pattern>
    </defs>
    <!-- opening: posts, header, slab, yard beyond -->
    <rect x="40" y="30" width="560" height="270" fill="#9FB7A6" />
    <rect x="40" y="200" width="560" height="100" fill="#7E9C76" />
    <path d="M40 200 Q 200 170 330 190 T 600 180" fill="none" stroke="#6E8E66" stroke-width="2" />
    <rect x="20" y="10" width="600" height="20" fill="#3B3430" />
    <rect x="20" y="10" width="20" height="300" fill="#3B3430" />
    <rect x="600" y="10" width="20" height="300" fill="#3B3430" />
    <rect x="0" y="300" width="640" height="40" fill="#CFC8BC" />
    <!-- tracks -->
    <rect x="40" y="30" width="560" height="9" fill="#1F1B18" />
    <rect x="40" y="292" width="560" height="6" fill="#1F1B18" />
    <!-- mesh layer: folds out from the left -->
    <g class="hd-layer hd-mesh">
      <rect x="40" y="39" width="560" height="253" fill="#2B2A28" opacity=".55" />
      <rect x="40" y="39" width="560" height="253" fill="url(#hd-mesh)" />
      <rect x="40" y="39" width="560" height="253" fill="url(#hd-fold)" opacity=".5" />
    </g>
    <g class="hd-handle hd-mh"><rect x="592" y="140" width="6" height="52" rx="2" fill="#F2C230" /></g>
    <!-- polycarbonate layer: folds out from the right -->
    <g class="hd-layer hd-pc">
      <rect x="40" y="39" width="560" height="253" fill="#4A4F55" opacity=".62" />
      <rect x="40" y="39" width="560" height="253" fill="url(#hd-fold)" opacity=".7" />
    </g>
    <g class="hd-handle hd-ph"><rect x="42" y="140" width="6" height="52" rx="2" fill="#F2C230" /></g>
    <!-- labels -->
    <text x="320" y="24" text-anchor="middle" class="hd-lbl">Top track carries the weight</text>
    <text x="320" y="327" text-anchor="middle" class="hd-lbl hd-lbl-dark">Bottom guide keeps every leaf in line</text>
  </svg>
  <figcaption>
    <p class="hd-say" aria-live="polite">Mesh closed: honeycomb aluminum mesh covers the whole opening for airflow with the bugs outside. The panels wait folded at the right end.</p>
    <p class="concept">Schematic, not to scale. Stack size depends on the opening and configuration.</p>
  </figcaption>
</figure>

<style>
  .hd { margin: 0; display: grid; gap: 14px; }
  .hd-ctrl { display: flex; flex-wrap: wrap; gap: 8px; }
  .hd-ctrl button { min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--line); background: transparent; color: var(--ink); font: inherit; font-weight: 600; cursor: pointer; }
  .hd-ctrl button[aria-pressed="true"] { background: var(--yellow); border-color: var(--yellow); color: var(--honey); }
  .hd-ctrl button:focus-visible { outline: 3px solid var(--yellow); outline-offset: 3px; }
  .hd svg { width: 100%; height: auto; display: block; border-radius: 8px; box-shadow: var(--shadow); background: #CFC8BC; }
  .hd-lbl { font: 600 13px var(--font); fill: #F2C230; }
  .hd-lbl-dark { fill: #2A2522; }
  .hd-say { color: var(--ink-2); min-height: 3.2em; }
  .hd-layer, .hd-handle { transition: transform .7s cubic-bezier(.3,.7,.2,1); transform-box: view-box; }
  .hd-mesh { transform-origin: 40px 0; }
  .hd-pc { transform-origin: 600px 0; }
  /* States. Scaling the layer compresses its fold lines, which is how a fan-folding leaf stack behaves. */
  [data-state="mesh"] .hd-mesh { transform: scaleX(1); }
  [data-state="mesh"] .hd-mh { transform: translateX(0); }
  [data-state="mesh"] .hd-pc { transform: scaleX(.07); }
  [data-state="mesh"] .hd-ph { transform: translateX(519px); }
  [data-state="pc"] .hd-pc { transform: scaleX(1); }
  [data-state="pc"] .hd-ph { transform: translateX(0); }
  [data-state="pc"] .hd-mesh { transform: scaleX(.07); }
  [data-state="pc"] .hd-mh { transform: translateX(-519px); }
  [data-state="open"] .hd-mesh { transform: scaleX(.07); }
  [data-state="open"] .hd-mh { transform: translateX(-519px); }
  [data-state="open"] .hd-pc { transform: scaleX(.07); }
  [data-state="open"] .hd-ph { transform: translateX(519px); }
  @media (prefers-reduced-motion: reduce) { .hd-layer, .hd-handle { transition: none; } }
</style>

<script>
  const SAY: Record<string, string> = {
    mesh: 'Mesh closed: honeycomb aluminum mesh covers the whole opening for airflow with the bugs outside. The panels wait folded at the right end.',
    pc: 'Panels closed: polycarbonate covers the whole opening to block wind and rain. The mesh waits folded at the left end.',
    open: 'Both open: each layer folds back to its own end, leaving the opening clear for access.',
  };
  document.querySelectorAll<HTMLElement>('[data-hd]').forEach((fig) => {
    const say = fig.querySelector('.hd-say')!;
    fig.querySelectorAll<HTMLButtonElement>('[data-s]').forEach((b) => b.addEventListener('click', () => {
      fig.dataset.state = b.dataset.s!;
      fig.querySelectorAll('[data-s]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      say.textContent = SAY[b.dataset.s!];
    }));
  });
</script>
