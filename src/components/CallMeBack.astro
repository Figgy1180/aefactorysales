---
// Site-wide "Book free visit" dialog. Opens from any [data-cb-open] button (header, floating button,
// mobile bar, section buttons). Same two required fields as before (name, phone), so it stays fast.
import { SITE } from '../data/site';
import BookVisitForm from './BookVisitForm.astro';
---
<button class="cb-fab" type="button" data-cb-open aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 10h18M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="2"/></svg>
  Book free visit
</button>

<dialog class="cb" id="callback" aria-labelledby="cb-title">
  <div class="cb-head">
    <h2 id="cb-title">Book your free site visit</h2>
    <button type="button" class="cb-x" data-cb-close aria-label="Close">&times;</button>
  </div>
  <p class="cb-lede">We come to your patio, measure, bring samples and leave you a written quote.</p>
  <BookVisitForm id="cb-form" />
  <p class="cb-alt">Rather call yourself? <a href={SITE.phoneHref}>{SITE.phone}</a></p>
</dialog>

<style>
  .cb-fab { position: fixed; right: 22px; bottom: 22px; z-index: 45; display: inline-flex; align-items: center; gap: 10px; padding: 14px 20px; border: 2px solid var(--honey); background: var(--yellow); color: var(--honey); font: inherit; font-weight: 800; font-stretch: 80%; font-size: 1.05rem; text-transform: uppercase; cursor: pointer; box-shadow: 0 6px 22px rgba(0, 0, 0, .35); }
  .cb-fab svg { width: 20px; height: 20px; }
  .cb-fab:hover { transform: translateY(-2px); }
  .cb-fab:focus-visible { outline: 3px solid var(--cream); outline-offset: 3px; }
  @media (max-width: 1060px) { .cb-fab { display: none; } }
  .cb { width: min(480px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); border: 3px solid var(--yellow); background: var(--honey); color: var(--ink); padding: 26px 26px 20px; box-sizing: border-box; }
  .cb::backdrop { background: rgba(0, 0, 0, .6); }
  .cb-head { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
  .cb h2 { font-weight: 900; font-stretch: 70%; font-size: 2rem; line-height: 1; text-transform: uppercase; margin: 0; }
  .cb-x { background: none; border: 0; color: var(--ink); font-size: 2rem; line-height: 1; cursor: pointer; padding: 0 4px; min-width: 44px; min-height: 44px; }
  .cb-lede { color: var(--ink-2); margin: 10px 0 16px; }
  .cb-alt { margin-top: 14px; font-size: var(--step--1); color: var(--ink-2); text-align: center; }
  .cb a { color: var(--yellow); }
</style>

<script>
  // Load the shared submit handler here too: pages without a quote form (like the homepage) need it.
  import '../scripts/forms';
  const dlg = document.getElementById('callback') as HTMLDialogElement | null;
  if (dlg) {
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const opener = t.closest<HTMLElement>('[data-cb-open]');
      if (opener) {
        // A button that points at the on-page booking form scrolls there instead, when the form exists.
        const inline = opener.getAttribute('href') === '#book' && document.getElementById('book');
        if (inline) return;
        e.preventDefault();
        dlg.showModal();
        (dlg.querySelector('input[name=name]') as HTMLInputElement | null)?.focus();
      } else if (t.closest('[data-cb-close]')) {
        dlg.close();
      } else if (t === dlg) {
        dlg.close();
      }
    });
  }
</script>
