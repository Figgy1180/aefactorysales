---
// Forwards an old door-hanger address to its section on the 3-season rooms page.
// Keeps a QR scan's ?src= tag, or tags a typed address as "<campaign>-url", so lead emails
// still say which hanger brought the visitor in. Not indexed; canonical points to the real page.
interface Props { campaign: string; section: string; label: string; }
const { campaign, section, label } = Astro.props;
const dest = `/patio-enclosures/three-season-rooms/`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={`https://aefactorysales.com${dest}`} />
  <meta http-equiv="refresh" content={`2; url=${dest}#${section}`} />
  <title>{`${label} | AE Factory Sales`}</title>
  <meta name="description" content={`${label} is now part of our 3-season rooms page. Taking you there now.`} />
</head>
<body data-campaign={campaign} data-section={section} data-dest={dest}>
  <h1>{label}</h1>
  <p><a href={`${dest}#${section}`}>Continue to 3-season rooms</a></p>
  <script>
    const b = document.body.dataset;
    const q = new URLSearchParams(location.search);
    const src = q.get('src') || `${b.campaign}-url`;
    location.replace(`${b.dest}?src=${encodeURIComponent(src)}#${b.section}`);
  </script>
</body>
</html>
