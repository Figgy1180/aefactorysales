---
import '../styles/global.css';
import { SITE, NAV, PRODUCT_MENU, CITIES } from '../data/site';
import { getImage } from 'astro:assets';
import { HOLIDAY, LOGO, FAVICON, LOGO_H } from '../data/season';
import type { ImageMetadata } from 'astro';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import manropeUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

interface Props {
  /** Campaign code stored for visitors who arrive without ?src (e.g. typed the hanger address). */
  defaultSrc?: string;
  title: string;
  description: string;
  /** Share image: a photo import (cropped to 1200 x 630 here) or a path. Defaults to this page's photo in OG_PHOTOS. */
  image?: string | ImageMetadata;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  crumbs?: { name: string; href: string }[];
}
const { title, description, image, noindex = false, schema = [], crumbs = [] } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
// Every page gets its own share image: a real photo, cropped to 1200 x 630.
const OG_PHOTOS: Record<string, string> = {
  '/': 'projects/p34/2-front-closed', '/patio-enclosures/three-season-rooms/': 'photos/factory-pc', '/patio-enclosures/clearfixed/': 'photos/clearfixed-polycarbonate-panels',
  '/patio-enclosures/clearfold/': 'photos/showroom-polycarbonate-smoke', '/patio-enclosures/hybrid/': 'photos/showroom-room-interior',
  '/patio-screens/hexfold/': 'photos/hexfold-patio-closed', '/patio-screens/fixed-screen/': 'photos/fixed-screen-doors-closed', '/patio-enclosures/': 'projects/p36/4-inside-open', '/patio-screens/pet-resistant/': 'projects/p34/5-inside-seating', '/patio-screens/garage/': 'projects/p4/3-right-bays',
  '/pricing/': 'projects/p35/2-long-side', '/projects/': 'projects/p36/2-outside-open', '/why-ae/': 'photos/factory-cnc',
  '/how-we-build/': 'photos/factory-angle', '/showroom/': 'photos/showroom-room-interior', '/learn/': 'photos/hexfold-handle-mesh', '/compare/': 'projects/p14/3-long-side-open',
  '/faq/': 'projects/p6/2-outside-closed', '/free-quote/': 'projects/p34/5-inside-seating', '/book-visit/': 'projects/p34/5-inside-seating', '/service-area/': 'projects/p6/4-wide', '/guides/': 'photos/gabled-opening-screens', '/reviews/': 'photos/screened-patio-room-corner',
  '/guides/folding-vs-motorized-patio-screens/': 'photos/hexfold-handle',
  '/guides/polycarbonate-vs-glass-patio-enclosure-cost/': 'photos/brick-home-screened-patio',
};
const ogFiles = import.meta.glob('../assets/{photos,projects}/**/*.jpg', { eager: true }) as Record<string, { default: ImageMetadata }>;
const ogKey = OG_PHOTOS[path.endsWith('/') ? path : path + '/'];
const ogPhoto = typeof image === 'object' ? image : !image && ogKey ? ogFiles[`../assets/${ogKey}.jpg`]?.default : undefined;
const ogSrc = ogPhoto
  ? (await getImage({ src: ogPhoto, width: Math.min(1200, ogPhoto.width), height: Math.round(Math.min(1200, ogPhoto.width) * 0.525), fit: 'cover', format: 'jpg', quality: 80 })).src
  : typeof image === 'string' ? image : '/og/og-default.jpg';
const ogImage = new URL(ogSrc, SITE.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: `${SITE.url}/brand/ae-bee-logo.png`,
  image: `${SITE.url}/og/og-default.jpg`,
  telephone: SITE.phoneE164,
  email: SITE.email,
  foundingDate: SITE.founded,
  priceRange: '$$',
  // Showroom hours (by appointment only; the copy everywhere says to call first).
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '09:00', closes: '17:00' }],
  contactPoint: [{ '@type': 'ContactPoint', telephone: SITE.phoneE164, contactType: 'sales', areaServed: 'US-TX', availableLanguage: ['English'] }],
  description:
    'Patio enclosures, polycarbonate 3-season rooms and metal patio screens built in our Houston factory and installed by our own crew within a month. Showroom by appointment, 9 am to 5 pm daily.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.street,
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    postalCode: SITE.zip,
    addressCountry: 'US',
  },
  areaServed: CITIES.map((c) => ({ '@type': 'City', name: `${c}, TX` })),
  sameAs: [SITE.googleProfileUrl, 'https://www.youtube.com/@AEFactorySales', SITE.youtubeFold],
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  hasMap: SITE.googleProfileUrl,
  knowsAbout: ['Patio enclosures', 'Retractable patio screens', 'Polycarbonate 3-season rooms', 'Stainless steel screens', 'Garage screens'],
};

const breadcrumb = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, SITE.url).href,
      })),
    }
  : null;

const allSchema = [business, ...(breadcrumb ? [breadcrumb] : []), ...schema];
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '') || path === href.replace(/\/$/, '.html');
const onEstimate = Astro.url.pathname.startsWith('/free-quote');
const onBooking = Astro.url.pathname.startsWith('/book-visit');
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2A2522" />
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Houston" />
    <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
    <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-default-src={Astro.props.defaultSrc}>
    <a class="skip" href="#main">Skip to content</a>
    {HOLIDAY && (
      <aside class="season-bar" aria-label="Seasonal note">
        <p class="wrap"><span aria-hidden="true">&#10052;</span> <b>Hosting for the holidays?</b> <span class="sb-long">Polycarbonate panels block the north wind and rain, so your patio stays usable all season.</span> <a href="/patio-enclosures/three-season-rooms/#winter">See winter rooms</a></p>
      </aside>
    )}
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/">
          <img src={LOGO} alt="" width="104" height={LOGO_H} />
          <span><b>AE Factory Sales</b><small>{SITE.tagline}</small></span>
        </a>
        <nav class="nav" aria-label="Main">
          <details class="pm" data-pm>
            <summary aria-current={PRODUCT_MENU.some((g) => g.items.some((i) => isCurrent(i.href))) ? 'page' : undefined}>Products</summary>
            <div class="pm-panel">
              {PRODUCT_MENU.map((g) => (
                <div>
                  <p class="pm-g">{g.group}</p>
                  {g.items.map((i) => <a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}><b>{i.label}</b><span>{i.note}</span></a>)}
                </div>
              ))}
            </div>
          </details>
          {NAV.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="top-actions">
          <a class="top-phone" href={SITE.phoneHref}>{SITE.phone}</a>
          <a class="btn btn-line top-est" href="/free-quote/">Get my estimate now</a>
          <a class="btn" href="/book-visit/">Book free design visit</a>
          <details class="menu">
            <summary aria-label="Open menu">Menu</summary>
            <nav aria-label="Mobile">
              {PRODUCT_MENU.map((g) => (<><p class="pm-g">{g.group}</p>{g.items.map((i) => <a href={i.href}>{i.label}</a>)}</>))}
              <p class="pm-g">More</p>
              {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
              <a href="/compare/">Compare options</a>
              <a href="/faq/">FAQ</a>
              <a href={SITE.phoneHref}>Call {SITE.phone}</a>
              <a href="/free-quote/">Get my estimate now</a>
              <a class="btn" href="/book-visit/">Book free design visit</a>
            </nav>
          </details>
        </div>
      </div>
      {HOLIDAY && (
        <div class="lights" aria-hidden="true">
          {Array.from({ length: 60 }, (_, i) => <i style={`--d:${(i * 0.37) % 2.4}s`} />)}
        </div>
      )}
    </header>

    <main id="main">
      <slot />
    </main>

    <section class="foot-cta" aria-label="Free design and estimate">
      <div class="wrap">
        <b>Free design &amp; estimate</b>
        <a class="phone" href={SITE.phoneHref}>{SITE.phone}</a>
        <span class="fc-btns"><a class="btn fc-alt" href="/free-quote/">Get my estimate now</a><a class="btn" href="/book-visit/">Book free design visit</a></span>
      </div>
    </section>
    <footer class="foot blueprint">
      <div class="wrap">
        <div class="cols">
          <div>
            <img class="foot-logo" src={LOGO} alt="AE Factory Sales bee logo" width="120" height={Math.round(LOGO_H * 120 / 104)} />
            <address>
              <strong style="color:var(--ink)">{SITE.name}</strong><br />
              <a href="/showroom/">{SITE.street}</a><br />
              {SITE.city}, {SITE.region} {SITE.zip}<br />
              <a href={SITE.phoneHref}>{SITE.phone}</a><br />
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
              {SITE.hours}
            </address>
          </div>
          <div>
            <h2>Systems</h2>
            <ul>
              <li><a href="/patio-enclosures/">Patio enclosures in Houston</a></li>
              <li><a href="/patio-enclosures/three-season-rooms/">3-season rooms</a></li>
              <li><a href="/patio-screens/hexfold/">Hexfold retractable screens</a></li>
              <li><a href="/patio-screens/fixed-screen/">Stainless steel screens</a></li>
              <li><a href="/patio-screens/garage/">Garage screens</a></li>
              <li><a href="/patio-screens/pet-resistant/">Pet-resistant patio screens</a></li>
            </ul>
          </div>
          <div>
            <h2>Plan</h2>
            <ul>
              <li><a href="/pricing/">Pricing</a></li>
              <li><a href="/compare/">Compare options</a></li>
              <li><a href="/learn/">Learn: specs and care</a></li>
              <li><a href="/book-visit/">Book free design visit</a></li>
              <li><a href="/free-quote/">Get my estimate now</a></li>
              <li><a href="/guides/">Guides</a></li>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/service-area/">Service area</a></li>
            </ul>
          </div>
          <div>
            <h2>Company</h2>
            <ul>
              <li><a href="/why-ae/">Why AE</a></li>
              <li><a href="/projects/">Projects</a></li>
              <li><a href="/showroom/">Showroom: {SITE.street}</a></li>
              <li><a href="/how-we-build/">Our factory</a></li>
              <li><a href="/reviews/">Leave a review</a></li>
              <li><a href={SITE.googleProfileUrl} rel="noopener">Find us on Google</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
              <li><a href="/accessibility/">Accessibility</a></li>
            </ul>
          </div>
        </div>
        <p class="small">
          Serving Houston and the greater Houston area. Warranty: lifetime on the frame for the original owner (not transferable), 5 years on parts, installed and maintained by the manufacturer (covers normal wear and tear; excludes accidents, intentional damage and acts of God).
          Prices and details updated {SITE.updated}. © {new Date().getFullYear()} {SITE.name}.
        </p>
      </div>
    </footer>
    <nav class={`callbar${onEstimate || onBooking ? ' two' : ''}`} aria-label="Quick contact"><a href={SITE.phoneHref}>Call</a>{!onEstimate && <a href="/free-quote/">Get estimate</a>}{!onBooking && <a href="/book-visit/">Book design visit</a>}</nav>
    <script>
    import { captureSource } from '../scripts/source';
    captureSource();
  </script>
<script>
  document.querySelectorAll('[data-pm]').forEach((d) => {
    document.addEventListener('click', (e) => { if (!d.contains(e.target)) d.removeAttribute('open'); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && d.open) { d.removeAttribute('open'); d.querySelector('summary').focus(); } });
  });
</script>
<script is:inline>(function(){var t=document.querySelector('.top');if(!t)return;var on=function(){t.classList.toggle('scrolled',window.scrollY>40)};on();window.addEventListener('scroll',on,{passive:true});})();</script>
</body>
</html>
