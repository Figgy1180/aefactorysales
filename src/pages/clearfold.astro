---
import ProductPage from '../components/ProductPage.astro';
import { FAQ } from '../data/site';
import img from '../assets/photos/showroom-polycarbonate-smoke.jpg';
---
<ProductPage
  id="clearfold"
  title="Clearfold Folding Patio Enclosure Houston | AE"
  description="Clearfold polycarbonate panels fold open on our track: a 3-season room when closed, an open patio when folded away. Built in Houston. From $40 per sq ft."
  h1={['Clearfold', 'panel walls that fold away']}
  img={img} alt="Folding tinted polycarbonate panels in the AE showroom" caption="Folding polycarbonate panels in our Houston showroom."
  points={[
    ['A room when you want one', 'Close the panels and the patio is sheltered from wind and rain.'],
    ['An open patio when you don\'t', 'Panels fold open on our track by hand: up to 5 ft per pull, or 10 ft meeting in the middle.'],
    ['Hardware included', 'A high-end handle and a ramp water stop come with every Clearfold.'],
  ]}
  faq={[FAQ.room[2], FAQ.room[1], FAQ.room[3], FAQ.room[4], FAQ.general[0], FAQ.general[1]]}
/>
