---
// Main page for the phrase "patio enclosures Houston": what it is, the systems, prices for the three
// patio sizes, real projects, FAQ and the quote form. Every number comes from src/data/site.ts.
import Base from '../../layouts/Base.astro';
import VizCta from '../../components/VizCta.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectMosaic from '../../components/ProjectMosaic.astro';
import Faq from '../../components/Faq.astro';
import QuickBook from '../../components/QuickBook.astro';
import { SIZES, FAQ, SITE, CITIES, range, byId, type QA } from '../../data/site';

const crumbs = [{ name: 'Patio enclosures', href: '/patio-enclosures/' }];
const order = ['fixed', 'hexfold', 'clearfixed', 'clearfold', 'hybrid'].map(byId);
const lo = Math.min(...order.map((p) => p.msrp)), hi = Math.max(...order.map((p) => p.msrp));
const faq: QA[] = [
  { q: 'What is a patio enclosure?', a: `A patio enclosure closes in the open sides of a covered patio with screens, panels or both. AE Factory Sales builds 5 systems for existing roofed patios, from $${lo} to $${hi} per sq ft of opening, installed. Panels can be up to 11.5 ft tall.` },
  FAQ.cost[0], FAQ.cost[2], FAQ.room[0], FAQ.general[1],
];
const service = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Patio enclosures in Houston', serviceType: 'Patio enclosure design, fabrication and installation',
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: CITIES.map((c) => ({ '@type': 'City', name: `${c}, TX` })),
  url: `${SITE.url}/patio-enclosures/`,
  offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', lowPrice: lo, highPrice: hi, description: 'Installed price per square foot of opening' },
};
---
<Base
  title="Patio Enclosures in Houston: Systems and Prices | AE"
  description={`Patio enclosures in Houston: 5 systems from $${lo} to $${hi} per sq ft of opening installed, prices for 3 patio sizes, real projects and a free quote.`}
  crumbs={crumbs}
  schema={[service]}
>
  <PageHero crumbs={crumbs}>
    <div class="stack-lg" style="max-width:54em">
      <h1 class="display">Patio enclosures <span class="y">in Houston</span></h1>
      <p class="sub">Close in the open sides of your covered patio with metal screens, tinted panels or both. Made in our Houston factory, installed by our crew within a month.</p>
      <p class="pp-price">{order.length} systems, ${lo} to ${hi} per sq ft of opening, installed</p>
      <div class="actions"><a class="btn" href="/patio-visualizer/">See it on my patio</a><a class="btn btn-line" href="#book">Book free design visit</a></div>
    </div>
  </PageHero>

  <VizCta band="band on-paper" book={false} />

  <section class="band" aria-labelledby="what-title">
    <div class="wrap stack-lg">
      <h2 id="what-title" class="h2">Screens, panels <span class="y">or both</span></h2>
      <div class="pe-3">
        <div><h3>Screens</h3><p>Breeze in, bugs out. Stainless or aluminum mesh.</p><a href="/patio-screens/hexfold/">Hexfold</a> · <a href="/patio-screens/fixed-screen/">Fixed Screen</a></div>
        <div><h3>Panels</h3><p>Tinted polycarbonate for wind and rain: a 3-season room.</p><a href="/patio-enclosures/clearfixed/">Clearfixed</a> · <a href="/patio-enclosures/clearfold/">Clearfold</a></div>
        <div><h3>Both</h3><p>Panels and mesh on one opening, or mixed around the patio.</p><a href="/patio-enclosures/hybrid/">Hybrid</a></div>
      </div>
    </div>
  </section>


  <section class="band on-paper" id="prices" aria-labelledby="price-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="price-title" class="h2">Prices for three <span class="y">patio sizes</span></h2>
        <p class="lede">Installed totals. Your exact quote comes after we measure.</p>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Prices for three patio sizes (table 2)">
        <table class="tbl tnum">
          <thead><tr><th scope="col">System</th>{SIZES.map((s) => <th scope="col" class="num">{s.name}<br />{s.low} to {s.high} sq ft of opening</th>)}</tr></thead>
          <tbody>
            {order.map((p) => (<tr><th scope="row"><a href={p.href} style="color:inherit">{p.name}</a></th>{SIZES.map((s) => <td class="num">{range(p.msrp, s.low, s.high)}</td>)}</tr>))}
          </tbody>
        </table>
      </div>
      <p class="fine">Before tax. Arches, locks and extra posts add to the total. <a href="/pricing/">Full pricing</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="proj-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="proj-title" class="h2">Real projects <span class="y">around Houston</span></h2>

      </div>
      <ProjectMosaic />
      <p><a href="/projects/">All projects</a> · <a href="/service-area/">Service area</a></p>
    </div>
  </section>

  <section class="band raised" aria-labelledby="pefaq-title">
    <div class="wrap stack-lg" style="max-width:900px">
      <h2 id="pefaq-title" class="h2">Patio enclosure <span class="y">questions</span></h2>
      <Faq items={faq} />
    </div>
  </section>

  <span id="quote" aria-hidden="true"></span>
  <section class="band hive-dark" id="book">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Free <span class="y">design visit</span></h2>
        <p class="lede">We measure, bring samples and quote on site. Email follows within 24 hours.</p>
      </div>
      <div class="book-card"><QuickBook id="pe-visit" source="Patio enclosures Houston page" /></div>
    </div>
  </section>
</Base>

<style>
  .pe-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .pe-3 > div { border-top: 3px solid var(--yellow); padding-top: 14px; min-width: 0; }
  .pe-3 h3 { font-weight: 800; font-stretch: 78%; font-size: 1.4rem; text-transform: uppercase; }
  .pe-3 p { color: var(--paper-2); margin: 6px 0 10px; }
  .pe-sizes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; }
  .pe-sizes dt { font-weight: 800; text-transform: uppercase; font-stretch: 80%; }
  .pe-sizes dd { margin: 0; color: var(--paper-2); }
  @media (max-width: 760px) { .pe-3 { grid-template-columns: minmax(0, 1fr); } }
  .pe-3 p { color: var(--ink-2); }
  .pe-3 a { color: var(--yellow); font-weight: 600; }
  .pp-price { font-family: var(--mono); font-weight: 600; color: var(--ink-2); margin: 0; }
  .book-card { background: var(--honey-2); color: var(--ink); padding: 26px; border-radius: 12px; border: 1px solid rgba(251, 245, 236, .08); border-top: 3px solid var(--yellow); box-shadow: var(--shadow); }
  .book-card :global(.fine) { color: var(--ink-2); }
</style>
