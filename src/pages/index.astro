  .room-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 56px); align-items: center; margin-bottom: clamp(36px, 5vw, 56px); }
  .note { border-left: 4px solid var(--yellow); padding: 10px 14px; background: rgba(242, 194, 48, .1); color: var(--paper-ink); border-radius: 0 8px 8px 0; }
