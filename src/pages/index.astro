---
// Homepage, simplified Nov 23 2026 (preview). One idea per section, every fact said once.
// Order: hero with the patio visualizer, trust strip, five systems, real projects, price picker, design visit, FAQ.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ProjectMosaic from '../components/ProjectMosaic.astro';
import QuickBook from '../components/QuickBook.astro';
import RevealSlider from '../components/RevealSlider.astro';
import { REVIEWS } from '../data/reviews';
import { PRODUCTS, SIZES, SITE, byId, range, type QA } from '../data/site';
import vizShot from '../assets/renders/visualizer-sample.jpg';
import vizBefore from '../assets/renders/visualizer-sample-before.jpg';
import clearfixedPhoto from '../assets/photos/clearfixed-polycarbonate-panels.jpg';
import roomShowroom from '../assets/photos/showroom-polycarbonate-smoke.jpg';
import pcDoors from '../assets/projects/p37/3-inside-doors-closed.jpg';
import hexClosed from '../assets/photos/hexfold-patio-closed.jpg';
import fixedDoors from '../assets/photos/fixed-screen-doors-closed.jpg';

const review = REVIEWS[0];
const short = (t: string) => (t.split('. ').length > 2 ? t.split('. ').slice(0, 2).join('. ') + '. …' : t);

const systems = [
  { id: 'clearfixed', tag: '3-season room', line: 'Fixed tinted panels for wind, rain and cool days.', img: clearfixedPhoto, alt: 'Clearfixed tinted polycarbonate panels', cap: 'Clearfixed panels' },
  { id: 'clearfold', tag: '3-season room', line: 'Tinted panels that fold away on nice days.', img: roomShowroom, alt: 'Folding Smokey Gray polycarbonate panels in the AE showroom', cap: 'In our showroom' },
  { id: 'hybrid', tag: 'Both', line: 'Panels and mesh on one opening. Pick either, any day.', img: pcDoors, alt: 'Blue-tinted polycarbonate Hybrid doors on a Sugar Land patio, installed by AE', cap: 'Installed in Sugar Land' },
  { id: 'hexfold', tag: 'Screens', line: 'Aluminum mesh that folds away. Up to 20 ft, no posts.', img: hexClosed, alt: 'Brick Houston patio closed in with Hexfold folding screens', cap: 'Installed in Houston' },
  { id: 'fixed', tag: 'Screens', line: '304 stainless mesh comes standard. Our lowest price.', img: fixedDoors, alt: 'Fixed Screen panels with screen doors on a Houston patio', cap: 'Installed in Houston' },
];
const order = ['clearfixed', 'clearfold', 'hybrid', 'hexfold', 'fixed'];
const defSys = byId('clearfixed');
const pickerData = JSON.stringify({ products: PRODUCTS.map(({ id, name, msrp }) => ({ id, name, msrp })), sizes: SIZES });

const faq: QA[] = [
  { q: 'Is the design visit really free?', a: 'Yes. We measure every opening, design the layout with you and go over your quote on site, then email it within 24 hours. No cost, no obligation.' },
  { q: 'What will it cost?', a: 'From $24 to $56 per sq ft of opening, installed, before sales tax, depending on the system. Locks, ramps and doggy doors ($200) are extra. Financing is available through HFS Financial and Acorn Finance, subject to approval; AE is not a lender.' },
  { q: 'Is a 3-season room air-conditioned?', a: 'No. It shelters you from wind, rain and glare but is not insulated. You can add a portable or mini-split unit, and closed panels help hold the cool air in.' },
  { q: 'Can you help with my HOA?', a: 'Yes. We provide drawings and product specs for your application. Approval is up to your HOA.' },
];
---
<Base
  title="Patio Enclosures in Houston | AE Factory Sales"
  description="See screens or a 3-season room on a photo of your own patio, then book a free design visit. Made in our Houston factory, installed by our own crew."
>
  <!-- Hero: the visualizer is the showcase -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Made and installed in Houston</p>
        <h1 id="hero-title" class="display">Screens and 3‑season rooms <span class="y">for your covered patio</span></h1>
        <p class="sub">See them on a photo of your own patio first. It takes about a minute.</p>
        <div class="hero-cta">
          <a class="btn btn-big" href="/patio-visualizer/">See it on my patio</a>
          <a class="btn btn-big btn-line" href="#book">Book free design visit</a>
        </div>
        <p class="hero-price">From $24 per sq ft of opening, installed</p>
      </div>
      <figure class="hero-viz">
        <RevealSlider id="viz-reveal" eager closed={vizShot} open={vizBefore} alt="Brick patio in Richmond, TX" words={{ closed: 'With AE', open: 'Your photo', closedAlt: 'Visualizer preview: Hexfold screens drawn onto a photo of a brick patio', openAlt: 'The same brick patio photo before the preview', range: 'Drag to compare the patio photo with and without the visualizer preview', mid: 'Comparing before and after' }} />
        <figcaption>Visualizer preview. Drag to compare.</figcaption>
      </figure>
    </div>
    <div class="wrap">
      <ol class="how" aria-label="How the patio visualizer works">
        <li><b>Snap your patio</b><span>Any phone photo works.</span></li>
        <li><b>Try a system</b><span>Panels, screens or both, in your colors.</span></li>
        <li><b>Send us your pick</b><span>We measure and confirm it, free.</span></li>
      </ol>
    </div>
  </section>

  <!-- Trust strip: the facts we used to repeat everywhere, said once -->
  <section class="trust" aria-label="Why AE">
    <ul class="wrap trust-list">
      <li><b>Houston factory</b><span>We make every system here</span></li>
      <li><b>Our own crew</b><span>Installed within a month</span></li>
      <li><b>Opens by hand</b><span>Works in a power outage</span></li>
      <li><b>Lifetime frame</b><span>Plus 5 years on parts</span></li>
    </ul>
  </section>

  <!-- Five systems -->
  <section class="band" id="systems" aria-labelledby="sys-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="sys-title" class="h2">Five systems, <span class="y">mixed to fit</span></h2>
        <p class="lede">Choose per opening. Every frame is heat-welded, in Night Gray or Bright White.</p>
      </div>
      <ul class="sys-grid">
        {systems.map((s) => { const p = byId(s.id); return (
          <li class="sys-card">
            <figure><Image src={s.img} alt={s.alt} widths={[400, 700]} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 240px" loading="lazy" /><figcaption>{s.cap}</figcaption></figure>
            <div class="sys-body">
              <p class="sys-tag">{s.tag}</p>
              <h3><a href={p.href}>{p.name}</a></h3>
              <p class="sys-price">From ${p.msrp}<small>/sq ft</small></p>
              <p>{s.line}</p>
              <a class="sys-try" href={`/patio-visualizer/?sys=${s.id}`}>Try on my patio →</a>
            </div>
          </li>
        ); })}
      </ul>
    </div>
  </section>

  <!-- Real projects -->
  <section class="band raised" aria-labelledby="proj-title">
    <div class="wrap">
      <div class="row-head">
        <h2 id="proj-title" class="h2">Real Houston patios</h2>
        <a class="btn btn-line" href="/projects/">All projects</a>
      </div>
      <ProjectMosaic />
      {review && (
        <figure class="quote">
          <blockquote>“{short(review.text)}”</blockquote>
          <figcaption>{review.name}, {review.city} · <a href="/reviews/">More reviews</a></figcaption>
        </figure>
      )}
    </div>
  </section>

  <!-- Price picker -->
  <section class="band on-paper" id="prices" aria-labelledby="price-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="price-title" class="h2">What will it cost?</h2>
        <p class="lede">We price the open wall area we fill, not your floor.</p>
      </div>
      <div class="picker" id="picker" data-json={pickerData}>
        <div class="picker-opts">
          <fieldset>
            <legend>Your patio</legend>
            {SIZES.map((s, i) => (
              <label class="opt"><input type="radio" name="size" value={s.id} checked={i === 1} /><span><b>{s.name}</b><em>{s.low} to {s.high} sq ft of openings</em></span></label>
            ))}
          </fieldset>
          <fieldset>
            <legend>System</legend>
            {order.map((id) => { const p = byId(id); return (
              <label class="opt"><input type="radio" name="sys" value={p.id} checked={p.id === defSys.id} /><span><b>{p.name}</b> <small>${p.msrp}/sq ft</small></span></label>
            ); })}
          </fieldset>
          <details class="own-d">
            <summary>Or enter your own openings</summary>
            <fieldset class="own">
              <legend class="sr-only">Your own openings</legend>
              <p class="own-hint">Add the widths of every open side, then the height. Two sides of 16 and 14 ft at 8 ft tall is 30 × 8.</p>
              <div class="own-row">
                <label>Total width (ft)<input type="number" id="own-w" inputmode="decimal" min="1" max="200" step="0.5" /></label>
                <label>Height (ft)<input type="number" id="own-h" inputmode="decimal" min="1" max="12" step="0.5" /></label>
              </div>
            </fieldset>
          </details>
        </div>
        <div class="estimate" aria-live="polite">
          <p class="est-label" id="est-label">{defSys.name}, medium patio</p>
          <p class="est-range tnum" id="est-range">{range(defSys.msrp, 200, 300)}</p>
          <p id="est-note" class="muted">200 to 300 sq ft of openings at ${defSys.msrp} per sq ft, installed.</p>
          <p class="fine">Before sales tax. Locks, ramps and doggy doors ($200) are extra. Financing through HFS Financial and Acorn Finance, subject to approval; AE is not a lender.</p>
          <div class="actions"><a class="btn" href="/patio-visualizer/">See it on my patio</a><a class="btn btn-line" href="#book">Book free design visit</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Free design visit -->
  <section class="band hive-dark" id="book" aria-labelledby="book-title">
    <div class="wrap book-grid">
      <div class="stack-lg">
        <h2 id="book-title" class="h2">Free <span class="y">design visit</span></h2>
        <ol class="visit-steps">
          <li><b>Leave your name and number</b><span>We call within 1 business day.</span></li>
          <li><b>We measure and bring samples</b><span>Frames, mesh and tints, at your home.</span></li>
          <li><b>You get your quote</b><span>On site, then by email within 24 hours.</span></li>
        </ol>
        <p class="showroom">Rather see it in person? Our showroom is at {SITE.street}, Houston, open 9 to 5 daily by appointment. <a href="/showroom/">Directions</a></p>
      </div>
      <div class="book-card"><QuickBook id="home-book" /></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div class="stack">
        <h2 id="faq-title" class="h2">Questions</h2>
        <p class="muted">We serve Houston and the greater Houston area. <a href="/service-area/">Service area</a> · <a href="/faq/">All questions</a></p>
      </div>
      <Faq items={faq} />
    </div>
  </section>
</Base>

<style>
  .kicker { margin: 0; display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-weight: 600; font-size: .82rem; text-transform: uppercase; color: var(--yellow); }
  .hexdot { width: 11px; height: 13px; flex: none; background: var(--yellow); clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
  .btn-big { font-size: 1.06rem; min-height: 54px; padding: 0 26px; }

  /* hero */
  .hero { background: var(--honey); padding-block: clamp(28px, 5vw, 64px) clamp(24px, 4vw, 44px); border-bottom: 1px solid rgba(242, 194, 48, .3); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .hero-copy { display: grid; gap: 18px; }
  .hero-copy .display { font-size: clamp(2.1rem, 4.6vw, 3.9rem); line-height: 1.03; max-width: 15ch; }
  .hero-copy .sub { max-width: 34ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-cta .btn-line { color: var(--ink); border-color: var(--line); }
  .hero-price { margin: 0; font-family: var(--mono); font-size: .9rem; color: var(--ink-2); }
  .hero-viz { margin: 0; border: 1.5px solid var(--yellow); border-radius: 14px; padding: 8px; background: var(--honey-2); box-shadow: var(--shadow); }
  .hero-viz :global(img) { width: 100%; height: auto; display: block; border-radius: 8px; }
  .hero-viz figcaption { margin-top: 8px; font-family: var(--mono); font-size: .8rem; color: var(--ink-2); text-align: center; }
  .how { list-style: none; margin: clamp(24px, 3vw, 36px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; counter-reset: h; }
  .how li { counter-increment: h; display: grid; grid-template-columns: 34px minmax(0, 1fr); column-gap: 12px; align-items: center; }
  .how li::before { content: counter(h); grid-row: span 2; width: 32px; height: 36px; display: grid; place-items: center; font-family: var(--font-head); font-weight: 800; color: #1a1a1a; background: var(--yellow); clip-path: polygon(25% 3%, 75% 3%, 100% 50%, 75% 97%, 25% 97%, 0 50%); }
  .how b { font-family: var(--font-head); font-size: 1.02rem; }
  .how span { color: var(--ink-2); font-size: .92rem; }

  /* trust strip */
  .trust { background: var(--honey-2); border-bottom: 1px solid rgba(251, 245, 236, .08); }
  .trust-list { list-style: none; margin: 0 auto; padding-block: 18px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px 24px; }
  .trust-list li { display: grid; gap: 2px; padding-left: 12px; border-left: 3px solid var(--yellow); }
  .trust-list b { font-family: var(--font-head); font-size: 1.05rem; color: var(--ink); }
  .trust-list span { font-size: .88rem; color: var(--ink-2); }

  /* systems */
  .sys-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  .sys-card { background: var(--honey-2); border: 1px solid rgba(251, 245, 236, .08); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; min-width: 0; box-shadow: var(--shadow); }
  .sys-card figure { margin: 0; position: relative; }
  .sys-card :global(img) { width: 100%; aspect-ratio: 4 / 3.2; object-fit: cover; display: block; }
  .sys-card figcaption { position: absolute; left: 0; bottom: 0; padding: 4px 8px; font-family: var(--mono); font-size: .72rem; color: #fff; background: rgba(0, 0, 0, .55); border-top-right-radius: 6px; }
  .sys-body { padding: 14px 16px 16px; display: grid; gap: 6px; align-content: start; flex: 1; }
  .sys-tag { font-family: var(--mono); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--yellow); }
  .sys-body h3 { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; }
  .sys-body h3 a { color: var(--ink); text-decoration: none; display: inline-flex; min-height: 32px; align-items: center; }
  .sys-body h3 a:hover { color: var(--yellow); }
  .sys-price { font-family: var(--mono); font-weight: 700; color: var(--ink); }
  .sys-price small { font-weight: 500; color: var(--ink-2); }
  .sys-body > p:not(.sys-tag):not(.sys-price) { color: var(--ink-2); font-size: .94rem; }
  .sys-try { margin-top: auto; padding-top: 6px; color: var(--yellow); font-weight: 700; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .sys-try:hover { text-decoration: underline; }

  /* projects */
  .row-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: clamp(20px, 3vw, 32px); }
  .quote { margin: 28px 0 0; padding: 16px 20px; border-left: 3px solid var(--yellow); background: rgba(251, 245, 236, .05); border-radius: 0 10px 10px 0; max-width: 62em; }
  .quote blockquote { margin: 0; font-size: 1.05rem; color: var(--ink); }
  .quote figcaption { margin-top: 6px; font-size: .9rem; color: var(--ink-2); }
  .quote a { color: var(--yellow); }

  /* price picker */
  .picker { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(24px, 4vw, 44px); align-items: start; }
  .picker-opts { display: grid; gap: 22px; }
  .picker fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .picker legend { font-weight: 700; font-size: 1.15rem; margin-bottom: 8px; }
  .picker-opts > fieldset:first-of-type { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .picker-opts > fieldset:first-of-type legend { grid-column: 1 / -1; }
  .picker-opts > fieldset:nth-of-type(2) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .picker-opts > fieldset:nth-of-type(2) legend { grid-column: 1 / -1; }
  .opt { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border: 1.5px solid var(--paper-line); border-radius: 8px; background: #fff; cursor: pointer; }
  .opt:hover { border-color: var(--paper-2); }
  .opt:has(input:checked) { border-color: var(--paper-ink); box-shadow: inset 4px 0 0 var(--yellow); }
  .opt input { color-scheme: light; margin-top: 4px; accent-color: var(--paper-ink); width: 18px; height: 18px; flex-shrink: 0; }
  .opt b { font-weight: 700; font-size: 1.02rem; }
  .opt small { display: block; font-size: .9rem; color: var(--paper-2); }
  .opt em { display: block; font-style: normal; font-family: var(--mono); font-size: .78rem; font-weight: 600; margin-top: 2px; color: var(--paper-2); }
  .own-d { border-top: 1px solid var(--paper-line); padding-top: 12px; }
  .own-d summary { cursor: pointer; font-weight: 700; font-size: 1.02rem; color: var(--paper-ink); min-height: 44px; display: flex; align-items: center; gap: 8px; list-style: none; }
  .own-d summary::-webkit-details-marker { display: none; }
  .own-d summary::before { content: "+"; display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--yellow); color: #1f1b18; font-weight: 800; }
  .own-d[open] summary::before { content: "\2212"; }
  .own { border: 0; padding: 0; margin: 8px 0 0; display: grid; gap: 8px; }
  .own-hint { color: var(--paper-2); font-size: .94rem; }
  .own-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .own-row label { display: grid; gap: 6px; font-weight: 600; color: var(--paper-ink); }
  .own-row input { min-height: 48px; padding: 8px 12px; border: 1.5px solid var(--paper-line); border-radius: 8px; font: inherit; background: #fff; color: var(--paper-ink); color-scheme: light; }
  .estimate { position: sticky; top: 96px; background: var(--honey); color: var(--ink); padding: 26px 28px; border-radius: 12px; box-shadow: var(--shadow); display: grid; gap: 12px; }
  .est-label { font-family: var(--mono); font-size: .82rem; font-weight: 600; color: var(--yellow); }
  .est-range { font-family: var(--font-head); font-weight: 800; letter-spacing: -0.03em; font-size: clamp(2.2rem, 4.6vw, 3.1rem); line-height: 1; }
  .estimate .btn { justify-self: start; }
  .estimate .btn-line { color: var(--ink); border-color: var(--line); }
  .on-paper .estimate .muted, .on-paper .estimate .fine { color: var(--ink-2); }

  /* booking */
  .book-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 56px); align-items: start; }
  .visit-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; counter-reset: v; }
  .visit-steps li { counter-increment: v; display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 14px; }
  .visit-steps li::before { content: counter(v); grid-row: span 2; width: 36px; height: 40px; display: grid; place-items: center; font-family: var(--font-head); font-weight: 800; color: #1a1a1a; background: var(--yellow); clip-path: polygon(25% 3%, 75% 3%, 100% 50%, 75% 97%, 25% 97%, 0 50%); }
  .visit-steps b { font-family: var(--font-head); font-size: 1.08rem; }
  .visit-steps span { color: var(--ink-2); }
  .showroom { color: var(--ink-2); max-width: 46ch; }
  .showroom a { color: var(--yellow); }
  .book-card { background: var(--honey-2); color: var(--ink); padding: 26px; border-radius: 12px; border: 1px solid rgba(251, 245, 236, .08); border-top: 3px solid var(--yellow); box-shadow: var(--shadow); }
  .book-card :global(.fine) { color: var(--ink-2); }

  /* faq */
  .faq-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .faq-grid .muted a { color: var(--yellow); }

  @media (max-width: 1100px) { .sys-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .hero-grid, .picker, .book-grid, .faq-grid { grid-template-columns: minmax(0, 1fr); }
    .estimate { position: static; }
    .trust-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 22px; }
    .hero-copy { gap: 14px; }
    .hero-copy .display { font-size: clamp(1.9rem, 9vw, 2.5rem); }
    .hero-cta .btn { width: 100%; }
    .how { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .sys-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .sys-body { padding: 10px 12px 12px; gap: 4px; }
    .sys-body h3 { font-size: 1.05rem; }
    .sys-body > p:not(.sys-tag):not(.sys-price) { font-size: .85rem; }
    .sys-card figcaption { font-size: .62rem; }
    .actions .btn { width: 100%; }
    .opt { padding: 10px; }
    .picker-opts > fieldset:first-of-type .opt { flex-direction: column; gap: 4px; }
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('picker');
    if (!el) return;
    var d = JSON.parse(el.getAttribute('data-json'));
    var fmt = function (n) { return '$' + (Math.round(n / 100) * 100).toLocaleString('en-US'); };
    function update() {
      var sid = el.querySelector('input[name="size"]:checked').value;
      var pid = el.querySelector('input[name="sys"]:checked').value;
      var s = d.sizes.find(function (x) { return x.id === sid; });
      var p = d.products.find(function (x) { return x.id === pid; });
      var w = parseFloat(document.getElementById('own-w').value), h = parseFloat(document.getElementById('own-h').value);
      if (w > 0 && h > 0) {
        var area = Math.round(w * h);
        document.getElementById('est-label').textContent = p.name + ', your ' + area + ' sq ft of openings';
        document.getElementById('est-range').textContent = 'From ' + fmt(p.msrp * area);
        document.getElementById('est-note').textContent = w + ' × ' + h + ' ft = ' + area + ' sq ft at $' + p.msrp + ' per sq ft, installed.';
        return;
      }
      document.getElementById('est-label').textContent = p.name + ', ' + s.name.toLowerCase() + ' patio';
      document.getElementById('est-range').textContent = fmt(p.msrp * s.low) + ' to ' + fmt(p.msrp * s.high);
      document.getElementById('est-note').textContent = s.low + ' to ' + s.high + ' sq ft of openings at $' + p.msrp + ' per sq ft, installed.';
    }
    el.addEventListener('change', update);
    el.addEventListener('input', update);
  })();
</script>
