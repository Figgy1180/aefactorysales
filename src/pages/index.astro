---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CompareBars from '../components/CompareBars.astro';
import Why from '../components/Why.astro';
import Faq from '../components/Faq.astro';
import ProjectMosaic from '../components/ProjectMosaic.astro';
// Aligned pair: the closed photo is warped to match the open photo, so the posts and beam line up under the slider.
import heroBg from '../assets/projects/p35/1-wide.jpg';
import rFixed from '../assets/renders/fixed.png';
import rHexfold from '../assets/renders/hexfold.png';
import rClearfixed from '../assets/renders/clearfixed.png';
import rClearfold from '../assets/renders/clearfold.png';
import rHybrid from '../assets/renders/hybrid.png';
import vizShot from '../assets/renders/visualizer-sample.jpg';
import { PRODUCTS, SIZES, FAQ, FACTS, CITIES, SITE, byId, range, FINANCING, WARRANTY, CITY_PAGES, type QA } from '../data/site';
import BookVisitForm from '../components/BookVisitForm.astro';
import ReviewCards from '../components/ReviewCards.astro';
import { REVIEWS } from '../data/reviews';
import meshImg from '../assets/photos/fixed-screen-frame-colors.jpg';
import handleImg from '../assets/photos/hexfold-handle.jpg';
import cncImg from '../assets/photos/factory-cnc.jpg';
import { HOLIDAY } from '../data/season';

import open from '../assets/photos/hexfold-patio-open.jpg';
import clearfixed from '../assets/photos/clearfixed-polycarbonate-panels.jpg';
import showroom from '../assets/photos/showroom-room-interior.jpg';
import handle from '../assets/photos/hexfold-patio-closed.jpg';
import fixedColors from '../assets/photos/fixed-screen-frame-colors.jpg';
import showroomSmoke from '../assets/photos/showroom-polycarbonate-smoke.jpg';
import cnc from '../assets/photos/factory-cnc.jpg';
import angle from '../assets/photos/factory-angle.jpg';
import pcRack from '../assets/photos/factory-pc-smoke.jpg';
import installed from '../assets/projects/p14/2-long-side-closed.jpg';

// Proof placeholders render ONLY in preview builds, so an empty review slot can never ship live.
const SHOW_PH = !!import.meta.env.PUBLIC_PREVIEW;
const cardImg: Record<string, { img: any; alt: string; note?: string }> = {
  clearfixed: { img: clearfixed, alt: 'Clearfixed tinted polycarbonate panels on an AE patio enclosure' },
  clearfold: { img: showroomSmoke, alt: 'Folding polycarbonate panels in the AE showroom' },
  hexfold: { img: handle, alt: 'Brick Houston patio closed in with Hexfold folding screens' },
  fixed: { img: fixedColors, alt: 'Two Fixed Screen panels with 304 stainless steel mesh in Night Gray and Bright White frames' },
  hybrid: { img: showroom, alt: 'AE showroom room combining polycarbonate panels and metal mesh' },
};
const order = ['clearfixed', 'clearfold', 'hybrid', 'hexfold', 'fixed'];
const five = [
  { id: 'fixed', img: rFixed, tag: 'Screen · fixed', alt: 'Render of Fixed Screen panels with stainless steel mesh in a Night Gray frame' },
  { id: 'hexfold', img: rHexfold, tag: 'Screen · folding', alt: 'Render of Hexfold folding screens with evenly spaced leaves' },
  { id: 'clearfixed', img: rClearfixed, tag: 'Panel · fixed', alt: 'Render of Clearfixed tinted polycarbonate panels' },
  { id: 'clearfold', img: rClearfold, tag: 'Panel · folding', alt: 'Render of Clearfold folding tinted polycarbonate panels' },
  { id: 'hybrid', img: rHybrid, tag: 'Screen + panel', alt: 'Render of the Hybrid system with mesh and tinted panel leaves' },
].map((f) => ({ ...f, p: byId(f.id) }));
// Visit-first FAQ: the questions people ask right before booking.
const visitFaq: QA[] = [
  { q: 'Is the site visit really free?', a: 'Yes. We come to your home, measure every opening and email you a written quote within a day, at no cost.' },
  { q: 'Do I have to decide at the visit?', a: 'No. Your written quote is emailed within a day of the visit, with every item listed, and you decide on your own time.' },
  { q: 'What will it cost?', a: `Installed prices run $24 to $56 per sq ft of opening, depending on the system. The price picker on this page shows ranges for your patio size. ${FINANCING}` },
  { q: 'How soon can you install?', a: 'Within a month of your order, by our own crew.' },
  FAQ.general[1],
];
const pickerData = JSON.stringify({ products: PRODUCTS.map(({ id, name, msrp }) => ({ id, name, msrp })), sizes: SIZES });
const hex = byId('hexfold');
// Holiday season: the homepage leads with 3-season rooms, and the price picker starts on Clearfixed.
const defSys = HOLIDAY ? byId('clearfixed') : hex;
const cf = byId('clearfixed');
const ytId = (SITE.youtubeFold.match(/(?:shorts\/|v=|youtu\.be\/)([\w-]{11})/) || [])[1];
const videoLd = {
  '@context': 'https://schema.org', '@type': 'VideoObject',
  name: 'Hexfold folding patio screens opening by hand',
  description: 'AE Hexfold aluminum mesh screens folding open by hand on a gabled Houston patio. No motor, no remote.',
  thumbnailUrl: `${SITE.url}/video/gable-open-poster.jpg`,
  uploadDate: '2026-11-05', duration: 'PT15S',
  contentUrl: `${SITE.url}/video/gable-open.mp4`,
  ...(ytId ? { embedUrl: `https://www.youtube.com/embed/${ytId}`, url: SITE.youtubeFold } : {}),
};
---
<Base
  title='Premium Patio Enclosures in Houston | AE Factory Sales'
  description='Patio enclosures in Houston: polycarbonate 3-season rooms and metal patio screens, built in our own factory and installed by our crew within a month.'
  schema={[videoLd]}
>
  <section class:list={['hero', HOLIDAY && 'winter-hero']} aria-labelledby="hero-title">
    <Image class="hero-bg" src={heroBg} widths={[640, 960, 1280]} sizes="100vw" alt="20 ft patio enclosure on a Houston home, seen from the yard" loading="eager" fetchpriority="high" />
    {HOLIDAY && <div class="snow" aria-hidden="true"></div>}
    <div class="wrap hero-in">
      <div class="dimline" aria-hidden="true"><i></i><span>About 20 ft, one opening · Houston</span><i></i></div>
      <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Custom made for your covered patio</p>
      <h1 id="hero-title" class="display">Premium patio enclosures <span class="y">built in Houston</span></h1>
      <p class="sub">Keep the mosquitoes out and the breeze in, or shut out wind and rain. Folding systems open by hand, even in a power outage.</p>
      <div class="actions">
        <a class="btn btn-big" href="#book-form" data-cb-open>Book my free site visit</a>
        <a class="btn btn-line" href="/patio-visualizer/">See it on my patio</a>
      </div>
      <ul class="badges">
        <li><span class="hexbadge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 12h8M8 12l3-3M8 12l3 3M4 4v16M20 4v16"/></svg></span><div><b>Opens by hand</b><span>No motor, works in a power outage</span></div></li>
        <li><span class="hexbadge" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15"/><path d="M4 10h16M9 3v4M15 3v4"/></svg></span><div><b>Installed within a month</b><span>Of your order, by our own crew</span></div></li>
        <li><span class="hexbadge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg></span><div><b>Lifetime frame warranty</b><span>3 years on parts, from the maker</span></div></li>
      </ul>
      <p class="micro">From $24 per sq ft of opening, installed. Free site visit, written quote emailed within a day. Or call <a href={SITE.phoneHref}>{SITE.phone}</a>.</p>
    </div>
  </section>

  <section class="band hive" aria-labelledby="five-title">
    <div class="wrap">
      <div class="sec-head row-head">
        <div>
          <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Five systems, one factory</p>
          <h2 id="five-title" class="h2">Screen it, enclose it <span class="y">or both</span></h2>
        </div>
        <p class="lede" style="max-width:40ch">Every system shares the same metal-reinforced, heat-welded frame, in Night Gray or Bright White. Prices per sq ft of opening, installed.</p>
      </div>
      <ul class="five">
        {five.map((f) => (
          <li><a href={f.p.href}>
            <Image src={f.img} widths={[320, 480, 640]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 230px" alt={f.alt} loading="lazy" />
            <span class="five-body"><small>{f.tag}</small><b>{f.p.name}</b><em>from ${f.p.msrp}</em></span>
          </a></li>
        ))}
      </ul>
      <p class="fine">Product renders made from our system designs. See finished jobs on the <a href="/projects/">projects page</a>.</p>
    </div>
  </section>

  <section class="band raised hive hive-left viz-band" aria-labelledby="viz-title">
    <div class="wrap viz-grid">
      <div class="stack-lg">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Patio visualizer</p>
        <h2 id="viz-title" class="h2">See it on <span class="y">your patio</span></h2>
        <p class="lede">Upload a photo, drag four corners onto an opening, and switch between all five systems and both frame colors. Your photo stays on your phone.</p>
        <div class="actions"><a class="btn" href="/patio-visualizer/">Try it with my photo</a></div>
      </div>
      <figure class="viz-shot">
        <Image src={vizShot} widths={[480, 800, 1100]} sizes="(max-width: 820px) 100vw, 640px" alt="Visualizer preview: Hexfold screens drawn onto a photo of a brick patio, with yellow corner handles" loading="lazy" />
        <figcaption><span>Sample: brick patio, Richmond</span><span>Hexfold · Night Gray</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="band on-paper offer hive" id="book" aria-labelledby="offer-title">
    <div class="wrap offer-grid">
      <div class="stack-lg">
        <h2 id="offer-title" class="h2">Your free <span class="y">site visit</span></h2>
        <ol class="visit-steps">
          <li><b>Pick a time that suits you</b><span>Leave your name and number, and your ZIP and best time if you like. We call to confirm.</span></li>
          <li><b>We come to you</b><span>We measure every opening, check your roof, posts and slab, and show you frame colors, mesh and panel samples.</span></li>
          <li><b>You get a written quote</b><span>Emailed within a day of the visit. System, sizes, options and installation, each on its own line. Decide on your own time.</span></li>
        </ol>
        <p class="offer-cost">What the visit costs you: <b>nothing.</b></p>
      </div>
      <div class="book-card" id="book-form">
        <p class="book-k" data-bv-title data-screens="Get your screen quote">Book your free visit</p>
        <BookVisitForm id="home-book" />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="mosaic-title">
    <div class="wrap">
      <div class="row-head">
        <h2 id="mosaic-title" class="h2">Real Houston <span class="y">backyards</span></h2>
        <a class="btn btn-line" href="/projects/">See all projects</a>
      </div>
      <ProjectMosaic />
      <p class="after-cta"><a class="btn" href="#book" data-cb-open>See options like these at your patio</a></p>
    </div>
  </section>

  {REVIEWS.length > 0 && (
  <section class="band raised hive hive-left" aria-labelledby="proof-title">
    <div class="wrap stack-lg">
      <h2 id="proof-title" class="h2">What Houston homeowners <span class="y">say</span></h2>
      <ReviewCards />
      <p class="fine">Had us build yours? <a href="/reviews/">Tell us how we did</a>.</p>
    </div>
  </section>
  )}

  <section class="band raised fold-band" id="fold" aria-labelledby="fold-title">
    <div class="wrap fold-grid">
      <figure class="fold-video dim-frame">
        <video width="540" height="960" data-src="/video/gable-open.mp4" poster="/video/gable-open-poster.jpg" muted loop playsinline preload="none" aria-label="Hexfold screens being folded open by hand on a gabled patio"></video>
        {SITE.youtubeFold && <figcaption><a class="yt" href={SITE.youtubeFold} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.4-1.6.5-4.8.5-4.8s0-3.2-.5-4.8zM9.7 15.1V8.9l5.8 3.1z"/></svg>Watch on YouTube</a></figcaption>}
      </figure>
      <div class="stack-lg">
        <h2 id="fold-title" class="h2">{HOLIDAY ? <>Ready for spring? <span class="y">Watch it fold away</span></> : <>Watch it <span class="y">fold away</span></>}</h2>
        <p class="lede">Hexfold panels hang from the top track and glide aside by hand. No motor, no remote, nothing dragging on the ground. Close them in seconds when the mosquitoes come out.</p>
        <dl class="fold-facts">
          <div><dt>20 ft</dt><dd>wide, meeting in the middle</dd></div>
          <div><dt>10 ft</dt><dd>tall per panel</dd></div>
          <div><dt>$28</dt><dd>per sq ft, installed</dd></div>
        </dl>
        <div class="actions"><a class="btn" href="/patio-screens/hexfold/">See Hexfold</a><a class="btn btn-line" href="/free-quote/">Price my patio</a></div>
      </div>
    </div>
  </section>

  <section class="band on-paper hive hive-left" id="prices" aria-labelledby="price-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="price-title" class="h2">What will my <span class="y">patio cost?</span></h2>
        <p class="lede">Pick a patio and a system to see a typical installed range. We price the open wall area we fill, not your floor. Your exact number comes from a free site visit.</p>
      </div>
      <div class="picker" id="picker" data-json={pickerData}>
        <div class="picker-opts">
          <fieldset>
            <legend>Your patio</legend>
            {SIZES.map((s, i) => (
              <label class="opt"><input type="radio" name="size" value={s.id} checked={i === 1} /><span><b>{s.name}</b> <small>{s.eg}</small><em>{s.low} to {s.high} sq ft of openings</em></span></label>
            ))}
          </fieldset>
          <fieldset>
            <legend>System</legend>
            {order.map((id) => { const p = byId(id); return (
              <label class="opt"><input type="radio" name="sys" value={p.id} checked={p.id === defSys.id} /><span><b>{p.name}</b> <small>{p.kind} · ${p.msrp}/sq ft</small></span></label>
            ); })}
          </fieldset>
        </div>
        <div class="estimate" aria-live="polite">
          <p class="est-label" id="est-label">{defSys.name}, medium patio</p>
          <p class="est-range tnum" id="est-range">{range(defSys.msrp, 200, 300)}</p>
          <p id="est-note" class="muted">200 to 300 sq ft of openings at ${defSys.msrp} per sq ft, installed.</p>
          <ul class="ticks">
            <li>Design and free site visit</li>
            <li>CNC fabrication and testing in Houston</li>
            <li>Installed by our own crew within a month</li>
            <li>Lifetime frame warranty, 3 years on parts</li>
          </ul>
          <p class="fine">Arches, extra posts and locks add to the price. {FINANCING}</p>
          <a class="btn" href="#book" data-cb-open>Get your exact price: book my free visit</a>
        </div>
      </div>
      <div class="band-tight" style="padding-bottom:0"><CompareBars /></div>
    </div>
  </section>


  <section class="band raised hive" aria-labelledby="why-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="why-title" class="h2">Built on 25 years <span class="y">in windows and doors</span></h2>
        <p class="lede">Our team brings 25 years from the window and door business, where we learned how frames, tracks and seals hold up in Houston weather. We have built these enclosures here since 2022, they are now in their fourth generation, and patio enclosures are all we make today. <a href="/why-ae/">Why buying from the maker matters</a> · <a href="/compare/">How we compare</a></p>
      </div>
      <Why />
      <div class="split facts-split">
        <div>
          <span class="facts-label">The facts</span>
          <table class="facts">
            <caption>Hexfold &amp; Fixed Screen</caption>
            <tbody>
              <tr><th scope="row">Mesh</th><td>Hexfold: honeycomb aluminum. Fixed Screen: 304 stainless steel.</td></tr>
              <tr><th scope="row">Mesh density</th><td>{FACTS.mesh} (Hexfold)</td></tr>
              <tr><th scope="row">Wind</th><td>Hexfold operates in winds up to {FACTS.foldWind}. Retract and secure for {FACTS.foldStowed}.</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <table class="facts" style="margin-top:52px">
            <caption>Polycarbonate panels</caption>
            <tbody>
              <tr><th scope="row">Visible light</th><td>{FACTS.vlt} transmission*</td></tr>
              <tr><th scope="row">Solar heat gain</th><td>{FACTS.shgc} SHGC*</td></tr>
              <tr><th scope="row">Wind</th><td>Fixed panels rated to {FACTS.fixedWind}</td></tr>
              <tr><th scope="row">Frames</th><td>Heat welded, no screws. Aluminum core, ceramic coating. Night Gray or Bright White.</td></tr>
              <tr><th scope="row">Every job</th><td>Installed within a month. Lifetime frame warranty, 3 years on parts.</td></tr>
            </tbody>
          </table>
          <p class="fine" style="margin-top:10px">*Tested on Midnight Smoke panels.</p>
        </div>
      </div>
    </div>
  </section>


  <section class="band" aria-labelledby="faq-title">
    <div class="wrap split" style="align-items:start">
      <div class="stack-lg">
        <h2 id="faq-title" class="h2">Before you <span class="y">book</span></h2>
        <p class="lede">Straight answers. More on the <a href="/faq/">full FAQ</a>.</p>
        <div class="stack">
          <h3 class="h3">Serving greater Houston</h3>
          <p class="muted">See the showroom at {SITE.streetShort}, Houston, TX {SITE.zip} by appointment, 9 am to 5 pm, 7 days a week (call first so someone is there to show you around), or book a free site visit at your home.</p>
          <ul class="cities">{CITIES.map((c) => <li>{CITY_PAGES[c] ? <a href={CITY_PAGES[c]}>{c}</a> : c}</li>)}</ul>
          <a href="/service-area/">See our service area</a>
        </div>
      </div>
      <Faq items={visitFaq} />
    </div>
    <div class="wrap" style="margin-top:32px"><a class="btn btn-big" href="#book" data-cb-open>Book my free site visit</a></div>
  </section>
</Base>

<style>
  .p3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .p3 figure { margin: 0; display: grid; gap: 12px; align-content: start; }
  .p3 :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 2px solid var(--yellow); }
  .p3 :global(.p3-mesh) { object-position: 18% 50%; }
  .p3 figcaption { color: var(--ink-2); }
  .p3 figcaption b { display: block; color: var(--ink); font-weight: 800; font-stretch: 80%; font-size: 1.25rem; text-transform: uppercase; margin-bottom: 4px; }
  .proof3 { padding-block: clamp(40px, 6vw, 72px); }
  @media (max-width: 820px) { .p3 { grid-template-columns: minmax(0, 1fr); } }

  .hero { overflow: hidden; }
  .hero-grid { display: grid; grid-template-areas: 'title media' 'body media'; grid-template-rows: auto 1fr; row-gap: 26px; grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr); gap: clamp(32px, 5vw, 56px); align-items: center; padding-block: clamp(48px, 7vw, 80px) clamp(56px, 8vw, 88px); }
  .proof { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 6px 0 0; max-width: 580px; }
  .proof div { border-left: 2px solid var(--yellow); padding-left: 10px; }
  .proof dt { font-weight: 800; font-stretch: 75%; font-size: 1.65rem; line-height: 1; }
  .proof dd { margin: 5px 0 0; font-size: 0.9rem; line-height: 1.3; color: var(--ink-2); }
  .h-title { grid-area: title; align-self: end; }
  .h-title .display { font-size: clamp(2.9rem, 5.6vw, 5.2rem); }
  .h-body { grid-area: body; align-content: start; }
  .hero-media { grid-area: media; align-self: center; display: grid; gap: 12px; padding-top: 30px; min-width: 0; }
  .hero-frame { position: relative; }
  .hero-frame .dim.h span { background: var(--honey); }
  .hint { font-family: var(--mono); font-size: 0.8rem; font-weight: 600; color: var(--ink-2); }
  .hint span { color: var(--yellow); font-size: 1.1rem; margin-right: 6px; }
  .trust { background: var(--yellow); color: var(--honey); }
  .trust-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; }
  .trust-row > div { display: flex; align-items: center; gap: 14px; padding-block: 26px; padding-inline: 18px; min-width: 0; }
  .trust-row > div + div { border-left: 2px solid rgba(42, 37, 34, 0.25); }
  .trust-row > div:first-child { padding-left: 0; }
  .trust svg { width: 38px; height: 38px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .trust b { font-weight: 800; font-stretch: 74%; font-size: clamp(1.1rem, 1.7vw, 1.5rem); line-height: 1.05; text-transform: uppercase; }
  .fold-grid { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .fold-video { margin: 0; justify-self: center; width: 100%; max-width: 270px; }
  .fold-video figcaption { padding-top: 12px; text-align: center; }
  .yt { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--ink); text-decoration: underline; text-decoration-color: var(--yellow); text-underline-offset: 3px; }
  .yt svg { width: 22px; height: 22px; fill: #FF0000; }
  .fold-video video { aspect-ratio: 9 / 16; width: 100%; object-fit: cover; }
  .fold-facts { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; max-width: 520px; }
  .fold-facts div { border-left: 2px solid var(--yellow); padding-left: 10px; }
  .fold-facts dt { font-weight: 800; font-stretch: 72%; font-size: 2.4rem; line-height: 1; color: var(--yellow); }
  .fold-facts dd { margin: 4px 0 0; font-size: 0.9rem; color: var(--ink-2); }
  @media (max-width: 760px) { .fold-grid { grid-template-columns: minmax(0, 1fr); } .fold-video { max-width: 240px; } }
  .row-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: clamp(24px, 3vw, 36px); }
  @media (max-width: 900px) { .trust-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } .trust-row > div:nth-child(3) { border-left: 0; padding-left: 0; } .trust-row > div:nth-child(n+3) { border-top: 2px solid rgba(42, 37, 34, 0.25); } }
  @media (max-width: 480px) { .trust-row > div { padding-inline: 10px; gap: 10px; } .trust svg { width: 30px; height: 30px; } }
  .paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px; }
  .path { background: var(--honey-2); border-top: 4px solid var(--yellow); display: flex; flex-direction: column; min-width: 0; }
  .path img { aspect-ratio: 16 / 10; width: 100%; object-fit: cover; }
  .two-up { margin: 0; position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr); gap: 4px; background: var(--honey); aspect-ratio: 16 / 10; overflow: hidden; }
  .two-up .tag { left: auto; right: 10px; }
