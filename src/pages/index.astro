<script is:inline>
  (function () {
    var v = document.querySelectorAll('video[data-src]');
    if (!('IntersectionObserver' in window)) { v.forEach(function (x) { x.src = x.dataset.src; }); return; }
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        var x = e.target; io.unobserve(x); x.src = x.dataset.src;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) { x.autoplay = true; x.play().catch(function () {}); } else { x.controls = true; }
      });
    }, { rootMargin: '300px' });
    v.forEach(function (x) { io.observe(x); });
  })();
  (function () {
    var el = document.getElementById('picker');
    if (!el) return;
    var d = JSON.parse(el.getAttribute('data-json'));
    var fmt = function (n) { return '$' + (Math.round(n / 100) * 100).toLocaleString('en-US'); };
    function update() {
      var sid = el.querySelector('input[name="size"]:checked').value;
      var pid = el.querySelector('input[name="sys"]:checked').value;
      var s = d.sizes.find(function (x) { return x.id === sid; });
      var p = d.products.find(function (x) { return x.id === pid; });
      document.getElementById('est-label').textContent = p.name + ', ' + s.name.toLowerCase() + ' patio';
      document.getElementById('est-range').textContent = fmt(p.msrp * s.low) + ' to ' + fmt(p.msrp * s.high);
      document.getElementById('est-note').textContent = s.low + ' to ' + s.high + ' sq ft of openings at $' + p.msrp + ' per sq ft, installed.';
    }
    el.addEventListener('change', update);
  })();
</script>
