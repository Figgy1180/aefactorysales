---
// Homepage, Nov 2026 refresh (preview). Section order follows the approved brief:
// 1 PC-led experience and offer, 2 operation demo, 3 room and screen pathways, 4 factory proof,
// 5 real installations, 6 pricing and financing, 7 process, 8 showroom, 9 FAQ and visit request.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ProjectMosaic from '../components/ProjectMosaic.astro';
import ReviewCards from '../components/ReviewCards.astro';
import { REVIEWS } from '../data/reviews';
import { GUIDES } from '../data/guides';
import { PRODUCTS, SIZES, FAQ, FACTS, SITE, byId, range, FINANCING, type QA } from '../data/site';

import heroImg from '../assets/projects/p34/5-inside-seating.jpg';
import roomShowroom from '../assets/photos/showroom-polycarbonate-smoke.jpg';
import rClearfixed from '../assets/renders/clearfixed.png';
import rClearfold from '../assets/renders/clearfold.png';
import rHybrid from '../assets/renders/hybrid.png';
import clearfixedPhoto from '../assets/photos/clearfixed-polycarbonate-panels.jpg';
import hexClosed from '../assets/photos/hexfold-patio-closed.jpg';
import hexOpen from '../assets/photos/hexfold-patio-open.jpg';
import fixedDoors from '../assets/photos/fixed-screen-doors-closed.jpg';
import fixedColors from '../assets/photos/fixed-screen-frame-colors.jpg';
import vizShot from '../assets/renders/visualizer-sample.jpg';
import cnc from '../assets/photos/factory-cnc.jpg';
import angle from '../assets/photos/factory-angle.jpg';
import pcRack from '../assets/photos/factory-pc-smoke.jpg';
import showroomIn from '../assets/photos/showroom-room-interior.jpg';

const uses = ['Cooking', 'Entertaining', 'Relaxing', 'Poolside', 'Family and pet time'];
// Five systems, two photos each. The second photo links to that system's "Is it right for my patio?" guide.
type Pic = { src: any; alt: string; cap: string };
const cards: { id: string; a: Pic; b: Pic; sell: string }[] = [
  { id: 'clearfixed', sell: 'A fixed wall of tinted panels for wind, rain and cooler days. Cut to arches for gables.',
    a: { src: rClearfixed, alt: 'Concept visualization of Clearfixed tinted polycarbonate panels', cap: 'Concept visualization' },
    b: { src: clearfixedPhoto, alt: 'Clearfixed polycarbonate panels', cap: 'Clearfixed panels' } },
  { id: 'clearfold', sell: 'A 3-season room on cool days, an open patio on nice ones. Folds by hand.',
    a: { src: roomShowroom, alt: 'Folding Smokey Gray polycarbonate panels in the AE showroom', cap: 'In our Houston showroom' },
    b: { src: rClearfold, alt: 'Concept visualization of Clearfold folding polycarbonate panels', cap: 'Concept visualization' } },
  { id: 'hybrid', sell: 'Mesh and panels on the same opening, each covering all of it. Our most flexible system.',
    a: { src: showroomIn, alt: 'A room combining polycarbonate panels and metal mesh in the AE showroom', cap: 'In our Houston showroom' },
    b: { src: rHybrid, alt: 'Concept visualization of the Hybrid system', cap: 'Concept visualization' } },
  { id: 'hexfold', sell: 'Pleated honeycomb aluminum mesh that folds away. Up to 20 ft wide with no posts.',
    a: { src: hexClosed, alt: 'Brick Houston patio closed in with Hexfold folding screens', cap: 'Real installation, closed' },
    b: { src: hexOpen, alt: 'The same patio with the Hexfold screens folded open', cap: 'Real installation, open' } },
  { id: 'fixed', sell: 'Stainless steel mesh that stays in place, at our lowest starting price.',
    a: { src: fixedDoors, alt: 'Fixed Screen panels with screen doors on a Houston patio', cap: 'Real installation' },
    b: { src: fixedColors, alt: 'Fixed Screen panels in Night Gray and Bright White frames', cap: 'Frame colors' } },
];
const guideOf = (id: string) => GUIDES.find((g) => g.sys === id)!;
const order = ['clearfixed', 'clearfold', 'hybrid', 'hexfold', 'fixed'];
const defSys = byId('clearfixed');
const pickerData = JSON.stringify({ products: PRODUCTS.map(({ id, name, msrp }) => ({ id, name, msrp })), sizes: SIZES });
const TAX = 'per sq ft of opening, installed, before sales tax';
const EXTRAS = 'Accessories and other options are extra and are quoted for your project.';
const LENDERS = 'Financing is available through HFS Financial and Acorn Finance. Subject to credit approval; third-party lenders, AE is not a lender.';

const build = [
  { t: 'Your measurements become your parts', d: 'Each opening measured at your home becomes a set of parts labeled for your project.' },
  { t: 'CNC cutting', d: 'Length and angle saws cut frames to your sizes, including shaped sections for gables.', img: cnc, alt: 'CNC dual-head saw cutting frame profiles in the AE factory' },
  { t: 'Welded frames', d: 'Frame corners are heat welded instead of screwed, with handles and locks routed into the frame.', img: angle, alt: 'Angle saw used for shaped frame sections' },
  { t: 'Panels and wheels assembled', d: 'Mesh and polycarbonate are cut in their own areas and fitted with wheels and guards.', img: pcRack, alt: 'Smokey Gray polycarbonate panels racked in the factory' },
  { t: 'Staged and tested', d: 'The complete order is assembled and tested in our staging area, then taken apart and packed.' },
  { t: 'Arrives labeled', d: 'Every piece is numbered for its opening, so install day goes smoothly.' },
];

const process = [
  { t: 'Free design visit', d: 'We measure every opening, design the layout with you and go over options at your home.' },
  { t: 'Written quote', d: 'Your quote is emailed within a day of the visit, every item on its own line. Online estimates are preliminary.' },
  { t: '50% deposit starts production', d: 'Your cleared deposit starts production and the lead time. Need HOA approval? We provide drawings and specs on request.' },
  { t: 'See your finished order', d: 'We show you the completed order. The remaining 50% is due before installation.' },
  { t: 'Installed by our crew', d: 'Our own crew installs, never subcontractors. Most jobs take one day on site.' },
];

const visitFaq: QA[] = [
  { q: 'Is the design visit really free?', a: 'Yes. We come to your home, measure every opening, design the layout with you and email your written quote within a day, at no cost.' },
  { q: 'Do I have to decide at the visit?', a: 'No. Take your written quote and decide on your own time.' },
  { q: 'What will it cost?', a: `Starting prices run $24 to $56 ${TAX}, depending on the system. ${EXTRAS} ${LENDERS}` },
  { q: 'Which should I choose: a 3-season room or screens?', a: 'Polycarbonate panels block wind and rain, so the patio works in cooler and wetter weather. Metal screens keep the breeze and keep bugs outside. The Hybrid puts both on the same opening so you can switch.' },
  FAQ.general[1],
];
---
<Base
  title="Patio Enclosures in Houston | AE Factory Sales"
  description="Custom polycarbonate 3-season rooms and metal patio screens for existing covered patios. Precision-prepared in Houston, installed by our own crew."
>
  <!-- 1. Experience and offer -->
  <section class="h-hero hive-dark" aria-labelledby="hero-title">
    <div class="wrap h-grid">
      <div class="h-copy">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Houston patio enclosures and screens</p>
        <h1 id="hero-title" class="display">Make your patio your <span class="y">favorite place to be.</span></h1>
        <p class="sub">Custom polycarbonate enclosures and metal screens for existing covered patios. Precision-prepared in Houston, professionally installed, with local support.</p>
        <ul class="uses" aria-label="What people use their enclosed patio for">{uses.map((u) => <li>{u}</li>)}</ul>
        <div class="actions">
          <a class="btn btn-big" href="/free-quote/">Request a free design visit</a>
          <a class="btn btn-line" href="#systems">Explore systems</a>
        </div>
        <p class="micro">We call to confirm a time that suits you. Rather talk? Call <a href={SITE.phoneHref}>{SITE.phone}</a>, or <a href="/showroom/">visit the showroom</a>.</p>
      </div>
      <figure class="h-photo">
        <Image src={heroImg} widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 640px" alt="Seating area inside a Houston patio enclosed by AE metal screens" loading="eager" fetchpriority="high" />
        <figcaption>Real AE installation in Houston, metal screens</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. See it on your patio -->
  <section class="band raised hive-dark viz-band" aria-labelledby="viz-title">
    <div class="wrap viz-grid">
      <div class="stack-lg">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Patio visualizer</p>
        <h2 id="viz-title" class="h2">See it on <span class="y">your patio</span></h2>
        <p class="lede">Upload a photo, drag four corners onto an opening, and switch between all five systems and both frame colors. Your photo stays on your phone.</p>
        <div class="actions"><a class="btn" href="/patio-visualizer/">Try it with my photo</a></div>
        <p class="micro">Want to see how each one opens? <a href="/patio-enclosures/hybrid/#how-hybrid">Hybrid</a> · <a href="/patio-screens/hexfold/#how-hexfold">Hexfold</a> · <a href="/patio-enclosures/clearfold/#how-clearfold">Clearfold</a> · <a href="/patio-enclosures/clearfixed/#how-clearfixed">Clearfixed</a> · <a href="/patio-screens/fixed-screen/#how-fixed">Fixed Screen</a></p>
      </div>
      <figure class="viz-shot">
        <Image src={vizShot} widths={[480, 900, 1400]} sizes="(max-width: 820px) 100vw, 640px" alt="Visualizer preview: Hexfold screens meeting in the middle, drawn onto a photo of a brick patio" loading="lazy" />
        <figcaption><span>Sample: brick patio, Richmond</span><span>Hexfold · Night Gray</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- 3. Pathways -->
  <section class="band" id="systems" aria-labelledby="paths-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Five systems, one frame</p>
        <h2 id="paths-title" class="h2">A 3-season room, metal screens, or both</h2>
        <p class="lede">Every system uses the same welded, metal-reinforced frame in Night Gray or Bright White. Prices are {TAX}.</p>
      </div>
      <h3 class="fam"><span class="hexdot" aria-hidden="true"></span>Three-season rooms</h3>
      <div class="cards cards-3">
        {cards.slice(0, 3).map((c) => { const p = byId(c.id); const g = guideOf(c.id); return (
          <article class="card">
            <div class="pics">
              <figure><Image src={c.a.src} alt={c.a.alt} widths={[400, 700]} sizes="(max-width: 700px) 50vw, 200px" loading="lazy" /><figcaption>{c.a.cap}</figcaption></figure>
              <a class="why" href={`/guides/${g.slug}/`}>
                <Image src={c.b.src} alt={c.b.alt} widths={[400, 700]} sizes="(max-width: 700px) 50vw, 200px" loading="lazy" />
                <span class="why-tag"><span class="hexdot" aria-hidden="true"></span>{g.q}</span>
              </a>
            </div>
            <div class="card-body">
              <h4><a href={p.href}>{p.name}</a> <em>from ${p.msrp}</em></h4>
              <p class="kind">{p.kind}</p>
              <p>{c.sell}</p>
              <p class="cap2">{c.b.cap}</p>
            </div>
          </article>
        ); })}
      </div>
      <h3 class="fam"><span class="hexdot" aria-hidden="true"></span>Metal screens</h3>
      <div class="cards cards-2">
        {cards.slice(3).map((c) => { const p = byId(c.id); const g = guideOf(c.id); return (
          <article class="card">
            <div class="pics">
              <figure><Image src={c.a.src} alt={c.a.alt} widths={[400, 700]} sizes="(max-width: 700px) 50vw, 300px" loading="lazy" /><figcaption>{c.a.cap}</figcaption></figure>
              <a class="why" href={`/guides/${g.slug}/`}>
                <Image src={c.b.src} alt={c.b.alt} widths={[400, 700]} sizes="(max-width: 700px) 50vw, 300px" loading="lazy" />
                <span class="why-tag"><span class="hexdot" aria-hidden="true"></span>{g.q}</span>
              </a>
            </div>
            <div class="card-body">
              <h4><a href={p.href}>{p.name}</a> <em>from ${p.msrp}</em></h4>
              <p class="kind">{p.kind}</p>
              <p>{c.sell}</p>
              <p class="cap2">{c.b.cap}</p>
            </div>
          </article>
        ); })}
      </div>
      <p class="fine" style="margin-top:18px">Polycarbonate panel facts: {FACTS.vlt} visible light and {FACTS.shgc} SHGC (Smokey Gray panel test, not a full installed-system rating). Fixed panels rated to {FACTS.fixedWind}; folding systems operate to {FACTS.foldWind}, retract and secure for {FACTS.foldStowed}. Not sure yet? <a href="/patio-visualizer/">Try them on your patio photo</a>.</p>
    </div>
  </section>

  <!-- 4. Factory proof -->
  <section class="band on-white hive-light" aria-labelledby="build-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker dark"><span class="hexdot" aria-hidden="true"></span>Prepared in Houston</p>
        <h2 id="build-title" class="h2">Made to your measurements, before we arrive</h2>
        <p class="lede">Parts are cut and assembled for your openings in our factory on William Tell Street, and the full order is tested before it leaves. That is why install day is quick and the fit is right. <a href="/how-we-build/">Tour the factory</a></p>
      </div>
      <div class="build-photos">
        {build.filter((s) => s.img).map((s) => (
          <figure><Image src={s.img} alt={s.alt!} widths={[360, 640]} sizes="(max-width: 640px) 100vw, 360px" loading="lazy" /><figcaption>{s.t}</figcaption></figure>
        ))}
      </div>
      <ol class="build">
        {build.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- 5. Real installations -->
  <section class="band" aria-labelledby="mosaic-title">
    <div class="wrap">
      <div class="row-head">
        <div class="stack">
          <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Real Houston backyards</p>
          <h2 id="mosaic-title" class="h2">Installed by our own crew</h2>
        </div>
        <a class="btn btn-line" href="/projects/">See all projects</a>
      </div>
      <ProjectMosaic />
      <p class="fine" style="margin-top:12px">Every photo here is a finished AE job. These projects use our metal screen systems.</p>
      {REVIEWS.length > 0 && <div style="margin-top:40px"><ReviewCards /></div>}
    </div>
  </section>

  <!-- 6. Pricing and financing -->
  <section class="band on-paper" id="prices" aria-labelledby="price-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker dark"><span class="hexdot" aria-hidden="true"></span>Pricing</p>
        <h2 id="price-title" class="h2">What will my patio cost?</h2>
        <p class="lede">Pick a patio and a system for a typical starting range. We price the open wall area we fill, not your floor. Your exact price comes from the free design visit.</p>
      </div>
      <div class="picker" id="picker" data-json={pickerData}>
        <div class="picker-opts">
          <fieldset>
            <legend>Your patio</legend>
            {SIZES.map((s, i) => (
              <label class="opt"><input type="radio" name="size" value={s.id} checked={i === 1} /><span><b>{s.name}</b> <small>{s.eg}</small><em>{s.low} to {s.high} sq ft of openings</em></span></label>
            ))}
          </fieldset>
          <fieldset>
            <legend>System</legend>
            {order.map((id) => { const p = byId(id); return (
              <label class="opt"><input type="radio" name="sys" value={p.id} checked={p.id === defSys.id} /><span><b>{p.name}</b> <small>{p.kind} · ${p.msrp}/sq ft</small></span></label>
            ); })}
          </fieldset>
        </div>
        <div class="estimate" aria-live="polite">
          <p class="est-label" id="est-label">{defSys.name}, medium patio</p>
          <p class="est-range tnum" id="est-range">{range(defSys.msrp, 200, 300)}</p>
          <p id="est-note" class="muted">200 to 300 sq ft of openings at ${defSys.msrp} {TAX}.</p>
          <ul class="ticks">
            <li>Free design visit and written quote</li>
            <li>Prepared and tested in our Houston factory</li>
            <li>Installed by our own crew</li>
            <li>Lifetime frame warranty, 3 years on parts</li>
          </ul>
          <p class="fine">{EXTRAS} Locks, pet doors and low-profile access ramps are examples.</p>
          <p class="fine">{LENDERS}</p>
          <a class="btn" href="/free-quote/">Get my exact price</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Process -->
  <section class="band" aria-labelledby="process-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>From measurement to installation</p>
        <h2 id="process-title" class="h2">How your project runs</h2>
      </div>
      <ol class="proc">{process.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>
    </div>
  </section>

  <!-- 8. Showroom -->
  <section class="band on-white" aria-labelledby="show-title">
    <div class="wrap split">
      <figure class="show-photo"><Image src={showroomIn} widths={[480, 900]} sizes="(max-width: 820px) 100vw, 560px" alt="Inside the AE showroom: a room combining polycarbonate panels and metal mesh" loading="lazy" /></figure>
      <div class="stack-lg">
        <p class="kicker dark"><span class="hexdot" aria-hidden="true"></span>Local showroom and support</p>
        <h2 id="show-title" class="h2">See every system in person</h2>
        <p class="lede">Our showroom is at {SITE.street}, {SITE.city}, {SITE.region} {SITE.zip}, next to the factory. Open 9 am to 5 pm, 7 days a week, by appointment. Customer parking on site.</p>
        <div class="actions"><a class="btn" href={SITE.phoneHref}>Call {SITE.phone} to book</a><a class="btn btn-line" href="/showroom/">Address and directions</a></div>
      </div>
    </div>
  </section>

  <!-- 9. FAQ and visit request -->
  <section class="band hive-dark" id="book" aria-labelledby="book-title">
    <div class="wrap book-grid">
      <div class="stack-lg">
        <h2 id="book-title" class="h2">Questions before your visit</h2>
        <Faq items={visitFaq} />
      </div>
      <div class="book-card">
        <span class="hex-num" aria-hidden="true">1</span>
        <p class="book-k">Request your free design visit</p>
        <p class="lede">Answer four quick questions for a starting price, tell us where your patio is, and we call to confirm a time. About two minutes.</p>
        <a class="btn btn-big" href="/free-quote/">Start my free design visit</a>
        <p class="micro">Rather talk? Call <a href={SITE.phoneHref}>{SITE.phone}</a>, 9 am to 5 pm, 7 days a week.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .viz-band { border-block: 1px solid rgba(242, 194, 48, .35); }
  .viz-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 56px); align-items: center; }
  .viz-shot { margin: 0; border: 1.5px solid var(--yellow); border-radius: 12px; padding: 10px; background: var(--honey); box-shadow: var(--shadow); }
  .viz-shot :global(img) { width: 100%; height: auto; display: block; border-radius: 6px; }
  .viz-shot figcaption { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 10px; font-family: var(--mono); font-size: .75rem; color: var(--ink-2); }
  .micro a { color: var(--yellow); }
  .fam { display: flex; align-items: center; gap: 10px; font-size: 1.15rem; font-weight: 700; margin: 8px 0 14px; }
  .cards { display: grid; gap: 20px; margin-bottom: 30px; }
  .cards-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cards-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { background: var(--honey-2); border: 1px solid rgba(251, 245, 236, .08); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; min-width: 0; }
  .pics { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--honey); }
  .pics figure { margin: 0; position: relative; min-width: 0; }
  .pics :global(img) { width: 100%; aspect-ratio: 4 / 3.4; object-fit: cover; display: block; }
  .pics figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 8px 6px; font-family: var(--mono); font-size: .66rem; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.65)); }
  .why { position: relative; display: block; min-width: 0; text-decoration: none; }
  .why::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 35%, rgba(22, 18, 15, .88)); transition: background .2s; }
  .why:hover::after, .why:focus-visible::after { background: linear-gradient(transparent 10%, rgba(22, 18, 15, .92)); }
  .why-tag { position: absolute; left: 10px; right: 10px; bottom: 9px; z-index: 1; display: flex; gap: 7px; align-items: flex-start; color: #fff; font-family: var(--font-head); font-weight: 700; font-size: .86rem; line-height: 1.2; }
  .why-tag .hexdot { margin-top: 2px; }
  .why:focus-visible { outline: 3px solid var(--yellow); outline-offset: -3px; }
  .card-body { padding: 18px 20px 20px; display: grid; gap: 6px; align-content: start; }
  .card-body h4 { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.02em; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .card-body h4 a { color: var(--ink); text-decoration: none; }
  .card-body h4 a:hover { color: var(--yellow); }
  .card-body h4 em { font-style: normal; font-family: var(--mono); font-size: .85rem; color: var(--yellow); font-weight: 600; }
  .card-body .kind { color: var(--ink-2); font-size: .9rem; }
  .card-body p:not(.kind):not(.cap2) { color: var(--ink); font-size: .97rem; }
  .cap2 { display: none; }
  @media (max-width: 1000px) { .cards-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .cards-3, .cards-2 { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 820px) { .viz-grid { grid-template-columns: minmax(0, 1fr); } }
  .h-hero { padding-block: clamp(36px, 6vw, 80px) clamp(48px, 7vw, 96px); }
  .h-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .h-copy { display: grid; gap: 22px; }
  .h-copy .display { max-width: 13ch; }
  .h-photo { margin: 0; }
  .h-photo :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; box-shadow: var(--shadow); }
  .h-photo figcaption, .path-media figcaption { margin-top: 8px; font-family: var(--mono); font-size: .74rem; color: var(--ink-2); }
  .uses { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .uses li { border: 1px solid var(--line); border-radius: 999px; padding: 5px 13px; font-size: .92rem; color: var(--ink); }
  .btn-big { font-size: 1.06rem; min-height: 54px; padding: 0 26px; }
  .micro { font-size: var(--step--1); color: var(--ink-2); }
  .kicker { margin: 0; display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-weight: 600; font-size: .78rem; text-transform: uppercase; color: var(--yellow); }
  .kicker.dark { color: var(--paper-2); }
  .hexdot { width: 11px; height: 13px; flex: none; background: var(--yellow); clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }

  .demo-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .demo-card { background: var(--honey); border-radius: 12px; padding: clamp(16px, 2.4vw, 26px); box-shadow: var(--shadow); }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ticks li { position: relative; padding-left: 28px; }
