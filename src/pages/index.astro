  .proc li { counter-increment: p; padding-top: 16px; border-top: 2px solid var(--yellow); min-width: 0; display: grid; gap: 8px; align-content: start; }
  .proc li::before { content: counter(p); font-family: var(--font-head); font-weight: 800; font-size: 1.6rem; color: var(--yellow); line-height: 1; }
