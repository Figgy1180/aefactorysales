---
// Homepage, Nov 2026 refresh (preview). Section order follows the revision brief:
// 1 hero, 2 patio visualizer (lead), 3 three choices, 3b PC room plan and fair comparison,
// 4 why AE, 5 real projects, 6 pricing and financing, 7 process, 8 showroom, warranty and aftercare, 9 FAQ and visit invitation.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ProjectMosaic from '../components/ProjectMosaic.astro';
import ReviewCards from '../components/ReviewCards.astro';
import { REVIEWS } from '../data/reviews';
import { GUIDES } from '../data/guides';
import { PRODUCTS, SIZES, FAQ, FACTS, SITE, WARRANTY, byId, range, type QA } from '../data/site';

import pcDoors from '../assets/projects/p37/3-inside-doors-closed.jpg';
import heroReal from '../assets/hero/lake-conroe-interior-enhanced.webp';
import QuickContact from '../components/QuickContact.astro';
import roomShowroom from '../assets/photos/showroom-polycarbonate-smoke.jpg';
import rClearfixed from '../assets/renders/clearfixed.png';
import rClearfold from '../assets/renders/clearfold.png';
import hybridConcept from '../assets/renders/hybrid-concept.jpg';
import clearfixedPhoto from '../assets/photos/clearfixed-polycarbonate-panels.jpg';
import hexClosed from '../assets/photos/hexfold-patio-closed.jpg';
import hexOpen from '../assets/photos/hexfold-patio-open.jpg';
import fixedDoors from '../assets/photos/fixed-screen-doors-closed.jpg';
import fixedColors from '../assets/photos/fixed-screen-frame-colors.jpg';
import vizShot from '../assets/renders/visualizer-sample.jpg';
import cnc from '../assets/photos/factory-cnc.jpg';
import angle from '../assets/photos/factory-angle.jpg';
import pcRack from '../assets/photos/factory-pc-smoke.jpg';
import showroomIn from '../assets/photos/showroom-room-interior.jpg';

const proof = ['From $24 per sq ft of opening, installed', 'Built in our Houston factory', 'Installed within a month of your order', 'Most installs take one day on site'];
const topReview = REVIEWS[0];

type Pic = { src: any; alt: string; cap: string };
type Card = { id: string; a: Pic; b: Pic; sell: string };
const cards: Record<string, Card> = {
  clearfixed: { id: 'clearfixed', sell: 'A fixed wall of tinted panels for wind, rain and cooler days. Cut to arches and angles for gables.',
    a: { src: rClearfixed, alt: 'Concept visualization of Clearfixed tinted polycarbonate panels', cap: 'Concept visualization' },
    b: { src: clearfixedPhoto, alt: 'Clearfixed polycarbonate panels', cap: 'Clearfixed panels' } },
  clearfold: { id: 'clearfold', sell: 'Sheltered on cool or rainy days, open on nice ones. Equal-width leaves fold by hand.',
    a: { src: roomShowroom, alt: 'Folding Smokey Gray polycarbonate panels in the AE showroom', cap: 'In our Houston showroom' },
    b: { src: rClearfold, alt: 'Concept visualization of Clearfold folding polycarbonate panels', cap: 'Concept visualization' } },
  hybrid: { id: 'hybrid', sell: 'Panels and metal mesh on the same opening. Each can cover all of it, either can stop part way, and both fold back for an open passage.',
    a: { src: pcDoors, alt: 'Blue-tinted polycarbonate Hybrid doors closed on a Sugar Land patio, installed by AE', cap: 'Real installation, Sugar Land' },
    b: { src: hybridConcept, alt: 'Concept visualization of the Hybrid with the polycarbonate layer closed and the mesh folded at one end', cap: 'Concept visualization: panels closed' } },
  hexfold: { id: 'hexfold', sell: 'Pleated honeycomb aluminum mesh that folds away. Up to 20 ft wide with no posts.',
    a: { src: hexClosed, alt: 'Brick Houston patio closed in with Hexfold folding screens', cap: 'Real installation, closed' },
    b: { src: hexOpen, alt: 'The same patio with the Hexfold screens folded open', cap: 'Real installation, open' } },
  fixed: { id: 'fixed', sell: '304 stainless steel mesh that stays in place, at our lowest starting price.',
    a: { src: fixedDoors, alt: 'Fixed Screen panels with screen doors on a Houston patio', cap: 'Real installation' },
    b: { src: fixedColors, alt: 'Fixed Screen panels in Night Gray and Bright White frames', cap: 'Frame colors' } },
};
const choices = [
  { k: 'room', t: 'A three-season room', d: 'Tinted polycarbonate blocks wind and rain and cuts glare, so the patio stays useful in cooler, wetter weather.', ids: ['clearfixed', 'clearfold'] },
  { k: 'screens', t: 'Durable metal screens', d: 'Keep the breeze and keep bugs outside, with metal mesh that stands up to everyday wear better than ordinary fabric screen.', ids: ['hexfold', 'fixed'] },
  { k: 'both', t: 'Both on one opening', d: 'The Hybrid puts panels and mesh on the same opening, so you choose shelter, airflow or open access day by day.', ids: ['hybrid'] },
];
const guideOf = (id: string) => GUIDES.find((g) => g.sys === id)!;
const order = ['clearfixed', 'clearfold', 'hybrid', 'hexfold', 'fixed'];
const defSys = byId('clearfixed');
const pickerData = JSON.stringify({ products: PRODUCTS.map(({ id, name, msrp }) => ({ id, name, msrp })), sizes: SIZES });
const TAX = 'per sq ft of opening, installed, before sales tax';
const EXTRAS = 'Accessories and other options, such as locks and optional access ramps, are extra and quoted for your project. Doggy doors are a $200 add-on.';
const LENDERS = 'Financing is available through HFS Financial and Acorn Finance, subject to lender terms and approval. AE is not a lender.';

const why = [
  { f: 'Purpose-made components', b: 'Frames, tracks, panels and mesh are made to our specifications and engineered to work together, so you get one coordinated enclosure system.' },
  { f: 'CNC preparation to your openings', b: 'Parts are cut to the openings we measured, which gives a precise fit, including arches, angles and patios with several openings.' },
  { f: 'Heat-welded frame corners', b: 'Welded corners give clean lines and durable joints.' },
  { f: 'Complete factory test assembly', b: 'Your whole order is assembled and checked in our factory before it is packed for delivery.' },
  { f: 'Labeled, prepared components', b: 'Every piece is numbered for its opening, so we can install within a month of your order and most jobs take one day on site.' },
  { f: 'Easy manual folding', b: 'Folding systems open and close by hand: no motors, no wiring, and they still work in a power outage.' },
  { f: 'Durable metal mesh', b: 'Stainless steel or honeycomb aluminum mesh is a strong choice for pet owners and anyone tired of fabric screens that tear or sag.' },
  { f: 'Houston factory and local support', b: 'We build, install and support from the same Houston address, so you know who is accountable after the sale.' },
];
const factoryPics = [
  { img: cnc, alt: 'CNC dual-head saw cutting frame profiles in the AE factory', t: 'CNC cutting to your sizes' },
  { img: angle, alt: 'Angle saw used for shaped frame sections', t: 'Shaped sections for gables' },
  { img: pcRack, alt: 'Smokey Gray polycarbonate panels racked in the factory', t: 'Polycarbonate cut in its own area' },
];


const process = [
  { t: 'Design visit', d: 'A professional visits, measures every opening and designs the layout with you.' },
  { t: 'Your quote', d: 'We go over it with you on site, then email it within 24 hours.' },
  { t: '50% deposit', d: 'Your cleared deposit starts production in our Houston factory.' },
  { t: 'Proof of your order', d: 'We show you the completed order before it leaves the factory.' },
  { t: 'Remaining 50%', d: 'The balance is due before installation.' },
  { t: 'Installation', d: 'Within a month of your order, by our own crew. Most jobs take one day on site.' },
];

const visitFaq: QA[] = [
  { q: 'Is the design visit really free?', a: 'Yes. We come to your home, measure every opening, design the layout with you and go over your quote on site, then email it within 24 hours. There is no cost and no obligation.' },
  { q: 'Do I have to decide at the visit?', a: 'No. Take your quote and decide on your own time.' },
  { q: 'What will it cost?', a: `Starting prices run $24 to $56 ${TAX}, depending on the system. ${EXTRAS} ${LENDERS}` },
  { q: 'Is a three-season room air-conditioned?', a: 'No. It is a three-season enclosure for an existing covered patio, not an insulated or air-conditioned room. It shelters you from wind, rain and glare, and on the hottest summer afternoons it stays close to the outdoor temperature. We plan ventilation with you at the design visit.' },
  { q: 'Can you help with my HOA?', a: 'Yes. When your HOA needs them, we provide drawings and product specifications for your application. Approval is up to your HOA, so we cannot guarantee it.' },
  FAQ.general[1],
];
---
<Base
  title="Patio Enclosures in Houston | AE Factory Sales"
  description="Custom polycarbonate three-season rooms and metal patio screens for existing covered patios. Prepared in our Houston factory and installed by our own crew."
>
  <!-- 1. Hero -->
  <section class="h-hero" aria-labelledby="hero-title">
    <Image class="hero-interior" src={heroReal} widths={[640, 960, 1280, 1672]} sizes="100vw" alt="AI-enhanced view from inside AE's Lake Conroe outdoor kitchen screen installation, with a warm wood ceiling and views of the pines" loading="eager" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap h-grid">
      <div class="h-copy">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Houston covered-patio enclosures</p>
        <h1 id="hero-title" class="display">Your favorite room.<br /><span class="y">Already under your roof.</span></h1>
        <p class="sub">Make more of the patio you have. Choose tinted polycarbonate panels for weather shelter, metal screens for the breeze, or both on the same opening.</p>
        <div class="actions">
          <a class="btn btn-big" href="/book-visit/">Plan my patio with AE</a>
          <a class="btn btn-line btn-big" href="/patio-visualizer/">See it on my patio</a>
        </div>
        <p class="micro">Not sure what fits? We measure and help you choose. <a href="/free-quote/">Explore installed pricing</a> · <a href="#request-call">Request a call</a></p>
      </div>
    </div>
    <div class="wrap hero-foot">
      <p class="hero-caption">AI-enhanced Lake Conroe screen project. <a href="/projects/lake-conroe-outdoor-kitchen-enclosure/">See the original installation</a>. Shown with metal screens, not polycarbonate panels.</p>
      <ul class="proof" aria-label="Why AE"><li>Prepared in Houston</li><li>Manual folding systems</li><li>Metal-core frames</li><li>Measured for your patio</li></ul>
    </div>
  </section>

  <section class="band" aria-labelledby="choose-path-title" style="padding-block:32px">
    <div class="wrap"><h2 id="choose-path-title" class="h3" style="margin-bottom:20px">What would make your patio more useful?</h2>
      <ul class="choice-tabs" style="margin-bottom:0">
        <li><a href="#choice-room"><span class="hex-n">1</span><b>Shelter from wind and rain</b><span>Tinted polycarbonate three-season rooms</span></a></li>
        <li><a href="#choice-screens"><span class="hex-n">2</span><b>Breeze without the bugs</b><span>Folding aluminum or fixed stainless steel mesh</span></a></li>
        <li><a href="#choice-both"><span class="hex-n">3</span><b>Switch between both</b><span>Hybrid: panels and mesh on the same opening</span></a></li>
      </ul>
    </div>
  </section>

  <!-- 2. Visualizer leads: see it on your patio, then discover the systems -->
  <section class="band raised hive-dark viz-band" id="visualize" aria-labelledby="viz-title">
    <div class="wrap viz-grid">
      <div class="stack-lg">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Patio visualizer</p>
        <h2 id="viz-title" class="h2">See it on <span class="y">your patio</span></h2>
        <p class="lede">Snap a photo of your patio, drag four corners onto an opening, and try every AE system in both frame colors. Manual photo placement stays on your device. Optional AI assistance sends a smaller copy only when you ask for it.</p>
        <div class="actions"><a class="btn btn-big" href="/patio-visualizer/">Try it with my photo</a></div>
        <div class="viz-try">
          <p class="micro">Or start with a system:</p>
          <ul>
            <li><a href="#choice-room">Three-season room</a></li>
            <li><a href="#choice-screens">Metal screens</a></li>
            <li><a href="#choice-both">Both on one opening</a></li>
          </ul>
        </div>
      </div>
      <figure class="viz-shot">
        <a href="/patio-visualizer/" class="viz-link" aria-label="Open the patio visualizer">
          <Image src={vizShot} widths={[480, 900, 1400]} sizes="(max-width: 820px) 100vw, 640px" alt="Visualizer preview: Hexfold screens meeting in the middle, drawn onto a photo of a brick patio" loading="lazy" />
        </a>
        <figcaption><span>Visualizer sample: brick patio</span><span>Hexfold · Night Gray</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- 3. Three choices -->
  <section class="band" id="systems" aria-labelledby="paths-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Three ways to use your patio</p>
        <h2 id="paths-title" class="h2">A three-season room, metal screens, or both</h2>
        <p class="lede">Five systems share one heat-welded, metal-reinforced frame in Night Gray or Bright White, and we mix them opening by opening. Prices are {TAX}.</p>
      </div>
      {choices.map((ch) => (
        <div class="choice" id={`choice-${ch.k}`}>
          <h3 class="fam"><span class="hexdot" aria-hidden="true"></span>{ch.t}</h3>
          <p class="fam-d">{ch.d}</p>
          {ch.ids.length > 1 && <p class="swipe-hint" aria-hidden="true">Swipe to see both →</p>}
          <div class={`cards ${ch.ids.length === 1 ? 'cards-1' : 'cards-2'}`}>
            {ch.ids.map((id) => { const c = cards[id]; const p = byId(id); const g = guideOf(id); return (
              <article class="card">
                <div class="pics">
                  <figure><Image src={c.a.src} alt={c.a.alt} widths={[400, 700]} sizes="(max-width: 700px) 50vw, 320px" loading="lazy" /><figcaption>{c.a.cap}</figcaption></figure>
                  <a class="why" href={`/guides/${g.slug}/`}>
                    <Image src={c.b.src} alt={c.b.alt} widths={[400, 700]} sizes="(max-width: 700px) 50vw, 320px" loading="lazy" />
                    <span class="why-cap">{c.b.cap}</span>
                    <span class="why-tag"><span class="hexdot" aria-hidden="true"></span>{g.q}</span>
                  </a>
                </div>
                <div class="card-body">
                  <h4><a href={p.href}>{p.name}</a> <em>from ${p.msrp}<small> per sq ft of opening</small></em></h4>
                  <p class="kind">{p.kind}</p>
                  <p>{c.sell}</p>
                  <p class="card-links"><a href={p.href}>{p.name} details</a>{id === 'hybrid' && <> · <a href="/patio-enclosures/hybrid/#how-hybrid">Watch how it opens</a></>}</p>
                </div>
              </article>
            ); })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3b. PC room value -->
  <section class="band on-paper" aria-labelledby="room-title">
    <div class="wrap">
      <div class="room-grid">
        <div class="stack-lg">
          <p class="kicker dark"><span class="hexdot" aria-hidden="true"></span>Planning a three-season room</p>
          <h2 id="room-title" class="h2">Fixed where you want shelter, folding where you want air</h2>
          <p class="lede">A typical layout puts fixed Clearfixed panels across the long front and Hybrid openings on the two shorter sides. Close everything on a windy, rainy day; fold the sides open on a nice one. Your final ventilation plan is designed with you at the site visit.</p>
          <p class="note">This is a three-season enclosure for an existing covered patio. It is not insulated or air-conditioned, and on the hottest summer afternoons it stays close to the outdoor temperature.</p>
        </div>
        <figure class="plan">
          <svg viewBox="0 0 420 300" role="img" aria-labelledby="plan-t plan-d">
            <title id="plan-t">Representative three-season room layout</title>
            <desc id="plan-d">Floor plan of a covered patio against the house. The long front side has fixed polycarbonate panels. The two short sides have Hybrid openings that fold open.</desc>
            <rect x="20" y="20" width="380" height="26" fill="#3B3430" />
            <text x="210" y="38" text-anchor="middle" class="pl-house">HOUSE</text>
            <rect x="40" y="46" width="340" height="200" fill="#F2C230" fill-opacity=".08" />
            <g stroke="#55595E" stroke-width="10"><line x1="40" y1="246" x2="380" y2="246" /></g>
            <g stroke="#2E2A27" stroke-width="2">{[0,1,2,3,4].map((i) => <line x1={40 + i * 68} y1="240" x2={40 + i * 68} y2="252" />)}<line x1="380" y1="240" x2="380" y2="252" /></g>
            <g stroke="#C9A227" stroke-width="10" stroke-dasharray="14 5"><line x1="40" y1="46" x2="40" y2="246" /><line x1="380" y1="46" x2="380" y2="246" /></g>
            <rect x="34" y="240" width="12" height="12" fill="#2E2A27" /><rect x="374" y="240" width="12" height="12" fill="#2E2A27" />
            <text x="210" y="276" text-anchor="middle" class="pl-lbl">Long front: fixed polycarbonate (Clearfixed)</text>
            <text x="56" y="150" class="pl-lbl" transform="rotate(-90 56 150)" text-anchor="middle">Hybrid: folds open</text>
            <text x="364" y="150" class="pl-lbl" transform="rotate(90 364 150)" text-anchor="middle">Hybrid: folds open</text>
            <text x="210" y="150" text-anchor="middle" class="pl-mid">Covered patio</text>
          </svg>
          <figcaption class="fine">Representative layout, not to scale. Every patio is designed to its own openings.</figcaption>
        </figure>
      </div>

      <p class="cmp-teaser">Weighing glass panels, fabric screens or motorized shades? <a href="/compare/#retrofit">See how they compare</a>, fairly, side by side.</p>
      <details class="tested">
        <summary>Tested details</summary>
        <ul>
          <li>Smokey Gray polycarbonate panel: {FACTS.vlt} visible light transmission and {FACTS.shgc} solar heat gain coefficient. This is a test of the panel, not a rating of an installed room.</li>
          <li>Wind: {FACTS.windNote}. Fold away folding systems before storms. Not a hurricane rating.</li>
        </ul>
        <p><a href="/learn/#performance">Specs and care</a></p>
      </details>
    </div>
  </section>

  <!-- 4. Why AE -->
  <section class="band on-white hive-light" aria-labelledby="why-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker dark"><span class="hexdot" aria-hidden="true"></span>Why homeowners choose AE</p>
        <h2 id="why-title" class="h2">Prepared in our factory, so it fits on install day</h2>
        <p class="lede">Your enclosure is cut, assembled and checked in our factory on William Tell Street before it reaches your home. <a href="/how-we-build/">Tour the factory</a></p>
      </div>
      <ol class="why-grid">
        {why.map((w) => <li><h3>{w.f}</h3><p>{w.b}</p></li>)}
      </ol>
      <div class="build-photos" tabindex="0" role="region" aria-label="Factory photos">
        {factoryPics.map((s) => (
          <figure><Image src={s.img} alt={s.alt} widths={[360, 640]} sizes="(max-width: 640px) 100vw, 360px" loading="lazy" /><figcaption>{s.t}</figcaption></figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Real installations -->
  <section class="band" aria-labelledby="mosaic-title">
    <div class="wrap">
      <div class="row-head">
        <div class="stack">
          <p class="kicker"><span class="hexdot" aria-hidden="true"></span>Real Houston backyards</p>
          <h2 id="mosaic-title" class="h2">Installed by our own crew</h2>
        </div>
        <a class="btn btn-line" href="/projects/">See all projects</a>
      </div>
      <ProjectMosaic />
      <p class="fine" style="margin-top:12px">Every photo here is a finished AE job. Most use our metal screen systems; the Sugar Land job adds polycarbonate Hybrid doors.</p>
      {REVIEWS.length > 0 && <div id="reviews" style="margin-top:40px;scroll-margin-top:90px"><ReviewCards /></div>}
    </div>
  </section>

  <!-- 6. Pricing and financing -->
  <section class="band on-paper" id="prices" aria-labelledby="price-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker dark"><span class="hexdot" aria-hidden="true"></span>Pricing and financing</p>
        <h2 id="price-title" class="h2">What will my patio cost?</h2>
        <p class="lede">We price the <strong>opening area we fill</strong>: width times height of each open side. Not your patio floor. Pick a size and a system for a typical starting range.</p>
      </div>
      <div class="picker" id="picker" data-json={pickerData}>
        <div class="picker-opts">
          <fieldset>
            <legend>Your patio</legend>
            {SIZES.map((s, i) => (
              <label class="opt"><input type="radio" name="size" value={s.id} checked={i === 1} /><span><b>{s.name}</b> <small>{s.eg}</small><em>{s.low} to {s.high} sq ft of openings</em></span></label>
            ))}
          </fieldset>
          <fieldset>
            <legend>System</legend>
            {order.map((id) => { const p = byId(id); return (
              <label class="opt"><input type="radio" name="sys" value={p.id} checked={p.id === defSys.id} /><span><b>{p.name}</b> <small><span class="k">{p.kind} · </span>${p.msrp} per sq ft of opening</small></span></label>
            ); })}
          </fieldset>
        </div>
        <div class="estimate" aria-live="polite">
          <p class="est-label" id="est-label">{defSys.name}, medium patio</p>
          <p class="est-range tnum" id="est-range">{range(defSys.msrp, 200, 300)}</p>
          <p id="est-note" class="muted">200 to 300 sq ft of openings at ${defSys.msrp} {TAX}.</p>
          <p class="unit">Prices are {TAX}.</p>
          <p class="fine">{EXTRAS}</p>
          <p class="fine">{LENDERS}</p>
          <div class="actions"><a class="btn" href="/free-quote/">Get my estimate now</a><a class="btn btn-line" href="/book-visit/">Book free design visit</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Process -->
  <section class="band" aria-labelledby="process-title">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker"><span class="hexdot" aria-hidden="true"></span>From measurement to installation</p>
        <h2 id="process-title" class="h2">How your project runs</h2>
        <p class="lede">We install within a month of your order (after HOA approval, if your HOA needs it). Once we arrive, most jobs take one day on site.</p>
      </div>
      <ol class="proc">{process.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>
    </div>
  </section>

  <QuickContact />

  <!-- 8. Showroom, warranty, aftercare -->
  <section class="band on-white" aria-labelledby="show-title">
    <div class="wrap split">
      <figure class="show-photo"><Image src={showroomIn} widths={[480, 900]} sizes="(max-width: 820px) 100vw, 560px" alt="Inside the AE showroom: a room combining polycarbonate panels and metal mesh" loading="lazy" /></figure>
      <div class="stack-lg">
        <p class="kicker dark"><span class="hexdot" aria-hidden="true"></span>Local showroom and support</p>
        <h2 id="show-title" class="h2">See every system in person</h2>
        <p class="lede">Our showroom is at {SITE.street}, {SITE.city}, {SITE.region} {SITE.zip}, next to the factory. Open 9 am to 5 pm, 7 days a week, by appointment. Customer parking on site.</p>
        <ul class="support">
          <li><b>Warranty</b><span>{WARRANTY}, for the original owner while they own the home. Ask for the written terms at your visit.</span></li>
          <li><b>Aftercare</b><span>AE Factory Sales coordinates customer assistance and aftercare through the Houston factory.</span></li>
          <li><b>HOA</b><span>We provide drawings and specifications when your HOA needs them. Approval is up to your HOA.</span></li>
        </ul>
        <div class="actions"><a class="btn" href={SITE.phoneHref}>Call to arrange a showroom visit</a><a class="btn btn-line" href="/showroom/">Address and directions</a></div>
      </div>
    </div>
  </section>

  <!-- 9. FAQ and visit invitation -->
  <section class="band hive-dark" id="book" aria-labelledby="book-title">
    <div class="wrap book-grid">
      <div class="stack-lg">
        <h2 id="book-title" class="h2">Questions before your visit</h2>
        <Faq items={visitFaq} />
      </div>
      <div class="book-card">
        <p class="book-k">Book your free design visit</p>
        <p class="lede">Tell us who you are and where the patio is. We call to set a time, measure every opening, design the layout with you and give you a written quote.</p>
        <a class="btn btn-big" href="/book-visit/">Book free design visit</a>
        <p class="micro">Want a ballpark first? <a href="/free-quote/">Get my estimate now</a>. Rather talk? Call <a href={SITE.phoneHref}>{SITE.phone}</a>, 9 am to 5 pm, 7 days a week.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .viz-band { border-block: 1px solid rgba(242, 194, 48, .35); }
