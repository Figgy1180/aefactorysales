    -webkit-mask-image: radial-gradient(ellipse 40% 70% at 100% 0%, #000 0%, transparent 70%); mask-image: radial-gradient(ellipse 40% 70% at 100% 0%, #000 0%, transparent 70%); }
  .build { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 24px; counter-reset: b; }
