---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CornerArt from '../components/CornerArt.astro';
import ProductCard from '../components/ProductCard.astro';
import CompareBars from '../components/CompareBars.astro';
import Why from '../components/Why.astro';
import Faq from '../components/Faq.astro';
import RevealSlider from '../components/RevealSlider.astro';
import ProjectMosaic from '../components/ProjectMosaic.astro';
import heroClosed from '../assets/projects/p35/3-inside-closed.jpg';
import heroOpen from '../assets/projects/p35/4-inside-open.jpg';
import { PRODUCTS, SIZES, FAQ, FACTS, CITIES, SITE, byId, range, FINANCING } from '../data/site';

import open from '../assets/photos/hexfold-patio-open.jpg';
import clearfixed from '../assets/photos/clearfixed-polycarbonate-panels.jpg';
import showroom from '../assets/photos/showroom-room-interior.jpg';
import handle from '../assets/photos/hexfold-patio-closed.jpg';
import fixedColors from '../assets/photos/fixed-screen-frame-colors.jpg';
import showroomSmoke from '../assets/photos/showroom-polycarbonate-smoke.jpg';
import cnc from '../assets/photos/factory-cnc.jpg';
import angle from '../assets/photos/factory-angle.jpg';
import pcRack from '../assets/photos/factory-pc-smoke.jpg';
import packed from '../assets/photos/factory-packed.jpg';

const cardImg: Record<string, { img: any; alt: string; note?: string }> = {
  clearfixed: { img: clearfixed, alt: 'Clearfixed tinted polycarbonate panels on an A&E patio enclosure' },
  clearfold: { img: showroomSmoke, alt: 'Folding polycarbonate panels in the A&E showroom' },
  hexfold: { img: handle, alt: 'Brick Houston patio closed in with Hexfold folding screens' },
  fixed: { img: fixedColors, alt: 'Two Fixed Screen panels with 304 stainless steel mesh in Night Gray and Bright White frames' },
  hybrid: { img: showroom, alt: 'A&E showroom room combining polycarbonate panels and metal mesh' },
};
const order = ['clearfixed', 'clearfold', 'hybrid', 'hexfold', 'fixed'];
const homeFaq = [FAQ.cost[0], FAQ.room[0], FAQ.screens[0], FAQ.screens[1], FAQ.general[0], FAQ.general[1], FAQ.general[2], FAQ.cost[3]];
const pickerData = JSON.stringify({ products: PRODUCTS.map(({ id, name, msrp }) => ({ id, name, msrp })), sizes: SIZES });
const hex = byId('hexfold');
const cf = byId('clearfixed');
const ytId = (SITE.youtubeFold.match(/(?:shorts\/|v=|youtu\.be\/)([\w-]{11})/) || [])[1];
const videoLd = {
  '@context': 'https://schema.org', '@type': 'VideoObject',
  name: 'Hexfold folding patio screens opening by hand',
  description: 'A&E Hexfold aluminum mesh screens folding open by hand on a gabled Houston patio. No motor, no remote.',
  thumbnailUrl: `${SITE.url}/video/gable-open-poster.jpg`,
  uploadDate: '2026-11-05', duration: 'PT15S',
  contentUrl: `${SITE.url}/video/gable-open.mp4`,
  ...(ytId ? { embedUrl: `https://www.youtube.com/embed/${ytId}`, url: SITE.youtubeFold } : {}),
};
---
<Base
  title="Patio Enclosures & 3-Season Rooms Houston | A&E Factory Sales"
  description="Polycarbonate 3-season rooms and metal patio screens built in our Houston factory, installed by our crew within a month. See prices, book a free site visit."
  schema={[videoLd]}
>
  <section class="hero blueprint" aria-labelledby="hero-title">
    <CornerArt />
    <div class="wrap hero-grid">
      <div class="h-title">
        <h1 id="hero-title" class="display">Take back your patio. <span class="y">Built here, installed by us.</span></h1>
      </div>
      <div class="h-body stack-lg">
        <p class="sub">Polycarbonate 3-season rooms and premium metal screens for existing roofed patios. CNC-cut in our Houston factory, tested fully assembled, installed by our own crew.</p>
        <div class="actions">
          <a class="btn" href="/free-quote/">Get my price in 4 steps</a>
          <a class="btn btn-line" href={SITE.phoneHref}>{SITE.phone}</a>
        </div>
        <dl class="proof">
          <div><dt>1 month</dt><dd>or less, order to install</dd></div>
          <div><dt>Lifetime</dt><dd>frame warranty, 3 years on parts</dd></div>
          <div><dt>From $24</dt><dd>per sq ft of opening, installed</dd></div>
        </dl>
      </div>
      <div class="hero-media">
        <div class="hero-frame draw">
          <span class="dim h" aria-hidden="true"><span>About 20 ft wide, Houston, TX</span></span>
          <RevealSlider closed={heroClosed} open={heroOpen} alt="Houston covered patio enclosed with A&E aluminum folding screens" eager id="hero-reveal" label="See this project" href="/projects/houston-20-ft-patio-enclosure/" />
        </div>
        <p class="hint"><span aria-hidden="true">&#8596;</span> Drag to open the screens. Same patio, same spot.</p>
      </div>
    </div>
  </section>

  <section class="trust" aria-label="Why A&E">
    <div class="wrap trust-row">
      <div><svg viewBox="0 0 28 28" aria-hidden="true"><path d="M3 25V12l7 4V12l7 4V6h8v19z"/><path d="M19 10h2M19 14h2M19 18h2"/></svg><b>Made in our Houston factory</b></div>
      <div><svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="10" cy="8" r="4"/><path d="M3 24c0-4 3-7 7-7s7 3 7 7"/><path d="M18 12l3 3 5-6"/></svg><b>Installed by our own crew</b></div>
      <div><svg viewBox="0 0 28 28" aria-hidden="true"><rect x="3" y="5" width="22" height="20" rx="1.5"/><path d="M3 11h22M9 2v6M19 2v6M8 16h4M8 20h8"/></svg><b>Within a month of your order</b></div>
      <div><svg viewBox="0 0 28 28" aria-hidden="true"><path d="M14 3l9 4v7c0 6-4 9-9 11-5-2-9-5-9-11V7z"/><path d="M10 14l3 3 5-6"/></svg><b>Lifetime frame warranty</b></div>
    </div>
  </section>

  <section class="band" aria-labelledby="mosaic-title">
    <div class="wrap">
      <div class="row-head">
        <h2 id="mosaic-title" class="h2">Real Houston <span class="y">backyards</span></h2>
        <a class="btn btn-line" href="/projects/">See all projects</a>
      </div>
      <ProjectMosaic />
    </div>
  </section>

  <section class="band" aria-labelledby="paths-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="paths-title" class="h2">Two ways to use <span class="y">your patio</span></h2>
        <p class="lede">Enclose it for shade and shelter, or keep the breeze and lose the bugs. Most patios mix both, opening by opening.</p>
      </div>
      <div class="paths">
        <article class="path">
          <figure class="two-up"><Image src={clearfixed} alt="A&E 3-season room wall with factory-tinted polycarbonate panels and a folding screen" widths={[300, 600]} sizes="(max-width: 820px) 50vw, 280px" loading="lazy" style="object-position:50% 30%" /><Image src={showroomSmoke} alt="Inside the A&E showroom room with tinted panels behind folding screens" widths={[480, 800]} sizes="(max-width: 820px) 50vw, 280px" loading="lazy" style="object-position:100% 50%" /></figure>
          <div class="path-body">
            <h3 class="h3">Enclose it</h3>
            <p>A polycarbonate 3-season room. Tinted panels block wind and rain and cut glare, with screen doors and doors that open on both sides for airflow. A fraction of a glass sunroom.</p>
            <ul class="ticks">
              <li>Flexes instead of shattering</li>
              <li>Midnight Smoke or Storm Blue tint</li>
              <li>Fixed panels rated to 100 mph</li>
            </ul>
            <div class="price-line"><b>From ${cf.msrp}</b><span>per sq ft installed</span></div>
            <a class="btn" href="/three-season-rooms/">Compare it to glass</a>
          </div>
        </article>
        <article class="path">
          <Image src={open} alt="Hexfold screens folded to the side of a brick patio" widths={[480, 800]} sizes="(max-width: 820px) 100vw, 560px" loading="lazy" />
          <div class="path-body">
            <h3 class="h3">Keep it open-air</h3>
            <p>Hexfold folding walls of honeycomb aluminum mesh glide out of the way for the view and close in seconds when the mosquitoes show up. Or go with Fixed Screen in 304 stainless steel.</p>
            <ul class="ticks">
              <li>Keeps out mosquitoes, mice and snakes</li>
              <li>Opens by hand, no motor to fail</li>
              <li>Up to 20 ft wide meeting in the middle</li>
            </ul>
            <div class="price-line"><b>From $24</b><span>per sq ft installed</span></div>
            <a class="btn btn-line" href="/hexfold/">See Hexfold</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band raised fold-band" aria-labelledby="fold-title">
    <div class="wrap fold-grid">
      <figure class="fold-video dim-frame">
        <video width="540" height="960" data-src="/video/gable-open.mp4" poster="/video/gable-open-poster.jpg" muted loop playsinline preload="none" aria-label="Hexfold screens being folded open by hand on a gabled patio"></video>
        {SITE.youtubeFold && <figcaption><a class="yt" href={SITE.youtubeFold} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1c.4-1.6.5-4.8.5-4.8s0-3.2-.5-4.8zM9.7 15.1V8.9l5.8 3.1z"/></svg>Watch on YouTube</a></figcaption>}
      </figure>
      <div class="stack-lg">
        <h2 id="fold-title" class="h2">Watch it <span class="y">fold away</span></h2>
        <p class="lede">Hexfold panels hang from the top track and glide aside by hand. No motor, no remote, nothing dragging on the ground. Close them in seconds when the mosquitoes come out.</p>
        <dl class="fold-facts">
          <div><dt>20 ft</dt><dd>wide, meeting in the middle</dd></div>
          <div><dt>10 ft</dt><dd>tall per panel</dd></div>
          <div><dt>$28</dt><dd>per sq ft, installed</dd></div>
        </dl>
        <div class="actions"><a class="btn" href="/hexfold/">See Hexfold</a><a class="btn btn-line" href="/free-quote/">Price my patio</a></div>
      </div>
    </div>
  </section>

  <section class="band on-paper" id="prices" aria-labelledby="price-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="price-title" class="h2">What will my <span class="y">patio cost?</span></h2>
        <p class="lede">Pick a patio and a system to see a typical installed range. We price the open wall area we fill, not your floor. Your exact number comes from a free site visit.</p>
      </div>
      <div class="picker" id="picker" data-json={pickerData}>
        <div class="picker-opts">
          <fieldset>
            <legend>Your patio</legend>
            {SIZES.map((s, i) => (
              <label class="opt"><input type="radio" name="size" value={s.id} checked={i === 1} /><span><b>{s.name}</b> <small>{s.eg}</small><em>{s.low} to {s.high} sq ft of openings</em></span></label>
            ))}
          </fieldset>
          <fieldset>
            <legend>System</legend>
            {order.map((id) => { const p = byId(id); return (
              <label class="opt"><input type="radio" name="sys" value={p.id} checked={p.id === 'hexfold'} /><span><b>{p.name}</b> <small>{p.kind} · ${p.msrp}/sq ft</small></span></label>
            ); })}
          </fieldset>
        </div>
        <div class="estimate" aria-live="polite">
          <p class="est-label" id="est-label">Hexfold, medium patio</p>
          <p class="est-range tnum" id="est-range">{range(hex.msrp, 200, 300)}</p>
          <p id="est-note" class="muted">200 to 300 sq ft of openings at ${hex.msrp} per sq ft, installed.</p>
          <ul class="ticks">
            <li>Design and free site visit</li>
            <li>CNC fabrication and testing in Houston</li>
            <li>Installed by our own crew within a month</li>
            <li>Lifetime frame warranty, 3 years on parts</li>
          </ul>
          <p class="fine">Arches, extra posts and locks add to the price. {FINANCING}</p>
          <a class="btn" href="/free-quote/">Book my free site visit</a>
        </div>
      </div>
      <div class="band-tight" style="padding-bottom:0"><CompareBars /></div>
    </div>
  </section>

  <section class="band" id="systems" aria-labelledby="sys-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="sys-title" class="h2">Five systems, <span class="y">one factory</span></h2>
        <p class="lede">Every system rides on our own track, is built and tested at our factory, and is installed by our crew. Mix fixed and folding, mesh and polycarbonate, around the patio you already have.</p>
      </div>
      <div class="family">
        <h3 class="fam-h">Polycarbonate 3-season rooms <span>Shade and shelter</span></h3>
        <div class="lineup">
          {['clearfixed', 'clearfold', 'hybrid'].map((id) => <ProductCard p={byId(id)} img={cardImg[id].img} alt={cardImg[id].alt} note={cardImg[id].note} />)}
        </div>
      </div>
      <div class="family">
        <h3 class="fam-h">Premium metal screens <span>Breeze without bugs</span></h3>
        <div class="lineup two">
          {['hexfold', 'fixed'].map((id) => <ProductCard p={byId(id)} img={cardImg[id].img} alt={cardImg[id].alt} note={cardImg[id].note} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="band raised" aria-labelledby="why-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="why-title" class="h2">Peace of mind <span class="y">for decades</span></h2>
        <p class="lede">Three decades working with glass and door manufacturers taught us what lasts. Now we build our own, here in Houston. <a href="/why-ae/">Why buying from the maker matters</a> · <a href="/compare/">How we compare</a></p>
      </div>
      <Why />
      <div class="split facts-split">
        <div>
          <span class="facts-label">The facts</span>
          <table class="facts">
            <caption>Hexfold &amp; Fixed Screen</caption>
            <tbody>
              <tr><th scope="row">Mesh</th><td>Hexfold: honeycomb aluminum. Fixed Screen: 304 stainless steel.</td></tr>
              <tr><th scope="row">Mesh density</th><td>{FACTS.mesh} (Hexfold)</td></tr>
              <tr><th scope="row">Wind</th><td>Hexfold operates in winds up to {FACTS.foldWind}. Retract and secure for {FACTS.foldStowed}.</td></tr>
            </tbody>
          </table>
        </div>
        <div>
          <table class="facts" style="margin-top:52px">
            <caption>Polycarbonate panels</caption>
            <tbody>
              <tr><th scope="row">Visible light</th><td>{FACTS.vlt} transmission*</td></tr>
              <tr><th scope="row">Solar heat gain</th><td>{FACTS.shgc} SHGC*</td></tr>
              <tr><th scope="row">Wind</th><td>Fixed panels rated to {FACTS.fixedWind}</td></tr>
              <tr><th scope="row">Frames</th><td>Heat welded, no screws. Aluminum core, ceramic coating. Night Gray or Bright White.</td></tr>
              <tr><th scope="row">Every job</th><td>Installed within a month. Lifetime frame warranty, 3 years on parts.</td></tr>
            </tbody>
          </table>
          <p class="fine" style="margin-top:10px">*Tested on Midnight Smoke panels.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="how-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="how-title" class="h2">From tape measure <span class="y">to last screw</span></h2>
      </div>
      <ol class="steps">
        <li><h3>Free site visit</h3><p>We measure every opening and walk you through options and samples, usually in about 45 minutes.</p></li>
        <li><h3>Built in our factory</h3><p>CNC saws cut every piece to your measurements. Frames are heat welded at about 350°C, not screwed together.</p></li>
        <li><h3>Tested before it ships</h3><p>Your whole job is assembled in our staging area and checked, then every piece is labeled, numbered and packed.</p></li>
        <li><h3>Installed by our crew</h3><p>Our own installers, never subcontractors, within a month of your order.</p></li>
      </ol>
      <div class="factory-strip">
        <figure><Image src={cnc} alt="CNC dual-head saw in the A&E factory" widths={[320, 600]} sizes="(max-width: 640px) 50vw, 280px" loading="lazy" /><figcaption>CNC saws cut to fractions of a millimeter.</figcaption></figure>
        <figure><Image src={angle} alt="Angle saw cutting architectural shapes" widths={[320, 600]} sizes="(max-width: 640px) 50vw, 280px" loading="lazy" /><figcaption>Arches and angles on a dedicated saw.</figcaption></figure>
        <figure><Image src={pcRack} alt="Tinted polycarbonate panels on a factory rack" widths={[320, 600]} sizes="(max-width: 640px) 50vw, 280px" loading="lazy" /><figcaption>Polycarbonate cut in our panel room. Tint shown digitally.</figcaption></figure>
        <figure><Image src={packed} alt="A finished order wrapped and labeled for delivery" widths={[320, 600]} sizes="(max-width: 640px) 50vw, 280px" loading="lazy" /><figcaption>Every piece labeled, numbered and wrapped.</figcaption></figure>
      </div>
      <p style="margin-top:22px"><a href="/how-we-build/">Take the factory tour</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="faq-title">
    <div class="wrap split" style="align-items:start">
      <div class="stack-lg">
        <h2 id="faq-title" class="h2">Questions <span class="y">we hear</span></h2>
        <p class="lede">Straight answers. More on the <a href="/faq/">full FAQ</a>.</p>
        <div class="stack">
          <h3 class="h3">Serving greater Houston</h3>
          <p class="muted">Visit the showroom at {SITE.streetShort}, Houston, TX {SITE.zip}, or book a free site visit at your home.</p>
          <ul class="cities">{CITIES.slice(0, 15).map((c) => <li>{c}</li>)}</ul>
          <a href="/service-area/">See our service area</a>
        </div>
      </div>
      <Faq items={homeFaq} />
    </div>
  </section>
</Base>

<style>
  .hero { overflow: hidden; }
  .hero-grid { display: grid; grid-template-areas: 'title media' 'body media'; grid-template-rows: auto 1fr; row-gap: 26px; grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr); gap: clamp(32px, 5vw, 56px); align-items: center; padding-block: clamp(48px, 7vw, 80px) clamp(56px, 8vw, 88px); }
  .proof { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 6px 0 0; max-width: 580px; }
  .proof div { border-left: 2px solid var(--yellow); padding-left: 10px; }
  .proof dt { font-weight: 800; font-stretch: 75%; font-size: 1.65rem; line-height: 1; }
  .proof dd { margin: 5px 0 0; font-size: 0.9rem; line-height: 1.3; color: var(--ink-2); }
  .h-title { grid-area: title; align-self: end; }
  .h-title .display { font-size: clamp(2.9rem, 5.6vw, 5.2rem); }
  .h-body { grid-area: body; align-content: start; }
  .hero-media { grid-area: media; align-self: center; display: grid; gap: 12px; padding-top: 30px; min-width: 0; }
  .hero-frame { position: relative; }
  .hero-frame .dim.h span { background: var(--honey); }
  .hint { font-family: var(--mono); font-size: 0.8rem; font-weight: 600; color: var(--ink-2); }
  .hint span { color: var(--yellow); font-size: 1.1rem; margin-right: 6px; }
  .trust { background: var(--yellow); color: var(--honey); }
  .trust-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; }
  .trust-row > div { display: flex; align-items: center; gap: 14px; padding-block: 26px; padding-inline: 18px; min-width: 0; }
  .trust-row > div + div { border-left: 2px solid rgba(46, 33, 24, 0.25); }
  .trust-row > div:first-child { padding-left: 0; }
  .trust svg { width: 38px; height: 38px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .trust b { font-weight: 800; font-stretch: 74%; font-size: clamp(1.1rem, 1.7vw, 1.5rem); line-height: 1.05; text-transform: uppercase; }
  .fold-grid { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .fold-video { margin: 0; justify-self: center; width: 100%; max-width: 270px; }
  .fold-video figcaption { padding-top: 12px; text-align: center; }
  .yt { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--ink); text-decoration: underline; text-decoration-color: var(--yellow); text-underline-offset: 3px; }
  .yt svg { width: 22px; height: 22px; fill: #FF0000; }
  .fold-video video { aspect-ratio: 9 / 16; width: 100%; object-fit: cover; }
  .fold-facts { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; max-width: 520px; }
  .fold-facts div { border-left: 2px solid var(--yellow); padding-left: 10px; }
  .fold-facts dt { font-weight: 800; font-stretch: 72%; font-size: 2.4rem; line-height: 1; color: var(--yellow); }
  .fold-facts dd { margin: 4px 0 0; font-size: 0.9rem; color: var(--ink-2); }
  @media (max-width: 760px) { .fold-grid { grid-template-columns: minmax(0, 1fr); } .fold-video { max-width: 240px; } }
  .row-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: clamp(24px, 3vw, 36px); }
  @media (max-width: 900px) { .trust-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } .trust-row > div:nth-child(3) { border-left: 0; padding-left: 0; } .trust-row > div:nth-child(n+3) { border-top: 2px solid rgba(46, 33, 24, 0.25); } }
  @media (max-width: 480px) { .trust-row > div { padding-inline: 10px; gap: 10px; } .trust svg { width: 30px; height: 30px; } }
  .paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px; }
  .path { background: var(--honey-2); border-top: 4px solid var(--yellow); display: flex; flex-direction: column; min-width: 0; }
  .path img { aspect-ratio: 16 / 10; width: 100%; object-fit: cover; }
  .two-up { margin: 0; position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr); gap: 4px; background: var(--honey); aspect-ratio: 16 / 10; overflow: hidden; }
  .two-up .tag { left: auto; right: 10px; }
  .two-up img { aspect-ratio: auto; height: 100%; min-width: 0; }
  .path-body { padding: 24px 26px 28px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .path-body .btn { align-self: flex-start; }
  .path-body p { color: var(--ink-2); }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ticks li { position: relative; padding-left: 28px; }
  .ticks li::before { content: ""; position: absolute; left: 2px; top: 0.35em; width: 14px; height: 8px; border-left: 2.5px solid var(--yellow); border-bottom: 2.5px solid var(--yellow); transform: rotate(-45deg); }
  .on-paper .ticks li::before { border-color: var(--paper-ink); }
  .picker { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(24px, 4vw, 44px); align-items: start; }
  .picker-opts { display: grid; gap: 22px; }
  .picker fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .picker legend { font-weight: 800; font-stretch: 78%; font-size: 1.25rem; text-transform: uppercase; margin-bottom: 8px; }
  .opt { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border: 2px solid var(--paper-line); cursor: pointer; }
