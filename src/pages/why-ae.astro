---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Why from '../components/Why.astro';
import Faq from '../components/Faq.astro';
import { SITE, WARRANTY_FULL, FAQ, type QA } from '../data/site';
import cnc from '../assets/photos/factory-cnc.jpg';
import packed from '../assets/projects/p34/1-corner-closed.jpg';
import wide from '../assets/projects/p35/1-wide.jpg';

const crumbs = [{ name: 'Why AE', href: '/why-ae/' }];
const ask: QA[] = [
  { q: 'Who makes the product, and where?', a: 'AE: in our own Houston factory, next door to the showroom at 2609 William Tell Street. You can visit both.' },
  { q: 'Who installs it?', a: 'Our own crew. We do not subcontract installs.' },
  { q: 'Who do I call if something goes wrong in year five?', a: `The same people: ${SITE.phone}. We made it and we installed it, so the warranty is ours to honor.` },
  { q: 'Can you match a replacement part years from now?', a: 'Yes. Over 30 manufacturers make parts specifically for AE, and we know the maker of every one.' },
  { q: 'How long from order to install?', a: 'Within a month of your order. Every piece is CNC-cut and test-assembled first, so install day goes fast.' },
  { q: 'Is the price all-in?', a: 'Yes. Design, the site visit, fabrication, installation, parts and the warranty are in one number. Options like locks or arches are listed line by line.' },
];
const warrantyFaq: QA[] = [
  { q: 'What does the warranty cover?', a: WARRANTY_FULL },
  { q: 'How do I make a warranty request?', a: `Call or text ${SITE.phone}, or email ${SITE.email}, with a photo of the issue. We schedule a visit with our own crew.` },
  { q: 'Is the warranty from a third party?', a: 'No. AE manufactures, installs and maintains the system, so the warranty comes straight from us.' },
];
const ld = {
  '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Why AE Factory Sales',
  about: { '@id': `${SITE.url}/#business` },
  description: 'AE Factory Sales is a Houston manufacturer and installer of patio enclosures and screens, backed by a lifetime frame warranty.',
};
---
<Base
  title="Why AE: Houston Manufacturer & Installer | AE"
  description="Made in our Houston factory, installed by our own crew, warrantied by us. One company from tape measure to last screw, with a lifetime frame warranty."
  crumbs={crumbs}
  schema={[ld]}
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <h1 class="display">One company, <span class="y">start to finish</span></h1>
        <p class="sub">We make it in Houston, our own crew installs it, and we stand behind it for the life of the frame. No distributor, no subcontractor, no out-of-state call center.</p>
        <div class="actions"><a class="btn" href="/free-quote/">Book a free site visit</a><a class="btn btn-line" href="/compare/">Compare your options</a></div>
      </div>
      <figure class="dim-frame draw" style="margin:30px 0 0">
        <span class="dim h" aria-hidden="true"><span>Built in Houston</span></span>
        <Image src={cnc} alt="CNC dual-head saw cutting frame profiles in the AE factory in Houston" widths={[480, 900]} sizes="(max-width: 820px) 100vw, 540px" loading="eager" style="aspect-ratio:16/10;object-fit:cover" />
      </figure>
    </div>
  </PageHero>

  <section class="band on-paper" aria-labelledby="chain-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="chain-title" class="h2">Fewer hands <span class="y">on your project</span></h2>
        <p class="lede">Patio enclosures are often designed by one company, sold by another and installed by a third. Every handoff adds cost and time, and makes it harder to know who fixes what later.</p>
      </div>
      <div class="chain" role="img" aria-label="Typical path: brand, distributor, local dealer, subcontracted installer, then you. AE path: our Houston factory, our own crew, then you.">
        <div class="lane">
          <p class="lane-k">A common path</p>
          <ol>
            <li>Brand, often out of state</li><li>Distributor</li><li>Local dealer</li><li>Subcontracted installer</li><li class="you">You</li>
          </ol>
        </div>
        <div class="lane ours">
          <p class="lane-k">The AE path</p>
          <ol>
            <li>Our factory, Houston</li><li>Our own crew</li><li class="you">You</li>
          </ol>
        </div>
      </div>
      <div class="gets">
        <div><h3>One phone number</h3><p>Sales, scheduling, install and warranty all go through {SITE.phone}.</p></div>
        <div><h3>Factory pricing</h3><p>No distributor or dealer markup between our factory and your patio.</p></div>
        <div><h3>Faster</h3><p>Installed within a month of your order, because we control the schedule from cutting to install.</p></div>
        <div><h3>Accountable</h3><p>The people who built it are the people who come back if it ever needs attention.</p></div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="local-title">
    <div class="wrap split">
      <div class="stack-lg">
        <h2 id="local-title" class="h2">Houston made, <span class="y">Houston tested</span></h2>
        <p class="lede">Our systems are in their fourth generation, refined over four years on Houston patios through heat, humidity, storms and mosquito season. Three decades of working with glass and door manufacturers taught us what lasts before we built our own.</p>
        <table class="facts">
          <caption>Where to find us</caption>
          <tbody>
            <tr><th scope="row">Showroom and sales</th><td>{SITE.street}, Houston, TX {SITE.zip}</td></tr>
            <tr><th scope="row">Factory</th><td>Next door to the showroom</td></tr>
            <tr><th scope="row">Hours</th><td>{SITE.hours}</td></tr>
            <tr><th scope="row">Phone</th><td><a href={SITE.phoneHref}>{SITE.phone}</a></td></tr>
            <tr><th scope="row">In business since</th><td>{SITE.founded}</td></tr>
          </tbody>
        </table>
      </div>
      <figure style="margin:0"><Image src={packed} alt="Freestanding AE patio enclosure built and installed in Houston" widths={[480, 900]} sizes="(max-width: 820px) 100vw, 540px" loading="lazy" style="aspect-ratio:4/3;object-fit:cover;border:2px solid var(--yellow)" /><figcaption class="fine" style="padding-top:8px">A freestanding enclosure we built and installed in Houston. <a href="/projects/houston-freestanding-patio-enclosure/">See the project</a></figcaption></figure>
    </div>
  </section>

  <section class="band raised" aria-labelledby="peace-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="peace-title" class="h2">What you get <span class="y">from the source</span></h2>
      </div>
      <Why />
      <p><a href="/how-we-build/">See how we build it, station by station</a></p>
    </div>
  </section>

  <section class="band on-paper" id="warranty" aria-labelledby="warranty-title">
    <div class="wrap split" style="align-items:start">
      <div class="stack-lg">
        <h2 id="warranty-title" class="h2">A warranty <span class="y">from the maker</span></h2>
        <div class="warranty-card">
          <p class="w-big">Lifetime</p><p class="w-sub">on the frame</p>
          <p class="w-big">3 years</p><p class="w-sub">on all parts</p>
          <p class="fine">Installed and maintained by the manufacturer. Covers normal wear and tear. Excludes accidents, intentional damage and acts of God.</p>
        </div>
      </div>
      <Faq items={warrantyFaq} />
    </div>
  </section>

  <section class="band" aria-labelledby="ask-title">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 id="ask-title" class="h2">Ask any installer <span class="y">these six questions</span></h2>
        <p class="lede">Whoever you hire, these answers tell you who is really building and backing your enclosure. Here are ours.</p>
      </div>
      <Faq items={ask} schema={false} />
    </div>
  </section>

  <section class="band raised">
    <div class="wrap split">
      <figure style="margin:0"><Image src={wide} alt="Houston covered patio with AE folding screens on two open sides" widths={[480, 900]} sizes="(max-width: 820px) 100vw, 540px" loading="lazy" style="aspect-ratio:4/3;object-fit:cover;border:2px solid var(--yellow)" /></figure>
      <div class="stack">
        <h2 class="h2">See it, <span class="y">then decide</span></h2>
        <p class="lede">Book a free site visit, or come see every system working in our showroom.</p>
        <div class="actions"><a class="btn" href="/free-quote/">Book a site visit</a><a class="btn btn-line" href="/projects/">See finished projects</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .chain { display: grid; gap: 18px; }
  .lane { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 16px; align-items: center; }
  .lane-k { font-weight: 800; font-stretch: 80%; text-transform: uppercase; font-size: 1.05rem; }
  .lane ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 0; align-items: center; }
  .lane li { position: relative; padding: 12px 16px; background: var(--cream-2); border: 2px solid var(--paper-line); font-weight: 600; margin-right: 34px; }
  .lane li:not(:last-child)::after { content: ""; position: absolute; right: -28px; top: 50%; width: 20px; height: 2px; background: var(--paper-2); }
  .lane li:not(:last-child)::before { content: ""; position: absolute; right: -29px; top: 50%; width: 8px; height: 8px; border-top: 2px solid var(--paper-2); border-right: 2px solid var(--paper-2); transform: translateY(-50%) rotate(45deg); }
  .lane li.you { background: var(--paper-ink); color: var(--cream); border-color: var(--paper-ink); }
  .lane.ours li { background: var(--yellow); border-color: var(--paper-ink); }
  .lane.ours li.you { background: var(--paper-ink); }
  .lane.ours li:not(:last-child)::after { background: var(--paper-ink); }
  .lane.ours li:not(:last-child)::before { border-color: var(--paper-ink); }
  .gets { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .gets > div { border-top: 2px solid var(--paper-ink); padding-top: 14px; min-width: 0; }
  .gets h3 { font-weight: 800; font-stretch: 78%; font-size: 1.3rem; text-transform: uppercase; }
  .gets p { color: var(--paper-2); margin-top: 6px; }
  .warranty-card { background: var(--honey); color: var(--ink); padding: 26px 28px; border-left: 8px solid var(--yellow); display: grid; gap: 2px; max-width: 420px; }
  .w-big { font-weight: 800; font-stretch: 70%; font-size: 3rem; line-height: 1; color: var(--yellow); text-transform: uppercase; }
  .w-sub { font-weight: 700; margin-bottom: 14px; }
  .warranty-card .fine { color: var(--ink-2); }
  @media (max-width: 900px) { .gets { grid-template-columns: repeat(2, minmax(0, 1fr)); } .lane { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) { .gets { grid-template-columns: minmax(0, 1fr); } .lane li { margin-right: 30px; padding: 10px 12px; } }
</style>
