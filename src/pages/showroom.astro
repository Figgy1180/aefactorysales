---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, PRODUCTS } from '../data/site';
import interior from '../assets/photos/showroom-room-interior.jpg';
import smoke from '../assets/photos/showroom-polycarbonate-smoke.jpg';

// This page exists so a search for our street address finds AE: the address is in the title, heading and schema.
const full = `${SITE.street}, ${SITE.city}, ${SITE.region} ${SITE.zip}`;
const q = encodeURIComponent(`${SITE.name}, ${full}`);
const googleDir = `https://www.google.com/maps/dir/?api=1&destination=${q}&destination_place_id=ChIJ510x1Bq3QIYRFXxveDPO0GE`;
const appleDir = `https://maps.apple.com/?daddr=${encodeURIComponent(full)}&q=${encodeURIComponent(SITE.name)}`;
const crumbs = [{ name: 'Showroom', href: '/showroom/' }];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/showroom/#page`,
    url: `${SITE.url}/showroom/`,
    name: `${SITE.name} Showroom, ${full}`,
    about: { '@id': `${SITE.url}/#business` },
    mainEntity: { '@id': `${SITE.url}/#business` },
  },
];
---
<Base
  title={`AE Factory Sales Showroom | ${full}`}
  description={`AE Factory Sales patio enclosure showroom at ${full}, next to our factory. Open 9 to 5 daily by appointment. Call ${SITE.phone}.`}
  crumbs={crumbs}
  schema={schema}
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <h1 class="display">Our showroom at <span class="y">{SITE.street}</span></h1>
        <p class="sub">{SITE.name}, {full}. See every patio enclosure and screen system working side by side, right next to the factory where we build them.</p>
        <div class="actions">
          <a class="btn" href={SITE.phoneHref}>Call {SITE.phone} to book</a>
          <a class="btn btn-line" href={googleDir} rel="noopener">Directions</a>
        </div>
      </div>
      <figure class="dim-frame draw" style="margin:30px 0 0">
        <span class="dim h" aria-hidden="true"><span>AE showroom, Houston</span></span>
        <Image src={interior} alt="Inside the AE showroom: an enclosure combining polycarbonate panels and metal mesh" widths={[480, 900]} sizes="(max-width: 820px) 100vw, 540px" loading="eager" style="aspect-ratio:16/10;object-fit:cover" />
      </figure>
    </div>
  </PageHero>

  <section class="band">
    <div class="wrap visit">
      <div class="stack">
        <h2 class="h2">Address <span class="y">and hours</span></h2>
        <address class="card">
          <strong>{SITE.name}</strong><br />
          {SITE.street}<br />
          {SITE.city}, {SITE.region} {SITE.zip}<br />
          <a href={SITE.phoneHref}>{SITE.phone}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </address>
        <dl class="facts">
          <div><dt>Hours</dt><dd>9 am to 5 pm, 7 days a week</dd></div>
          <div><dt>Visits</dt><dd>By appointment only. Call first so someone is there to walk you through.</dd></div>
          <div><dt>Parking</dt><dd>Customer parking on site</dd></div>
          <div><dt>Where</dt><dd>North Houston, between Loop 610 and Beltway 8</dd></div>
        </dl>
        <div class="actions">
          <a class="btn btn-line" href={googleDir} rel="noopener">Google Maps directions</a>
          <a class="btn btn-line" href={appleDir} rel="noopener">Apple Maps directions</a>
        </div>
        <p class="small"><a href={SITE.googleProfileUrl} rel="noopener">See AE Factory Sales on Google</a></p>
      </div>
      <div class="stack">
        <h2 class="h2">What you <span class="y">can see</span></h2>
        <p class="lede">The showroom opened in 2026 beside our factory, where we have built these systems since 2022. See the systems up close, try the folding ones by hand, and ask the people who build them anything.</p>
        <ul class="sys">
          {PRODUCTS.map((p) => <li><a href={p.href}><b>{p.name}</b></a> <span>{p.kind}</span></li>)}
        </ul>
        <Image src={smoke} alt="Smokey Gray polycarbonate panels on display in the AE showroom" widths={[480, 800]} sizes="(max-width: 820px) 100vw, 520px" loading="lazy" style="aspect-ratio:16/10;object-fit:cover;width:100%" />
      </div>
    </div>
  </section>

  <section class="band on-paper">
    <div class="wrap stack">
      <h2 class="h2">Can't make it <span class="y">in?</span></h2>
      <p class="lede">We come to you. Book a free site visit anywhere in greater Houston: we measure, bring samples and email your written quote within a day.</p>
      <div class="actions"><a class="btn" href="/book-visit/">Book a free design visit</a><a class="btn btn-line" href="/how-we-build/">Tour the factory online</a></div>
    </div>
  </section>
</Base>

<style>
  .visit { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; align-items: start; }
  .visit > * { min-width: 0; }
  .card { font-style: normal; font-size: 1.15rem; line-height: 1.6; border-left: 3px solid var(--yellow); padding: 6px 0 6px 16px; }
  .facts { display: grid; gap: 10px; margin: 0; }
  .facts div { display: grid; grid-template-columns: 7em minmax(0, 1fr); gap: 12px; }
  .facts dt { font-weight: 800; text-transform: uppercase; font-stretch: 78%; }
  .facts dd { margin: 0; color: var(--ink-2); }
  .sys { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sys li { border-top: 1px solid var(--line, rgba(0,0,0,.12)); padding-top: 8px; }
  .sys span { color: var(--ink-2); }
  @media (max-width: 820px) { .visit { grid-template-columns: minmax(0, 1fr); } }
</style>
