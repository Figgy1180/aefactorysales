---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
const crumbs = [{ name: 'Privacy', href: '/privacy/' }];
---
<Base title="Privacy Policy | AE Factory Sales" description="How AE Factory Sales uses the information you send through this website." crumbs={crumbs}>
  <PageHero crumbs={crumbs}><h1 class="display">Privacy <span class="y">policy</span></h1></PageHero>
  <section class="band">
    <div class="wrap prose">
      <p>Last updated November 5, 2026.</p>
      <h2>What we collect</h2>
      <p>When you request a site visit or a quote, we collect what you type into the form: your name, phone, email, ZIP code, project details and any notes. Forms are delivered to us by email through Web3Forms.</p>
      <h2>How we use it</h2>
      <p>Only to contact you about your project or application, schedule a visit and prepare your quote. We do not sell or rent your information.</p>
      <h2>Financing</h2>
      <p>If you choose to apply for financing, you apply directly with a third-party lender under their own privacy policy. AE is not a lender.</p>
      <h2>Your choices</h2>
      <p>Ask us to update or delete your information at any time: {SITE.email} or {SITE.phone}.</p>
      <h2>Contact</h2>
      <p>{SITE.name}, {SITE.street}, {SITE.city}, {SITE.region} {SITE.zip}.</p>
    </div>
  </section>
</Base>
