---
// City pages, each built around a real AE project in that city. Add a city here only when there is a project to show.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import BookVisitForm from '../../components/BookVisitForm.astro';
import { PROJECTS, photos, altFor, fit } from '../../data/projects';
import { PRODUCTS, SITE, INSTALL, WARRANTY } from '../../data/site';

const AREAS = [
  { slug: 'katy', city: 'Katy', label: 'Katy', project: 'p4', lead: 'Patio and garage screens',
    intro: 'Our Katy project is a three-car garage: folding screen doors across all three bays, so the garage opens to the driveway without letting the bugs in. The same folding screens close in covered patios.' },
  { slug: 'richmond', city: 'Richmond', label: 'Richmond', project: 'p14', lead: 'Patio enclosures and screens',
    intro: 'Our Richmond project is a brick home with folding screens on both open sides of the covered patio. Fold them back and the whole patio opens to the yard.' },
  { slug: 'lake-conroe', city: 'Conroe', label: 'Conroe and Lake Conroe', project: 'p6', lead: 'Patio enclosures and screens',
    intro: 'Our Lake Conroe project wraps an outdoor kitchen: three large openings of folding screens that open to the pines, or close when the bugs come out.' },
];
export function getStaticPaths() {
  return [{ params: { city: 'katy' } }, { params: { city: 'richmond' } }, { params: { city: 'lake-conroe' } }];
}
const a = AREAS.find((x) => x.slug === Astro.params.city)!;
const p = PROJECTS.find((x) => x.id === a.project)!;
const ph = photos(p);
const href = `/service-area/${a.slug}/`;
const crumbs = [{ name: 'Service area', href: '/service-area/' }, { name: a.label, href }];
const others = AREAS.filter((x) => x.slug !== a.slug);
const service = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: `${a.lead} in ${a.label}, TX`, serviceType: 'Patio enclosure and screen installation',
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'City', name: `${a.city}, TX` },
};
---
<Base
  title={`${a.lead} in ${a.label}, TX | AE`}
  description={`${a.lead} in ${a.label}, TX, built in our Houston factory and installed by our own crew. See a real ${p.city} project.`}
  crumbs={crumbs}
  schema={[service]}
  image={ph[1]?.img ?? ph[0].img}
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <h1 class="display">{a.lead} <span class="y">in {a.label}, TX</span></h1>
        <p class="sub">{a.intro}</p>
        <div class="actions"><a class="btn" href="#book">Book my free site visit</a><a class="btn btn-line" href={`/projects/${p.slug}/`}>See the {p.city} project</a></div>
      </div>
      <figure class="dim-frame draw" style="margin:30px 0 0">
        <span class="dim h" aria-hidden="true"><span>{p.city}, TX</span></span>
        <Image src={ph[0].img} widths={fit([600, 1000], ph[0].img)} sizes="(max-width: 820px) 100vw, 560px" alt={altFor(p, ph[0].caption)} loading="eager" fetchpriority="high" style="aspect-ratio:4/3;object-fit:cover" />
      </figure>
    </div>
  </PageHero>

  <section class="band on-paper">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 class="h2">Our project <span class="y">in {p.city}</span></h2>
        <p class="lede">{p.title}. {p.goal ?? p.note}</p>
      </div>
      <div class="ca-photos">
        {ph.slice(0, 3).map((x) => (
          <figure><Image src={x.img} widths={fit([400, 720], x.img)} sizes="(max-width: 760px) 100vw, 380px" alt={altFor(p, x.caption)} loading="lazy" /><figcaption>{x.caption}</figcaption></figure>
        ))}
      </div>
      <p><a href={`/projects/${p.slug}/`} style="color:var(--paper-ink)">See every photo of this {p.city} project</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 class="h2">What we install <span class="y">in {a.city}</span></h2>
        <p class="lede">Every system is built for existing roofed patios, priced by the open wall area we fill, installed.</p>
      </div>
      <ul class="ca-sys">
        {PRODUCTS.map((s) => <li><a href={s.href}>{s.name}</a><span>{s.kind}</span><b>From ${s.msrp} per sq ft</b></li>)}
        <li><a href="/garage-screens/">Garage screens</a><span>Folding screen doors for garage bays</span><b><a href="/pricing/">See pricing</a></b></li>
      </ul>
      <dl class="ca-facts">
        <div><dt>Built</dt><dd>In our own factory in north Houston, next door to the showroom at {SITE.streetShort}</dd></div>
        <div><dt>Installed</dt><dd>{INSTALL}. No subcontractors.</dd></div>
        <div><dt>Warranty</dt><dd>{WARRANTY}</dd></div>
      </dl>
    </div>
  </section>

  <section class="band on-paper" id="book">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Book a free site visit <span class="y">in {a.city}</span></h2>
        <p class="lede">We come to your home, measure every opening, and bring samples. Your written quote is emailed within a day of the visit.</p>
        <p class="muted" style="color:var(--paper-2)">Also serving {others.map((o, i) => <>{i ? ' and ' : ''}<a href={`/service-area/${o.slug}/`} style="color:var(--paper-ink)">{o.label}</a></>)}, and the rest of <a href="/service-area/" style="color:var(--paper-ink)">greater Houston</a>.</p>
      </div>
      <div class="ca-card"><BookVisitForm id={`${a.slug}-book`} version={`city-${a.slug}`} /></div>
    </div>
  </section>
</Base>
<style>
  .ca-photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ca-photos figure { margin: 0; }
  .ca-photos :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; border: 2px solid var(--paper-ink); }
  .ca-photos figcaption { font-size: var(--step--1); color: var(--paper-2); padding-top: 6px; }
  .ca-sys { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ca-sys li { border-top: 2px solid var(--yellow); padding-top: 12px; display: grid; gap: 4px; min-width: 0; }
  .ca-sys li > a { font-weight: 800; font-stretch: 80%; font-size: 1.25rem; text-transform: uppercase; }
  .ca-sys span { color: var(--ink-2); }
  .ca-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; }
  .ca-facts dt { font-family: var(--mono); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--yellow); }
  .ca-facts dd { margin: 4px 0 0; color: var(--ink-2); }
  .ca-card { background: var(--honey); color: var(--ink); padding: 26px; border-top: 6px solid var(--yellow); }
  .ca-card :global(a) { color: var(--yellow); }
  .ca-card :global(.fine) { color: var(--ink-2); }
  @media (max-width: 760px) { .ca-photos, .ca-sys, .ca-facts { grid-template-columns: minmax(0, 1fr); } }
</style>
