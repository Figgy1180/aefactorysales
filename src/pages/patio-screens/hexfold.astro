---
import { Image } from 'astro:assets';
import ProductPage from '../../components/ProductPage.astro';
import { FAQ } from '../../data/site';
import open from '../../assets/photos/hexfold-patio-open.jpg';
import closed from '../../assets/photos/hexfold-patio-closed.jpg';
---
<ProductPage
  id="hexfold"
  title="Retractable Patio Screens in Houston, No Motor | Hexfold | AE"
  description="Hexfold retractable patio screens for Houston homes: honeycomb aluminum mesh, a metal-reinforced frame, opened by hand even in a power outage. From $28 per sq ft installed."
  h1={['Retractable metal screens,', 'opened by hand']}
  img={closed} alt="Brick Houston patio closed in with Hexfold folding screens" caption="Installed in Houston."
  fit={['Breeze with bugs outside', 'Openings up to 20 ft, no posts', 'A clear view when folded away']}
  faq={[FAQ.screens[0], FAQ.screens[3], FAQ.screens[5]]}
  schemaExtra={{ material: 'Honeycomb aluminum mesh, PVC-fiber frame with aluminum core and ceramic coating, stainless steel wheels' }}
>
  <figure slot="media" class="dim-frame draw hero-video">
    <span class="dim v" aria-hidden="true"><span>Up to 10 ft tall</span></span>
    <video width="540" height="960" src="/video/gable-open.mp4" poster="/video/gable-open-poster.jpg" autoplay muted loop playsinline controls preload="metadata" aria-label="Hexfold screens being folded open by hand on a gabled patio"></video>
  </figure>
  <section slot="extra" class="band on-paper" aria-labelledby="pair-title">
    <div class="wrap stack-lg">
      <h2 id="pair-title" class="h2">Open for the breeze, <span class="y">closed for the bugs</span></h2>
      <div class="pair">
        <figure><Image src={open} alt="Brick patio with Hexfold screens folded open" widths={[560, 1000]} sizes="(max-width: 640px) 100vw, 560px" loading="lazy" /><figcaption>Open</figcaption></figure>
        <figure><Image src={closed} alt="The same patio with Hexfold screens closed" widths={[560, 1000]} sizes="(max-width: 640px) 100vw, 560px" loading="lazy" /><figcaption>Closed, same patio</figcaption></figure>
      </div>
    </div>
  </section>
</ProductPage>
<style>
  .hero-video video { aspect-ratio: 9 / 16; max-height: 560px; width: auto; max-width: 100%; display: block; margin-inline: auto; background: var(--honey); }
  .hero-video { justify-self: center; margin: 30px 0 0; }
</style>
