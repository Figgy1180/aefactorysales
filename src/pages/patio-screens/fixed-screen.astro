---
import ProductPage from '../../components/ProductPage.astro';
import { FAQ } from '../../data/site';
import doorsClosed from '../../assets/photos/fixed-screen-doors-closed.jpg';
---
<ProductPage
  id="fixed"
  title="Stainless Steel Patio Screens in Houston | AE Factory Sales"
  description="Fixed Screen: 304 stainless steel mesh, standard, in a metal-reinforced, heat-welded frame, with an optional doggy door. From $24 per sq ft of opening installed."
  h1={['Stainless steel screens', 'for your covered patio']}
  img={doorsClosed} alt="Fixed Screen panels with screen doors on a Houston patio" caption="Installed in Houston."
  fit={['Openings you keep screened', 'Patios, French doors and garages', 'Homes with dogs (doggy door $200)']}
  faq={[FAQ.screens[2], FAQ.screens[1], FAQ.screens[6]]}
  schemaExtra={{ material: '304 stainless steel mesh, heat-welded PVC-fiber frame with aluminum core and ceramic coating' }}
>
  <section slot="extra" class="band on-paper" id="vs-nylon" aria-labelledby="mesh-title">
    <div class="wrap stack-lg">
      <h2 id="mesh-title" class="h2">Compare the mesh, <span class="y">not just the frame</span></h2>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable table">
        <table class="tbl">
          <thead><tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">AE Fixed Screen</th><th scope="col">Typical soft-mesh screen</th></tr></thead>
          <tbody>
            <tr><th scope="row">Mesh</th><td class="ours">304 stainless steel, standard</td><td>Fiberglass, polyester or nylon</td></tr>
            <tr><th scope="row">Frame</th><td class="ours">Heat-welded, aluminum core</td><td>Usually screwed or snapped together</td></tr>
            <tr><th scope="row">16 × 14 ft patio</th><td class="ours">About $5,800, installed</td><td>About $2,200 to $5,600 (HomeGuide)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="fine">No screen is pet-proof, and we don't sell any as such. Our warranty excludes accidents and intentional damage.</p>
    </div>
  </section>
</ProductPage>
