---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE, byId, money, type QA } from '../data/site';
import gable from '../assets/projects/p4/1-front.jpg';
import bays from '../assets/projects/p4/3-right-bays.jpg';

const hx = byId('hexfold'), fx = byId('fixed');
const garage = 16 * 7; // standard double garage door opening, sq ft
const crumbs = [{ name: 'Garage screens', href: '/garage-screens/' }];
const faq: QA[] = [
  { q: 'Can I still use the garage door opening?', a: 'With Hexfold, yes. The panels fold to the side to clear the opening. A full steel bottom track is available, and is standard on openings over 16.5 ft wide. We go over vehicle traffic and track options at the site visit.' },
  { q: 'Will it keep snakes out of the garage?', a: 'Yes. Hexfold uses honeycomb aluminum mesh and Fixed Screen uses 304 stainless steel. Both keep out mosquitoes, insects, mice and snakes, and every piece is CNC-cut to the opening.' },
  { q: 'Does it work with my garage door?', a: 'In most garages, yes. We check the opening, the door track and the clearances at the site visit and tell you exactly how it will fit before you order.' },
  { q: 'How much does a garage screen cost?', a: `A standard 16 × 7 ft double garage opening is about ${garage} sq ft. At our lowest installed prices that is about ${money(garage * fx.msrp)} in Fixed Screen or ${money(garage * hx.msrp)} in Hexfold, before options like locks or a full steel track. Your exact price comes from a free site visit.` },
];
const service = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Garage screen installation', serviceType: 'Garage screen door',
  provider: { '@id': `${SITE.url}/#business` }, areaServed: { '@type': 'City', name: 'Houston, TX' },
};
---
<Base
  title="Garage Screens in Houston | AE Factory Sales"
  description="Turn your garage into a bug-free workshop, gym or hangout with Hexfold or stainless Fixed Screen, built in our Houston factory and installed within a month."
  crumbs={crumbs}
  schema={[service]}
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <h1 class="display">Open the garage. <span class="y">Keep the bugs out.</span></h1>
        <p class="sub">Use your garage as a workshop, gym or hangout with the door up and the mosquitoes, mice and snakes out. The same Hexfold and Fixed Screen systems we build for patios.</p>
        <div class="actions"><a class="btn" href="/free-quote/">Get my price</a><a class="btn btn-line" href={SITE.phoneHref}>{SITE.phone}</a></div>
      </div>
      <figure class="dim-frame draw" style="margin:30px 30px 0 0">
        <span class="dim h" aria-hidden="true"><span>Up to 20 ft wide (Hexfold, meeting in the middle)</span></span>
        <span class="dim v" aria-hidden="true"><span>Up to 10 ft tall</span></span>
        <Image src={gable} alt="Three-car garage in Katy, TX with AE folding screen doors across all three bays" widths={[420, 800]} sizes="(max-width: 820px) 100vw, 520px" loading="eager" style="aspect-ratio:4/5" />
      </figure>
    </div>
  </PageHero>

  <section class="band on-paper">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2">Two ways <span class="y">to screen it</span></h2>
        <p class="lede">A standard double garage door opening is about 16 × 7 ft, or {garage} sq ft.</p>
      </div>
      <div class="table-wrap">
        <table class="tbl">
          <thead><tr><th scope="col">System</th><th scope="col">How it works</th><th scope="col">Best for</th><th scope="col" class="num">16 × 7 ft, from</th></tr></thead>
          <tbody>
            <tr><th scope="row">Hexfold</th><td>Folds to the side on our track. Honeycomb aluminum mesh, opens by hand.</td><td>Garages you still drive into</td><td class="num">{money(garage * hx.msrp)}</td></tr>
            <tr><th scope="row">Fixed Screen</th><td>Stationary 304 stainless steel panels with a screen door option.</td><td>Garage gyms, workshops and hangouts</td><td class="num">{money(garage * fx.msrp)}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="fine" style="margin-top:14px">At ${hx.msrp} and ${fx.msrp} per sq ft of opening, our lowest installed prices. Locks, a full steel track and site conditions change the final number.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap split" style="align-items:start">
      <div class="stack-lg">
        <h2 class="h2">Garage <span class="y">questions</span></h2>
        <figure style="margin:0"><Image src={bays} alt="Folding garage screen doors with handles, Katy, TX" widths={[480, 900]} sizes="(max-width: 820px) 100vw, 540px" loading="lazy" style="aspect-ratio:16/10;object-fit:cover;border:2px solid var(--yellow)" /></figure>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <RelatedLinks match="fold" title="More AE projects" skip="/garage-screens/" />

  <section class="band raised" id="quote">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Get your <span class="y">garage screen quote</span></h2>
        <p class="lede">Tell us about your garage and a rep will call you with a quote.</p>
        <p><a href="/projects/katy-three-car-garage-screens/">See the Katy three-car garage project</a></p>
      </div>
      <QuoteForm id="garage-visit" kind="screens" source="Garage screens page" />
    </div>
  </section>
</Base>
