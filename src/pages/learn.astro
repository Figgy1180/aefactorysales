---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, SIZES, FACTS, FINANCING, WARRANTY_FULL, FRAME, byId, range } from '../data/site';

const crumbs = [{ name: 'Learn', href: '/learn/' }];
const order = ['fixed', 'hexfold', 'clearfixed', 'clearfold', 'hybrid'].map(byId);
const sizeLimits = [
  ['Fixed Screen', 'Panels up to 4 × 11.5 ft, joined side by side', 'Yes, 1.5 × base rate'],
  ['Clearfixed', 'Panels up to 4 × 11.5 ft, joined side by side', 'Yes, 1.5 × base rate'],
  ['Hexfold', '10 × 10 ft per pull; 20 ft meeting in the middle', 'Fixed panels above'],
  ['Clearfold', '5 × 10 ft per pull; 10 ft meeting in the middle', 'Fixed panels above'],
  ['Hybrid', '9.8 × 11.5 ft per side; 19.7 ft meeting in the middle', 'Fixed panels above'],
];
const options = [
  ['Locks', 'Keyed lock set into the frame', 'Folding systems'],
  ['Doggy door', 'Small, medium or large, $200', 'Fixed Screen, Clearfixed'],
  ['Arches and angles', 'Cut to your roofline, 1.5 × base rate', 'Fixed Screen, Clearfixed'],
  ['Extra posts', 'Where an opening needs support', 'All systems'],
  ['Water stop', 'Keeps rain from running in', 'Standard on Clearfold and Hybrid; option on Hexfold'],
];
const glossary = [
  ['Opening', 'One open side of your patio, width × height. We price by the square feet of openings we fill.'],
  ['Meeting in the middle', 'Two folding stacks that close toward each other, for wider openings.'],
  ['Fixed panel', 'A panel that stays in place.'],
  ['Top track', 'Carries the folding panels, so nothing drags on the floor.'],
  ['Low track', 'A 3/8 in solid 304 stainless guide on the floor, under the ADA standards\' 1/2 in threshold limit. Standard on openings 16.5 ft and wider.'],
  ['Heat welding', 'Joining frame corners by melting them together instead of using screws.'],
  ['Polycarbonate', 'A tough, light clear material that flexes instead of shattering.'],
  ['VLT', 'Visible light transmission: how much daylight passes through.'],
  ['SHGC', 'Solar heat gain coefficient: how much of the sun\u2019s heat passes through, 0 to 1.'],
  ['3-season room', 'An enclosed, ventilated room without air conditioning.'],
];
const sections = [
  { id: 'systems', t: 'The five systems' },
  { id: 'sizes', t: 'Sizes and limits' },
  { id: 'materials', t: 'Materials and build' },
  { id: 'options', t: 'Options and add-ons' },
  { id: 'performance', t: 'Tested numbers' },
  { id: 'pricing', t: 'How pricing works' },
  { id: 'process', t: 'The process, start to finish' },
  { id: 'prepare', t: 'Before your site visit' },
  { id: 'warranty', t: 'Warranty' },
  { id: 'care', t: 'Care and maintenance' },
  { id: 'glossary', t: 'Glossary' },
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: 'Patio enclosure specs, options, warranty and care: the AE reference', datePublished: '2026-11-09', dateModified: '2026-11-23', author: { '@id': `${SITE.url}/#business` }, publisher: { '@id': `${SITE.url}/#business` }, mainEntityOfPage: `${SITE.url}/learn/` },
  { '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'Patio enclosure glossary', hasDefinedTerm: glossary.map(([n, d]) => ({ '@type': 'DefinedTerm', name: n, description: d })) },
];
---
<Base
  title="Patio Enclosure Specs, Options and Care | AE Factory Sales"
  description="AE patio screens and 3-season rooms in one place: specs, sizes, materials, options, tested numbers, pricing, warranty, care and a glossary."
  crumbs={crumbs}
  schema={ld}
>
  <PageHero crumbs={crumbs}>
    <div class="stack-lg" style="max-width:54em">
      <h1 class="display">The spec sheet, <span class="y">the fine print, all of it</span></h1>
      <p class="sub">Every size, material, option and number, in one place.</p>
      <div class="finder">
        <label for="learn-find" class="sr-only">Find a topic</label>
        <input id="learn-find" type="search" placeholder="Find a topic: track, warranty, pet door, wind…" autocomplete="off" />
        <p class="find-note fine" aria-live="polite"></p>
      </div>
    </div>
  </PageHero>

  <div class="wrap learn">
    <aside class="toc" aria-label="Contents">
      <p class="toc-k">Contents</p>
      <ol>{sections.map((s) => <li><a href={`#${s.id}`}>{s.t}</a></li>)}</ol>
      <a class="btn" href="/free-quote/">Price my patio</a>
    </aside>

    <div class="topics">
      <section id="systems" class="topic">
        <h2 class="h3">The five systems</h2>
        <p class="lede">Metal screens for breeze without bugs, tinted polycarbonate for wind and rain. Mix them per opening.</p>
        <div class="table-wrap" tabindex="0" role="region" aria-label="The five systems (table 1)"><table class="tbl">
          <thead><tr><th scope="col">System</th><th scope="col">What it is</th><th scope="col">Mesh or panel</th><th scope="col">Operation</th><th scope="col" class="num">From, installed</th></tr></thead>
          <tbody>{order.map((p) => <tr><th scope="row"><a href={p.href}>{p.name}</a></th><td>{p.kind}</td><td>{p.specs[0][1]}</td><td>{['fixed', 'clearfixed'].includes(p.id) ? 'Fixed' : 'Folds by hand'}</td><td class="num">${p.msrp}/sq ft</td></tr>)}</tbody>
        </table></div>
      </section>

      <section id="sizes" class="topic">
        <h2 class="h3">Sizes and limits</h2>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Sizes and limits (table 2)"><table class="tbl">
          <thead><tr><th scope="col">System</th><th scope="col">Largest opening</th><th scope="col">Arches and gables</th></tr></thead>
          <tbody>{sizeLimits.map(([a, b, c]) => <tr><th scope="row">{a}</th><td>{b}</td><td>{c}</td></tr>)}</tbody>
        </table></div>
        <p class="muted">Fixed panels over 8.5 ft tall get a center support bar.</p>
      </section>

      <section id="materials" class="topic">
        <h2 class="h3">Materials and build</h2>
        <dl class="defs">
          <div><dt>Frames</dt><dd>{FRAME.long} {FRAME.colors.join(' or ')}.</dd></div>
          <div><dt>Mesh</dt><dd>304 stainless steel, standard on Fixed Screen. Honeycomb aluminum (about 115 holes per sq in), standard on Hexfold and Hybrid.</dd></div>
          <div><dt>Polycarbonate</dt><dd>4 mm on Clearfixed, about half that on Clearfold. UV protected both sides, hard coated. Smokey Gray or Industrial Blue.</dd></div>
          <div><dt>Track</dt><dd>Panels hang from the top track. Low 3/8 in stainless track with ramp on openings 16.5 ft and wider; on narrower ones it is an add-on, and the standard track is 5/8 in.</dd></div>
          <div><dt>Hardware</dt><dd>Handles and locks routed into the frame. Stainless wheels on Hexfold. Some end caps are nylon.</dd></div>
        </dl>
      </section>

      <section id="options" class="topic">
        <h2 class="h3">Options and add-ons</h2>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Options and add-ons (table 3)"><table class="tbl">
          <thead><tr><th scope="col">Option</th><th scope="col">What it does</th><th scope="col">Available on</th></tr></thead>
          <tbody>{options.map(([a, b, c]) => <tr><th scope="row">{a}</th><td>{b}</td><td>{c}</td></tr>)}</tbody>
        </table></div>
        
      </section>

      <section id="performance" class="topic">
        <h2 class="h3">Tested numbers</h2>
        <table class="facts">
          <tbody>
            <tr><th scope="row">Visible light transmission</th><td>{FACTS.vlt} (Smokey Gray)</td></tr>
            <tr><th scope="row">Solar heat gain coefficient</th><td>{FACTS.shgc} (Smokey Gray)</td></tr>
            <tr><th scope="row">Wind</th><td>Polycarbonate panel withstood {FACTS.wind} in our factory's in-house wind tunnel test. Fold away folding panels before storms.</td></tr>
            <tr><th scope="row">Field tested</th><td>Screen systems: four years on Houston job sites</td></tr>
          </tbody>
        </table>
        <p class="fine">Light and heat: Smokey Gray panels. Wind: not a hurricane rating.</p>
      </section>

      <section id="pricing" class="topic">
        <h2 class="h3">How pricing works</h2>
        <p>We price the open wall area we fill, not your floor. Two open sides of a 16 × 14 ft patio, 8 ft tall, is about 240 sq ft.</p>
        <div class="table-wrap" tabindex="0" role="region" aria-label="How pricing works (table 4)"><table class="tbl tnum">
          <thead><tr><th scope="col">Patio</th>{order.map((p) => <th scope="col" class="num">{p.name}</th>)}</tr></thead>
          <tbody>{SIZES.map((s) => <tr><th scope="row">{s.name}<br /><span class="muted" style="font-weight:400;font-size:.85rem">{s.low} to {s.high} sq ft</span></th>{order.map((p) => <td class="num" style="font-size:.95rem !important">{range(p.msrp, s.low, s.high)}</td>)}</tr>)}</tbody>
        </table></div>
        <ul>
          <li>Included: design visit, fabrication, installation, parts and warranty.</li>
          <li>Extra: arched or angled panels (1.5 × base rate), posts, locks.</li>
          <li>{FINANCING}</li>
        </ul>
        <p><a href="/pricing/">Full pricing page</a> · <a href="/free-quote/">Price my patio in 4 steps</a></p>
      </section>

      <section id="process" class="topic">
        <h2 class="h3">The process, start to finish</h2>
        <ol class="steps-list">
          <li><b>Free design visit.</b> We measure and bring samples.</li>
          <li><b>Quote on site,</b> emailed within 24 hours.</li>
          <li><b>50% deposit</b> starts production in our factory.</li>
          <li><b>Test assembly.</b> We assemble your whole order and show it to you.</li>
          <li><b>Balance, then install</b> by our crew within a month of your order. Most take one day.</li>
        </ol>
      </section>

      <section id="prepare" class="topic">
        <h2 class="h3">Before your site visit</h2>
        <ul>
          <li><b>A roof is required.</b> We close in existing covered patios, porches and garages.</li>
          <li><b>Photos help.</b> Text a wide shot and each opening to {SITE.phone}.</li>
          <li><b>No city permit needed.</b> HOA approval may apply; we provide drawings for it.</li>
        </ul>
      </section>

      <section id="warranty" class="topic">
        <h2 class="h3">Warranty</h2>
        <p>{WARRANTY_FULL}</p>
        <p>Call or text {SITE.phone} with a photo; our own crew handles it.</p>
      </section>

      <section id="care" class="topic">
        <h2 class="h3">Care and maintenance</h2>
        <dl class="defs">
          <div><dt>Mesh and frames</dt><dd>Rinse with a hose; mild soap for pollen.</dd></div>
          <div><dt>Polycarbonate</dt><dd>Soft cloth, mild soap. No abrasive pads.</dd></div>
          <div><dt>Tracks</dt><dd>Sweep the bottom track; a little WD-40 in the top track twice a year.</dd></div>
        </dl>
      </section>


      <section id="glossary" class="topic">
        <h2 class="h3">Glossary</h2>
        <dl class="defs gloss">{glossary.map(([n, d]) => <div><dt>{n}</dt><dd>{d}</dd></div>)}</dl>
      </section>

      <p class="more">More answers on the <a href="/faq/">FAQ page</a>, or call {SITE.phone}.</p>
    </div>
  </div>
</Base>

<style>
  .finder { display: grid; gap: 6px; max-width: 560px; }
  .finder input { width: 100%; min-height: 52px; padding: 10px 14px; font: inherit; font-size: 17px; background: var(--honey); color: var(--ink); border: 2px solid var(--yellow); border-radius: 0; }
  .finder input:focus { outline: 3px solid var(--yellow-hi); outline-offset: 2px; }
  .learn { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(28px, 4vw, 56px); padding-block: var(--sec); align-items: start; }
  .toc { position: sticky; top: 96px; display: grid; gap: 12px; border-top: 2px solid var(--yellow); padding-top: 14px; }
  .toc-k { font-weight: 800; font-stretch: 80%; text-transform: uppercase; color: var(--yellow); }
  .toc ol { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; font-size: 0.95rem; }
  .toc a:not(.btn) { color: var(--ink); text-decoration: none; }
  .toc a:not(.btn):hover, .toc a.on { color: var(--yellow); text-decoration: underline; }
  .toc .btn { margin-top: 8px; font-size: 1rem; min-height: 46px; }
  .topics { display: grid; gap: 0; min-width: 0; }
  .topic { padding-block: 34px; border-top: 1px solid var(--line); display: grid; gap: 16px; scroll-margin-top: 90px; min-width: 0; }
  .topic:first-child { padding-top: 0; border-top: 0; }
  .topic .h3 { font-size: clamp(1.7rem, 3vw, 2.2rem); color: var(--yellow); }
  .topic ul, .topic ol { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; color: var(--ink-2); }
  .topic ul b, .topic ol b { color: var(--ink); }
  .topic p { max-width: 72ch; }
  .defs { margin: 0; display: grid; border-top: 1px solid var(--line); }
  .defs div { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .defs dt { font-weight: 700; color: var(--yellow); }
  .defs dd { margin: 0; color: var(--ink-2); }
  .tbl tbody th a { color: var(--ink); }
  .topic[hidden] { display: none; }
  .more { padding-top: 24px; border-top: 1px solid var(--line); color: var(--ink-2); }
  .more a { color: var(--yellow); }
  @media (max-width: 900px) {
    .learn { grid-template-columns: minmax(0, 1fr); }
    .toc { position: static; }
    .toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; }
  }
  @media (max-width: 560px) { .defs div { grid-template-columns: minmax(0, 1fr); gap: 4px; } .toc ol { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  const input = document.getElementById('learn-find') as HTMLInputElement;
  const note = document.querySelector('.find-note') as HTMLElement;
  const topics = Array.from(document.querySelectorAll<HTMLElement>('.topic'));
  const index = topics.map((t) => (t.textContent || '').toLowerCase());
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    topics.forEach((t, i) => { const hit = !q || q.split(/\s+/).every((w) => index[i].includes(w)); t.hidden = !hit; if (hit) n++; });
    note.textContent = q ? (n ? `${n} of ${topics.length} topics match "${input.value.trim()}".` : `Nothing matches "${input.value.trim()}". Try another word, or call ${'(713) 791-8073'}.`) : '';
  });
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]'));
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.hash === '#' + e.target.id)); }), { rootMargin: '-30% 0px -60% 0px' });
  topics.forEach((t) => io.observe(t));
</script>
