---
// Patio screens for homes with pets (URL keeps the search phrase). Brand guide v1.1: no pet-proof or comparative
// durability claims; the doggy door is an add-on and any pet opening needs a closure plan.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { SITE, SIZES, byId, range, type QA } from '../data/site';
import doorsOpen from '../assets/photos/fixed-screen-doors-open.jpg';
import doorFrame from '../assets/photos/fixed-screen-door-frame.jpg';

const fx = byId('fixed');
const crumbs = [{ name: 'Screens', href: '/screens/' }, { name: 'Screens for homes with pets', href: '/pet-proof-patio-screens/' }];
const faq: QA[] = [
  { q: 'What screen do you suggest for homes with dogs and cats?', a: `Most pet owners choose Fixed Screen: 304 stainless steel mesh in a metal-reinforced, heat-welded frame, from $${fx.msrp} per sq ft of opening installed. A doggy door can be added to a compatible panel.` },
  { q: 'Can you add a doggy door?', a: 'Yes, as an add-on to a compatible screen panel. We help you choose the size and spot at the site visit. Any pet opening is also a way in for other animals, so we plan its closure with you.' },
  { q: 'Is any screen completely pet-proof?', a: 'No. We do not sell any screen as pet-proof. What we offer is metal mesh instead of fabric, a lifetime warranty on the frame and 3 years on all parts. The warranty excludes accidents and intentional damage.' },
  { q: 'How much do screens for pet owners cost?', a: `Fixed Screen starts at $${fx.msrp} per sq ft of opening, installed. A small patio with ${SIZES[0].low} to ${SIZES[0].high} sq ft of openings runs ${range(fx.msrp, SIZES[0].low, SIZES[0].high)}. Your exact price comes with your quote.` },
];
const product = {
  '@context': 'https://schema.org', '@type': 'Product',
  name: 'AE Fixed Screen with doggy door add-on', category: 'Patio screens',
  description: 'Fixed patio screens with 304 stainless steel mesh in metal-reinforced, heat-welded frames, with an optional doggy door add-on. Built and installed in Houston by AE Factory Sales.',
  brand: { '@type': 'Brand', name: 'AE Factory Sales' }, material: '304 stainless steel mesh',
  image: new URL(doorsOpen.src, SITE.url).href, url: `${SITE.url}/pet-proof-patio-screens/`,
  offers: { '@type': 'Offer', priceCurrency: 'USD', price: fx.msrp, availability: 'https://schema.org/InStock', seller: { '@id': `${SITE.url}/#business` }, description: 'Installed price per square foot of opening' },
};
---
<Base
  title="Patio Screens for Dogs and Cats in Houston | AE"
  description={`Patio screens for Houston homes with dogs and cats: 304 stainless steel mesh, a doggy door add-on, from $${fx.msrp} per sq ft of opening installed.`}
  crumbs={crumbs}
  schema={[product]}
>
  <PageHero crumbs={crumbs}>
    <div class="stack-lg" style="max-width:52em">
      <h1 class="display">Patio screens <span class="y">for dogs and cats</span></h1>
      <p class="sub">Fixed Screen swaps fabric for 304 stainless steel mesh in a metal-reinforced, heat-welded frame. Add a doggy door so your dog has a dedicated way through.</p>
      <p class="lede"><strong style="color:var(--ink)">Short answer:</strong> stainless steel mesh, a doggy door add-on if you want one, from ${fx.msrp} per sq ft of opening, installed.</p>
      <div class="actions"><a class="btn" href="#quote">Get my screen quote</a><a class="btn btn-line" href="/screens/">All about Fixed Screen</a></div>
    </div>
  </PageHero>

  <section class="band on-paper">
    <div class="wrap split" style="align-items:center">
      <div class="stack-lg">
        <h2 class="h2">Built for life <span class="y">with pets</span></h2>
        <div class="pp">
          <div><h3>Stainless steel mesh</h3><p>304 stainless steel instead of fabric. See it beside a soft-mesh sample at your site visit.</p></div>
          <div><h3>A metal-reinforced frame</h3><p>Heat welded around an aluminum core, with no screws, and CNC-cut to your opening.</p></div>
          <div><h3>A door of its own</h3><p>Add a doggy door to a compatible panel. We help you choose the size and location, and plan its closure, since any pet opening is also a way in.</p></div>
        </div>
      </div>
      <figure class="pp-fig">
        <Image src={doorsOpen} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 520px" alt="AE Fixed Screen stainless steel screen doors open on a set of French doors" />
        <figcaption>Fixed Screen doors on French doors</figcaption>
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="wrap split" style="align-items:center">
      <figure class="pp-fig">
        <Image src={doorFrame} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 520px" alt="Close view of an AE Fixed Screen door frame and stainless steel mesh" loading="lazy" />
        <figcaption>Heat-welded frame and stainless mesh, up close</figcaption>
      </figure>
      <div class="stack">
        <h2 class="h2">Straight <span class="y">talk</span></h2>
        <p class="lede">No screen is indestructible, and we do not sell anything as pet-proof.</p>
        <p>What we can promise is metal mesh instead of fabric, a lifetime warranty on the frame and 3 years on all parts. The warranty excludes accidents and intentional damage.</p>
        <p><a href="/screens/#vs-nylon">Compare the mesh, side by side</a>.</p>
      </div>
    </div>
  </section>

  <section class="band raised">
    <div class="wrap stack-lg" style="max-width:900px">
      <h2 class="h2">Pet screen <span class="y">questions</span></h2>
      <Faq items={faq} />
    </div>
  </section>

  <RelatedLinks match="fixed" title="Screens on real Houston homes" />

  <section class="band raised" id="quote">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Get your <span class="y">screen quote</span></h2>
        <p class="lede">Tell us about your openings and your pets, and a rep will reply within 1 business day with a quote.</p>
      </div>
      <QuoteForm id="pet-quote" kind="screens" source="Screens for pets page" />
    </div>
  </section>
</Base>

<style>
  .pp { display: grid; gap: 18px; }
  .pp > div { border-top: 2px solid var(--yellow); padding-top: 12px; }
  .pp h3 { font-weight: 800; font-stretch: 78%; font-size: 1.3rem; text-transform: uppercase; }
  .pp p { color: var(--paper-2); margin-top: 4px; }
  .pp-fig { margin: 0; }
  .pp-fig :global(img) { width: 100%; height: auto; border: 3px solid var(--yellow); }
  .pp-fig figcaption { font-family: var(--mono); font-size: .8rem; margin-top: 8px; opacity: .85; }
</style>
