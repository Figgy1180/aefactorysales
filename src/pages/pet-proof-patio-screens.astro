---
// Pet-proof patio screens: built from the Fixed Screen content. Honest wording: the mesh resists
// tearing where nylon fails; nothing is indestructible, and the warranty excludes accidents and intentional damage.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { SITE, SIZES, byId, range, type QA } from '../data/site';
import doorsOpen from '../assets/photos/fixed-screen-doors-open.jpg';
import doorFrame from '../assets/photos/fixed-screen-door-frame.jpg';

const fx = byId('fixed');
const crumbs = [{ name: 'Screens', href: '/screens/' }, { name: 'Pet-proof patio screens', href: '/pet-proof-patio-screens/' }];
const faq: QA[] = [
  { q: 'What is the best screen for dogs and cats?', a: `For homes with pets we recommend Fixed Screen: 304 stainless steel mesh in a heat-welded frame. It resists tearing where nylon and fiberglass screens fail, and it starts at $${fx.msrp} per sq ft of opening, installed.` },
  { q: 'Can you add a pet door?', a: 'Yes. We can build a pet door right into a Fixed Screen panel so your dog can come and go. The panel is still CNC-cut to your opening and carries the same lifetime frame warranty and 3 years on parts.' },
  { q: 'Is any screen completely pet-proof?', a: 'No screen is indestructible. What we promise is metal mesh that resists tearing where fabric screens fail, a lifetime warranty on the frame and 3 years on all parts. The warranty excludes accidents and intentional damage.' },
  { q: 'How much do pet-proof patio screens cost?', a: `Fixed Screen starts at $${fx.msrp} per sq ft of opening, installed. A small patio with ${SIZES[0].low} to ${SIZES[0].high} sq ft of openings runs ${range(fx.msrp, SIZES[0].low, SIZES[0].high)}. Your exact price comes with your quote.` },
];
const product = {
  '@context': 'https://schema.org', '@type': 'Product',
  name: 'AE Fixed Screen: pet-proof patio screens', category: 'Patio screens',
  description: 'Fixed patio screens with 304 stainless steel mesh in heat-welded frames, with an optional built-in pet door. Built and installed in Houston by AE Factory Sales.',
  brand: { '@type': 'Brand', name: 'AE Factory Sales' }, material: '304 stainless steel mesh',
  image: new URL(doorsOpen.src, SITE.url).href, url: `${SITE.url}/pet-proof-patio-screens/`,
  offers: { '@type': 'Offer', priceCurrency: 'USD', price: fx.msrp, availability: 'https://schema.org/InStock', seller: { '@id': `${SITE.url}/#business` }, description: 'Installed price per square foot of opening' },
};
---
<Base
  title="Pet-Proof Patio Screens in Houston | AE Factory Sales"
  description={`Pet-proof patio screens for Houston homes: 304 stainless steel mesh in heat-welded frames, optional built-in pet door, from $${fx.msrp} per sq ft of opening installed.`}
  crumbs={crumbs}
  schema={[product]}
>
  <PageHero crumbs={crumbs}>
    <div class="stack-lg" style="max-width:52em">
      <h1 class="display">Pet-proof <span class="y">patio screens</span></h1>
      <p class="sub">Claws and paws are what finish off most nylon screens. Fixed Screen swaps the fabric for 304 stainless steel mesh in a heat-welded frame, so it resists tearing where nylon and fiberglass fail.</p>
      <p class="lede"><strong style="color:var(--ink)">Short answer:</strong> stainless steel mesh, a built-in pet door if you want one, from ${fx.msrp} per sq ft of opening, installed.</p>
      <div class="actions"><a class="btn" href="#quote">Get my screen quote</a><a class="btn btn-line" href="/screens/">All about Fixed Screen</a></div>
    </div>
  </PageHero>

  <section class="band on-paper">
    <div class="wrap split" style="align-items:center">
      <div class="stack-lg">
        <h2 class="h2">Why it holds up <span class="y">to pets</span></h2>
        <div class="pp">
          <div><h3>Stainless steel mesh</h3><p>304 stainless steel instead of fabric. It resists tearing where nylon fails.</p></div>
          <div><h3>A frame with no screws</h3><p>Heat welded, with an aluminum core, and CNC-cut to your opening so the panel fits without gaps.</p></div>
          <div><h3>A pet door built in</h3><p>We can build a pet door right into a panel, so your dog can come and go without you getting up.</p></div>
        </div>
      </div>
      <figure class="pp-fig">
        <Image src={doorsOpen} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 520px" alt="AE Fixed Screen stainless steel screen doors open on a set of French doors" />
        <figcaption>Fixed Screen doors on French doors</figcaption>
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="wrap split" style="align-items:center">
      <figure class="pp-fig">
        <Image src={doorFrame} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 520px" alt="Close view of an AE Fixed Screen door frame and stainless steel mesh" loading="lazy" />
        <figcaption>Heat-welded frame and stainless mesh, up close</figcaption>
      </figure>
      <div class="stack">
        <h2 class="h2">Straight <span class="y">talk</span></h2>
        <p class="lede">"Pet-proof" is what people search for, and no screen is indestructible.</p>
        <p>What we can promise is metal mesh that resists tearing where fabric screens fail, a lifetime warranty on the frame and 3 years on all parts. The warranty excludes accidents and intentional damage.</p>
        <p>Nylon screens typically need rescreening every 5 to 10 years (source: HomeGuide). <a href="/screens/#vs-nylon">Stainless vs nylon, side by side</a>.</p>
      </div>
    </div>
  </section>

  <section class="band raised">
    <div class="wrap stack-lg" style="max-width:900px">
      <h2 class="h2">Pet screen <span class="y">questions</span></h2>
      <Faq items={faq} />
    </div>
  </section>

  <RelatedLinks match="fixed" title="Screens on real Houston homes" />

  <section class="band raised" id="quote">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Get your <span class="y">screen quote</span></h2>
        <p class="lede">Tell us about your openings and your pets, and a rep will call you with a quote.</p>
      </div>
      <QuoteForm id="pet-quote" kind="screens" source="Pet-proof screens page" />
    </div>
  </section>
</Base>

<style>
  .pp { display: grid; gap: 18px; }
  .pp > div { border-top: 2px solid var(--yellow); padding-top: 12px; }
  .pp h3 { font-weight: 800; font-stretch: 78%; font-size: 1.3rem; text-transform: uppercase; }
  .pp p { color: var(--paper-2); margin-top: 4px; }
  .pp-fig { margin: 0; }
  .pp-fig :global(img) { width: 100%; height: auto; border: 3px solid var(--yellow); }
  .pp-fig figcaption { font-family: var(--mono); font-size: .8rem; margin-top: 8px; opacity: .85; }
</style>
