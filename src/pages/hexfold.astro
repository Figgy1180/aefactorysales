---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { FAQ, FACTS, SITE, byId, SIZES, range } from '../data/site';
import handle from '../assets/photos/gabled-opening-screens.jpg';
import handleMesh from '../assets/photos/hexfold-mesh-crop.jpg';
import open from '../assets/photos/hexfold-patio-open.jpg';
import closed from '../assets/photos/hexfold-patio-closed.jpg';
import corner from '../assets/photos/brick-home-screened-patio.jpg';

const hx = byId('hexfold');
const crumbs = [{ name: 'Hexfold', href: '/hexfold/' }];
const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Hexfold retractable patio screen',
  brand: { '@type': 'Brand', name: 'AE Factory Sales' },
  manufacturer: { '@id': `${SITE.url}/#business` },
  description: 'Retractable folding patio screen with honeycomb aluminum mesh (about 115 holes per sq in), heat-welded PVC-fiber frame with aluminum core and ceramic coating, and stainless steel wheels. Hung from the top track, opened by hand, no motor. Up to 10 × 10 ft per pull or 20 ft wide meeting in the middle.',
  material: 'Honeycomb aluminum mesh, PVC-fiber frame with aluminum core and ceramic coating, stainless steel wheels',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    seller: { '@id': `${SITE.url}/#business` },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: hx.msrp, priceCurrency: 'USD', unitText: 'square foot of opening, installed' },
  },
};
---
<Base
  title="Hexfold Retractable Patio Screens in Houston | AE"
  description="Hexfold manual folding metal screens: honeycomb aluminum mesh, a metal-reinforced frame, opened by hand even in a power outage. From $28 per sq ft installed."
  crumbs={crumbs}
  schema={[product]}
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <h1 class="display">Folding metal patio screens, <span class="y">opened by hand</span></h1>
        <p class="sub">Hexfold's honeycomb aluminum mesh folds to the side when you want an open patio and closes when you want a screen across the opening. You move it by hand, so its operation does not depend on electricity.</p>
        <div class="actions"><a class="btn" href="#quote">See Hexfold at my patio</a><a class="btn btn-line" href="#price">What it costs</a></div>
      </div>
      <figure class="dim-frame draw hero-video">
        <span class="dim v" aria-hidden="true"><span>Panels up to 10 ft tall</span></span>
        <video width="540" height="960" src="/video/gable-open.mp4" poster="/video/gable-open-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="Hexfold screens being folded open by hand on a gabled patio"></video>
      </figure>
    </div>
  </PageHero>

  <section class="band">
    <div class="wrap split">
      <figure class="dim-frame" style="margin:0"><Image src={handle} alt="Gabled Houston patio opening closed in with Hexfold folding screens" widths={[480, 900]} sizes="(max-width: 820px) 100vw, 560px" loading="lazy" style="aspect-ratio:16/10" /></figure>
      <div class="details">
        <h2 class="h2">Details <span class="y">you can feel</span></h2>
        <dl>
          <div><dt>It hangs from the top</dt><dd>The panels are free-floating: their weight rides on the top track, so nothing drags on the bottom. The heavy-duty bottom track clears debris instead of jamming.</dd></div>
          <div><dt>The handle is part of the frame</dt><dd>We route a channel into the frame and set the handle and lock inside it, so nothing is just screwed on.</dd></div>
          <div><dt>No motor</dt><dd>Nothing to wire, nothing to burn out, no remote to lose. One hand opens it.</dd></div>
          <div><dt>A frame that won't rust or crack</dt><dd>Heat welded with no screws. A PVC and fiber blend with an aluminum rod inside and a scratch-resistant ceramic coating, in Night Gray or Bright White.</dd></div>
          <div><dt>Metal where it counts</dt><dd>Honeycomb aluminum mesh and stainless steel wheels. Every panel gets double wheels and guards.</dd></div>
          <div><dt>Ready for Houston rain</dt><dd>Add a ramp water stop to the bottom track to keep rain from running in.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="band on-paper">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 class="h2">Open for the breeze, <span class="y">closed for the bugs</span></h2>
        <p class="lede">Same Houston patio, a few seconds apart.</p>
      </div>
      <div class="pair">
        <figure><Image src={open} alt="Brick patio with Hexfold screens folded open" widths={[560, 1000]} sizes="(max-width: 640px) 100vw, 560px" loading="lazy" /><figcaption>Open</figcaption></figure>
        <figure><Image src={closed} alt="The same patio with Hexfold screens closed" widths={[560, 1000]} sizes="(max-width: 640px) 100vw, 560px" loading="lazy" /><figcaption>Closed</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="band raised">
    <div class="wrap split" style="align-items:start">
      <div>
        <span class="facts-label">The facts</span>
        <table class="facts">
          <caption>Hexfold</caption>
          <tbody>
            {hx.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
            <tr><th scope="row">Shapes</th><td>Hexfold fills the rectangle; fixed panels cut to the angle fill a gable or arch above it.</td></tr>
            <tr><th scope="row">Frame colors</th><td>Night Gray or Bright White</td></tr>
            <tr><th scope="row">Install</th><td>Within a month of your order, by our own crew</td></tr>
            <tr><th scope="row">Warranty</th><td>Lifetime on the frame, 3 years on parts</td></tr>
          </tbody>
        </table>
        <p class="fine">Wind figures come from manufacturer test data and are everyday durability ratings, not a hurricane rating. <a href="/learn/#performance">Tested numbers</a></p>
      </div>
      <div class="stack-lg">
        <figure style="margin:0 auto;max-width:300px;width:100%"><Image src={handleMesh} alt="Hexfold handles and the folded honeycomb aluminum mesh, close up" widths={[300, 460]} sizes="300px" loading="lazy" style="aspect-ratio:460/544;width:100%;object-fit:cover;border:2px solid var(--yellow)" /></figure>
        <p class="muted">Honeycomb aluminum, about 115 holes per square inch. Metal mesh, fitted to your openings to help keep bugs and small pests outside.</p>
      </div>
    </div>
  </section>

  <section class="band" id="price">
    <div class="wrap split">
      <div class="stack">
        <h2 class="h2">What <span class="y">it costs</span></h2>
        <p class="lede">Hexfold starts at <strong style="color:var(--ink)">${hx.msrp} per sq ft of opening, installed</strong>. Motorized roll-down screens run about $40 to $45 per sq ft in Houston.</p>
        <table class="facts tnum">
          <tbody>
            {SIZES.map((s) => <tr><th scope="row">{s.name}<br /><span class="muted" style="font-weight:400;font-size:.88rem">{s.eg}</span></th><td style="font-weight:800;font-stretch:80%;font-size:1.3rem">{range(hx.msrp, s.low, s.high)}</td></tr>)}
          </tbody>
        </table>
        <p class="fine">Typical installed ranges for {SIZES[0].low} to {SIZES[2].high} sq ft of openings. Locks, ramp water stop and full steel track are options. Your exact price comes from a free site visit.</p>
        <div class="actions"><a class="btn" href="/free-quote/">Get my exact price</a><a class="btn btn-line" href="/guides/folding-vs-motorized-patio-screens/">Folding vs motorized</a></div>
      </div>
      <figure style="margin:0"><Image src={corner} alt="Screened patio room on a brick Houston home" widths={[480, 900]} sizes="(max-width: 820px) 100vw, 540px" loading="lazy" style="aspect-ratio:4/5;object-fit:cover;border:2px solid var(--yellow)" /></figure>
    </div>
  </section>

  <section class="band on-paper">
    <div class="wrap split" style="align-items:start">
      <h2 class="h2">Hexfold <span class="y">questions</span></h2>
      <Faq items={[FAQ.screens[0], FAQ.screens[3], FAQ.screens[1], FAQ.general[0], FAQ.general[1], FAQ.general[3]]} />
    </div>
  </section>

  <section class="band on-paper" aria-labelledby="outage-title">
    <div class="wrap hx3">
      <div><h2 id="outage-title" class="h3">The power can go out. You can still open your screens.</h2><p>Open and close Hexfold with the handle. Its manual folding mechanism has no motor programming to restore when household power returns.</p></div>
      <div><h2 class="h3">Metal mesh. Reinforced at the core.</h2><p>Hexfold combines honeycomb aluminum mesh with metal reinforcement inside the frame. We bring samples so you can compare the mesh and frame construction before choosing.</p></div>
      <div><h2 class="h3">A top-supported folding wall.</h2><p>The panel weight rides on the top track as the wall folds to the side. At your site visit, we check the opening and show where the panels will stack.</p></div>
    </div>
    <style>
      .hx3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; }
      .hx3 > div { border-top: 3px solid var(--yellow); padding-top: 14px; min-width: 0; }
      .hx3 .h3 { font-size: 1.35rem; }
      .hx3 p { color: var(--paper-2); margin-top: 8px; }
      @media (max-width: 820px) { .hx3 { grid-template-columns: minmax(0, 1fr); } }
    </style>
  </section>

  <RelatedLinks match="fold" title="Hexfold on real Houston homes" />

  <section class="band raised" id="quote">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Get your <span class="y">Hexfold quote</span></h2>
        <p class="lede">Tell us about your openings and a rep will call you with a quote. Want to see it working first? Visit the showroom at {SITE.streetShort}.</p>
      </div>
      <QuoteForm id="hex-visit" kind="screens" source="Hexfold page" />
    </div>
  </section>
</Base>

<style>
  .hero-video { justify-self: center; margin: 0 30px 0 0; max-width: 380px; }
  .hero-video video { aspect-ratio: 9 / 16; width: 100%; }
  .details { display: grid; gap: 22px; }
  .details dl { margin: 0; display: grid; border-top: 2px solid var(--yellow); }
  .details dl div { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .details dt { font-weight: 800; font-stretch: 80%; font-size: 1.2rem; text-transform: uppercase; color: var(--yellow); }
  .details dd { margin: 4px 0 0; color: var(--ink-2); }
</style>
