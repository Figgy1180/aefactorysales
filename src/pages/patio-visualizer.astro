---
// Patio visualizer: upload a photo, drag four corners onto an opening, preview each AE system.
// Runs entirely in the browser (WebGL); the photo never leaves the device.
import Base from '../layouts/Base.astro';
const crumbs = [{ name: 'Patio visualizer', href: '/patio-visualizer/' }];
---
<Base
  title="Patio Visualizer: See AE Screens and Panels on Your Patio | AE"
  description="Upload a photo of your covered patio and preview Hexfold, Fixed Screen, Clearfixed, Clearfold and Hybrid in Night Gray or Bright White, with a rough installed price."
  crumbs={crumbs}
>
  <section class="band hive" style="padding-top:24px">
<div class="wrap viz">
  <h1 class="display">See AE systems <span class="y">on your patio</span></h1>
  <p class="sub">Upload a photo of your covered patio, line the yellow corners up with an opening, and try every AE screen and panel system in both frame colors.</p>
  <label class="file-btn m-upload" for="file">Upload my patio photo</label>
  <ol class="steps">
    <li>Upload a photo, or try it on the sample patio below.</li>
    <li id="stepCorners">Drag the four yellow corners to the corners of one opening.</li>
    <li>Pick a system and frame color. Add more openings if you have them.</li>
  </ol>

  <div class="grid">
    <div class="stage-box">
      <div class="stage" id="stage">
        <img id="photo" src="/visualizer/sample-patio.jpg" alt="Your patio photo" draggable="false">
        <canvas id="gl" aria-hidden="true"></canvas>
        <svg class="outline" id="outline" aria-hidden="true"></svg>
        <div id="handles"></div>
      </div>
      <div class="stage-bar">
        <span id="status">Sample: brick patio in Richmond, TX</span>
        <div class="row">
          <button type="button" class="btn" id="cleanBtn" aria-pressed="false">Hide corners</button>
          <button type="button" class="btn" id="beforeBtn" aria-pressed="false">Show before</button>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="row">
        <label class="file-btn">Upload my patio photo<input type="file" id="file" accept="image/*"></label>
        <p class="fine upload-note" id="aiNote" hidden>Our AI reads your photo to find the opening and estimate its size. The photo is not saved. <a href="/privacy/">Privacy</a></p>
      </div>
      <p class="note">Your photo stays on this device. Nothing is uploaded or saved.</p>

      <fieldset>
        <legend>System</legend>
        <div class="seg" id="sysSeg"></div>
      </fieldset>

      <fieldset>
        <legend>Frame color</legend>
        <div class="seg" id="frameSeg">
          <button type="button" data-frame="gray" aria-pressed="true">Night Gray</button>
          <button type="button" data-frame="white" aria-pressed="false">Bright White</button>
        </div>
      </fieldset>

      <fieldset id="tintField" hidden>
        <legend>Panel tint</legend>
        <div class="seg" id="tintSeg">
          <button type="button" data-tint="gray" aria-pressed="true">Smokey Gray</button>
          <button type="button" data-tint="blue" aria-pressed="false">Industrial Blue</button>
        </div>
      </fieldset>

      <fieldset>
        <legend>Position</legend>
        <div class="seg" id="openSeg">
          <button type="button" data-open="0" aria-pressed="true">Closed</button>
          <button type="button" data-open="1" aria-pressed="false">Folded open</button>
        </div>
      </fieldset>

      <fieldset>
        <legend>Openings</legend>
        <div class="row">
          <span class="label" style="margin:0" id="openingLabel">Opening 1 of 1</span>
        </div>
        <div class="row" id="panRow">
          <div class="stepper" aria-label="Panels in this opening">
            <button type="button" id="panMinus" aria-label="Fewer panels">−</button>
            <output id="panOut" aria-live="polite">4</output>
            <button type="button" id="panPlus" aria-label="More panels">+</button>
          </div>
          <span class="note">panels</span>
        </div>
        <div class="row">
          <button type="button" class="btn" id="addBtn">Add opening</button>
          <button type="button" class="btn" id="delBtn">Remove this one</button>
        </div>
      </fieldset>

      <fieldset>
        <legend>Rough price for this opening</legend>
        <div class="dims">
          <label for="wIn">Width (ft)<input id="wIn" type="number" min="1" max="40" step="0.5" value="14" inputmode="decimal"></label>
          <label for="hIn">Height (ft)<input id="hIn" type="number" min="1" max="12" step="0.5" value="8" inputmode="decimal"></label>
        </div>
        <div class="price">
          <b id="priceOut">$3,100</b>
          <small id="priceNote">Hexfold at $28 per sq ft of opening, installed</small>
          <p class="total" id="totalOut" hidden></p>
        </div>
      </fieldset>

      <a class="btn primary" href="/book-visit/" style="text-align:center;text-decoration:none">Book my free design visit</a>
      <p class="note">This is a preview, not a rendering of your exact job. We measure every opening at the free site visit and go over your quote on site, then email it within 24 hours.</p>
    </div>
  </div>
</div>

  </section>
</Base>
<style is:global>
.viz { display: block; }
.viz h1 { margin: 12px 0 0; }
.viz .sub { margin-top: 12px; color: var(--ink-2); max-width: 60ch; }
.viz .grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; margin-top: 28px; align-items: start; }
.viz .stage-box { border: 2px solid var(--yellow); background: #1F1B18; padding: 10px; min-width: 0; }
.viz .stage { position: relative; width: 100%; user-select: none; -webkit-user-select: none; touch-action: none; }
.viz .stage.reading::after { content: "Finding your opening…"; position: absolute; inset: 0; display: grid; place-items: center; background: rgba(31,27,24,.45); color: #FBF5EC; font: 800 16px var(--font); letter-spacing: .03em; text-transform: uppercase; animation: vizpulse 1.2s ease-in-out infinite alternate; }
/* hide the placeholder outline while the photo is being read */
.viz .stage.reading canvas, .viz .stage.reading svg.outline, .viz .stage.reading #handles { visibility: hidden; }
@keyframes vizpulse { from { background: rgba(31,27,24,.30); } to { background: rgba(31,27,24,.55); } }
@media (prefers-reduced-motion: reduce) { .viz .stage.reading::after { animation: none; } }
.viz .upload-note { margin: 6px 0 0; max-width: 34ch; }
.viz .stage img, .viz .stage canvas { display: block; width: 100%; height: auto; }
.viz .stage canvas { position: absolute; inset: 0; height: 100%; pointer-events: none; transition: opacity .25s; }
.viz .stage svg.outline { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.viz .stage svg.outline polygon { fill: transparent; stroke: rgba(242,194,48,.85); stroke-width: 1.25; stroke-dasharray: 5 6; vector-effect: non-scaling-stroke; cursor: move; }
.viz .stage svg.outline polygon.other { stroke: rgba(242,194,48,.35); stroke-dasharray: 3 6; cursor: pointer; }
.viz .handle { position: absolute; width: 44px; height: 44px; margin: -22px 0 0 -22px; padding: 0; border-radius: 50%; background: transparent; border: 0; cursor: grab; touch-action: none; }
.viz .handle::after { content: ""; position: absolute; inset: 14px; border-radius: 50%; background: var(--yellow); border: 2px solid #1F1B18; box-shadow: 0 0 0 1.5px var(--yellow); }
.viz .handle:active::after { inset: 11px; }
.viz .stage.clean svg.outline, .viz .stage.clean #handles { display: none; }
.viz .handle:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
.viz .stage-bar { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; margin-top: 10px; font-family: var(--mono); font-size: 13px; color: var(--ink-2); }
.viz .panel { background: var(--honey-2); border: 1px solid var(--line); padding: 18px; display: grid; gap: 18px; min-width: 0; }
.viz fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 8px; min-width: 0; }
.viz legend, .viz .label { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); padding: 0; margin-bottom: 8px; }
.viz .seg { display: flex; flex-wrap: wrap; gap: 6px; }
.viz .seg button, .viz .btn, .viz .file-btn { font: 700 14px var(--font); padding: 11px 14px; min-height: 44px; border: 1.5px solid rgba(242,194,48,.55); background: transparent; color: var(--ink); cursor: pointer; }
.viz .seg button[aria-pressed="true"] { background: var(--yellow); border-color: var(--yellow); color: #2A2522; }
.viz .seg button:disabled { opacity: .4; cursor: not-allowed; }
.viz .btn.primary, .viz .file-btn { background: var(--yellow); border-color: var(--yellow); color: #2A2522; text-transform: uppercase; letter-spacing: .04em; font-weight: 800; }
.viz .btn:focus-visible, .viz .seg button:focus-visible, .viz .file-btn:focus-within { outline: 3px solid var(--ink); outline-offset: 2px; }
.viz .file-btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
.viz .file-btn input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
.viz .m-upload { display: none; }
@media (max-width: 900px) { .viz .m-upload { display: flex; width: 100%; margin-top: 16px; min-height: 52px; } }
.viz .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.viz .stepper { display: flex; align-items: center; gap: 0; }
.viz .stepper button { width: 44px; height: 44px; font: 800 20px var(--font); background: var(--honey-3); color: var(--ink); border: 1px solid var(--line); cursor: pointer; }
.viz .stepper output { min-width: 56px; text-align: center; font: 800 20px var(--font); font-variant-numeric: tabular-nums; }
.viz .dims { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.viz .dims label { display: grid; gap: 4px; font-family: var(--mono); font-size: 12px; color: var(--ink-2); }
.viz .dims input { font: 700 18px var(--font); padding: 10px; background: #1F1B18; color: var(--ink); border: 1px solid var(--line); min-width: 0; width: 100%; font-variant-numeric: tabular-nums; }
.viz .price { border-top: 1px solid var(--line); padding-top: 14px; }
.viz .price b { display: block; font-size: 34px; font-weight: 900; font-stretch: 80%; font-variant-numeric: tabular-nums; }
.viz .price small { color: var(--ink-2); font-family: var(--mono); font-size: 12px; }
.viz .note { font-family: var(--mono); font-size: 12px; color: var(--ink-2); margin: 0; }
.viz .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 22px; }
.viz .steps li { color: var(--ink-2); display: flex; gap: 10px; align-items: flex-start; padding-top: 12px; }
.viz .steps li::before { flex: none; width: 28px; height: 28px; font-size: .95rem; }
@media (max-width: 900px) { .viz .grid { grid-template-columns: minmax(0, 1fr); } .viz .steps { display: none; } .viz .stage-box { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 66px); z-index: 5; } .viz .sub { font-size: 1rem; } }
.callbar, .cb-fab { display: none !important; }
.viz .total { font-family: var(--mono); font-size: 13px; color: var(--ink); margin-top: 6px; }
@media (prefers-reduced-motion: reduce) { .viz .stage canvas { transition: none; } }
</style>
<script is:inline>

(() => {
  const SYSTEMS = [
    { id: 'hexfold', name: 'Hexfold', rate: 28, kind: 'mesh', folds: true },
    { id: 'fixed', name: 'Fixed Screen', rate: 24, kind: 'mesh', folds: false },
    { id: 'clearfixed', name: 'Clearfixed', rate: 31, kind: 'smoke', folds: false },
    { id: 'clearfold', name: 'Clearfold', rate: 40, kind: 'smoke', folds: true },
    { id: 'hybrid', name: 'Hybrid', rate: 56, kind: 'hybrid', folds: true },
  ];
  const FRAME = { gray: [0.10, 0.105, 0.115], white: [0.95, 0.94, 0.91] };
  const state = { sys: 'hexfold', frame: 'gray', tint: 'gray', open: false, before: false, sel: 0, openings: [] };

  const photo = document.getElementById('photo');
  const canvas = document.getElementById('gl');
  const stage = document.getElementById('stage');
  const outline = document.getElementById('outline');
  const handlesEl = document.getElementById('handles');
  const $ = (id) => document.getElementById(id);

  // ---------- WebGL ----------
  const gl = canvas.getContext('webgl', { premultipliedAlpha: true, preserveDrawingBuffer: true });
  if (gl) gl.getExtension('OES_standard_derivatives');
  if (!gl) { $('status').textContent = 'This browser cannot draw the preview (WebGL is off).'; }
  const vs = `attribute vec2 p; void main(){ gl_Position = vec4(p,0.,1.); }`;
  const fs = `
  #extension GL_OES_standard_derivatives : enable
  precision highp float;
  uniform mat3 uHinv; uniform vec2 uRes; uniform vec2 uSize; uniform float uPanels;
  uniform float uSys; uniform float uOpen; uniform vec3 uFrame; uniform float uWft; uniform float uTint;
  float hexMesh(vec2 g){
    vec2 r = vec2(1.0, 1.732);
    vec2 h = r*0.5;
    vec2 a = mod(g, r) - h; vec2 b = mod(g - h, r) - h;
    vec2 q = dot(a,a) < dot(b,b) ? a : b;
    q = abs(q);
    float d = max(q.x*0.866 + q.y*0.5, q.y);
    return smoothstep(0.36, 0.46, d);
  }
  // coverage of a vertical bar centred at c with half width hw (inner x units), anti-aliased
  float bar(float x, float c, float hw, float aa){ return 1.0 - smoothstep(hw - aa, hw + aa, abs(x - c)); }
  // repeating bars of half width hw at every 1/n (edges included)
  float bars(float x, float n, float hw, float aa){ float f = fract(x * n + 0.5) - 0.5; return 1.0 - smoothstep(hw - aa, hw + aa, abs(f) / n); }
  vec4 meshA(vec2 uv, float cellPx, float base, float hi){
    vec2 g = uv * uSize / cellPx;
    float scr = cellPx / max(fwidth(uv.x * uSize.x), 1e-4);      // cell size in screen pixels
    float w = mix(0.5, hexMesh(g), smoothstep(3.0, 6.0, scr));   // fade detail to its average when too small to draw
    return vec4(vec3(0.05, 0.052, 0.056), mix(base, hi, w));
  }
  vec4 pleated(vec2 uv, float period){
    float t = uv.x * uSize.x / period;
    float scr = period / max(fwidth(uv.x * uSize.x), 1e-4);
    float k = smoothstep(1.6, 3.6, scr);                           // pleat contrast only when visible
    float p = fract(t);
    float shade = 0.5 + 0.5 * cos(p * 6.2831);
    vec4 m = meshA(uv, 2.2, 0.60, 0.78);
    m.a = clamp(m.a + 0.10 * (shade - 0.5) * k, 0.0, 1.0);
    m.rgb += 0.05 * (1.0 - shade) * k;
    float aa = fwidth(t);
    float lw = max(0.035, 0.6 * aa);
    float line = (1.0 - smoothstep(lw, lw + aa, abs(p - 0.0)) + 1.0 - smoothstep(lw, lw + aa, abs(p - 1.0))) * k * 0.85;
    m = mix(m, vec4(0.03, 0.03, 0.03, 0.9), clamp(line, 0.0, 1.0));
    return m;
  }
  vec4 poly(vec2 uv){
    float sheen = smoothstep(0.0, 0.5, 1.0 - abs((uv.x*0.6 + uv.y*0.8) - 0.55) * 3.0) * 0.10;
    vec3 tint = uTint > 0.5 ? vec3(0.10, 0.30, 0.52) : vec3(0.17, 0.18, 0.19);
    return vec4(tint + sheen, uTint > 0.5 ? 0.62 : 0.70);
  }
  vec3 frameRGB(float y){ return uFrame * (0.88 + 0.12 * y); }
  // folding polycarbonate: small fan folds, alternate faces catch the light, a slim frame line at each fold
  vec4 polyFolds(vec2 uv, float period){
    float t = uv.x * uSize.x / period;
    float scr = period / max(fwidth(uv.x * uSize.x), 1e-4);
    float k = smoothstep(1.6, 3.6, scr);
    float p = fract(t);
    float face = mod(floor(t), 2.0);
    float ramp = face < 0.5 ? p : 1.0 - p;          // each face brightens toward the fold it leans into
    vec4 c = poly(uv);
    c.rgb += (face < 0.5 ? 0.05 : -0.025) * k + 0.04 * ramp * k;
    float aa = fwidth(t);
    float lw = max(0.05, 0.7 * aa);
    float edgeL = (1.0 - smoothstep(lw, lw + aa, p)) + (1.0 - smoothstep(lw, lw + aa, 1.0 - p));
    return mix(c, vec4(frameRGB(uv.y), 1.0), clamp(edgeL, 0.0, 1.0) * k);
  }
  // straight-alpha "over"
  vec4 over(vec4 top, vec4 bot){ float a = top.a + bot.a * (1.0 - top.a); vec3 c = (top.rgb * top.a + bot.rgb * bot.a * (1.0 - top.a)) / max(a, 1e-4); return vec4(c, a); }
  void main(){
    vec2 px = vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y);
    vec3 q = uHinv * vec3(px, 1.0);
    vec2 uv = q.xy / q.z;
    vec2 duv = fwidth(uv);
    // soft outer edge
    float edge = smoothstep(-duv.x, duv.x, uv.x) * smoothstep(-duv.x, duv.x, 1.0 - uv.x) * smoothstep(-duv.y, duv.y, uv.y) * smoothstep(-duv.y, duv.y, 1.0 - uv.y);
    if (edge <= 0.0) discard;
    float fpx = max(3.0, uSize.y * 0.016);
    vec2 t = vec2(fpx) / uSize;
    float innerW = uSize.x * (1.0 - 2.0 * t.x);
    float ix = (uv.x - t.x) / (1.0 - 2.0 * t.x);
    float aa = max(fwidth(ix), 1e-5) * 0.8;
    float aay = max(duv.y, 1e-5) * 0.8;
    float st = fpx * 0.55 / innerW;
    float ftPx = uSize.x / max(uWft, 1.0);
    float n = max(uPanels, 1.0);
    float stack = fpx * 3.2 / innerW;
    float pleatP = max(3.0, ftPx / 6.0);
    float stackP = max(2.0, fpx * 0.45);
    vec4 base = vec4(0.0);       // infill
    float fr = 0.0;              // frame / stile coverage
    float hd = 0.0;              // handle coverage (metal)
    if (uSys < 0.5) {            // Hexfold: one pull up to 10 ft, two meeting in the middle above that
      bool two = uWft > 10.25;
      if (uOpen > 0.5) {
        float inS = two ? max(1.0 - smoothstep(stack - aa, stack + aa, ix), smoothstep(1.0 - stack - aa, 1.0 - stack + aa, ix)) : smoothstep(1.0 - stack - aa, 1.0 - stack + aa, ix);
        base = pleated(uv, stackP); base.a *= inS;
        fr = max(bar(ix, 1.0 - stack, st, aa), two ? bar(ix, stack, st, aa) : 0.0);
      } else {
        base = pleated(uv, pleatP);
        float c = two ? 0.5 : 0.0;
        fr = bar(ix, c, st * 1.6, aa);
        hd = fr * (1.0 - smoothstep(0.06 - aay, 0.06 + aay, abs(uv.y - 0.5))) * bar(ix, c, st * 0.8, aa);
      }
    } else if (uSys < 2.5) {     // Fixed Screen, Clearfixed: framed fixed panels of equal width
      base = uSys < 1.5 ? meshA(uv, 1.8, 0.56, 0.76) : poly(uv);
      fr = bars(ix, n, st, aa);
    } else if (uSys < 3.5) {     // Clearfold: equal leaves, up to 5 ft per pull, meeting in the middle above that
      bool two = uWft > 5.25;
      if (uOpen > 0.5) {
        float sw = stack * 1.6;
        float inS = two ? max(1.0 - smoothstep(sw - aa, sw + aa, ix), smoothstep(1.0 - sw - aa, 1.0 - sw + aa, ix)) : smoothstep(1.0 - sw - aa, 1.0 - sw + aa, ix);
        base = polyFolds(uv, max(2.0, fpx * 0.6)); base.a *= inS;
        fr = (two ? max(bar(ix, sw, st, aa), bar(ix, 1.0 - sw, st, aa)) : bar(ix, 1.0 - sw, st, aa));
      } else {
        base = polyFolds(uv, max(3.0, ftPx * 0.67));    // folds about 8 in wide
        if (two) { float hb = bar(ix, 0.5, st * 1.3, aa); fr = max(fr, hb); hd = hb * (1.0 - smoothstep(0.06 - aay, 0.06 + aay, abs(uv.y - 0.5))) * bar(ix, 0.5, st * 0.6, aa); }
      }
    } else {                     // Hybrid: two full layers on the same opening. Closed view = panels across the opening, mesh folded at the right end.
            if (uOpen > 0.5) {
        float sw = stack * 1.6;
        float inL = 1.0 - smoothstep(sw - aa, sw + aa, ix);
        float inR = smoothstep(1.0 - stack - aa, 1.0 - stack + aa, ix);
        vec4 pl = polyFolds(uv, max(2.0, fpx * 0.6)); pl.a *= inL;
        vec4 ms = pleated(uv, stackP); ms.a *= inR;
        base = over(pl, ms);
        fr = max(bar(ix, sw, st, aa), bar(ix, 1.0 - stack, st, aa));
      } else {
        float e = 1.0 - stack;                                   // panels' leading edge meets the folded mesh
        float inR = smoothstep(e - aa, e + aa, ix);
        vec4 pl = polyFolds(uv, max(3.0, ftPx * 0.67)); pl.a *= 1.0 - inR;
        vec4 ms = pleated(uv, stackP); ms.a *= inR;
        base = over(pl, ms);
        fr = bar(ix, e, st * 1.6, aa);
        hd = bar(ix, e - st * 1.4, st * 0.8, aa) * (1.0 - smoothstep(0.06 - aay, 0.06 + aay, abs(uv.y - 0.5)));
      }
    }
    // outer frame: head and sill tracks, jambs
    float outerF = max(max(1.0 - smoothstep(t.x - duv.x, t.x + duv.x, uv.x), smoothstep(1.0 - t.x - duv.x, 1.0 - t.x + duv.x, uv.x)),
                       max(1.0 - smoothstep(t.y * 1.2 - duv.y, t.y * 1.2 + duv.y, uv.y), smoothstep(1.0 - t.y * 1.4 - duv.y, 1.0 - t.y * 1.4 + duv.y, uv.y)));
    fr = max(fr, outerF);
    vec4 c = over(vec4(frameRGB(uv.y), fr), base);
    c = over(vec4(0.78, 0.77, 0.74, hd), c);
    c.a *= edge;
    gl_FragColor = vec4(c.rgb * c.a, c.a);
  }`;
  let prog, loc = {};
  function sh(type, src) { const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s)); return s; }
  if (gl) {
    prog = gl.createProgram();
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, vs)); gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fs)); gl.linkProgram(prog);
    gl.useProgram(prog);
    const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const pl = gl.getAttribLocation(prog, 'p'); gl.enableVertexAttribArray(pl); gl.vertexAttribPointer(pl, 2, gl.FLOAT, false, 0, 0);
    ['uHinv', 'uRes', 'uSize', 'uPanels', 'uSys', 'uOpen', 'uFrame', 'uWft', 'uTint'].forEach((k) => (loc[k] = gl.getUniformLocation(prog, k)));
    gl.enable(gl.BLEND); gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
  }

  // square -> quad homography (p0 TL, p1 TR, p2 BR, p3 BL)
  function homography(p) {
    const [x0, y0] = p[0], [x1, y1] = p[1], [x2, y2] = p[2], [x3, y3] = p[3];
    const dx1 = x1 - x2, dx2 = x3 - x2, dx3 = x0 - x1 + x2 - x3;
    const dy1 = y1 - y2, dy2 = y3 - y2, dy3 = y0 - y1 + y2 - y3;
    let g = 0, h = 0;
    const den = dx1 * dy2 - dx2 * dy1;
    if (Math.abs(dx3) > 1e-9 || Math.abs(dy3) > 1e-9) { g = (dx3 * dy2 - dx2 * dy3) / den; h = (dx1 * dy3 - dx3 * dy1) / den; }
    return [x1 - x0 + g * x1, x3 - x0 + h * x3, x0, y1 - y0 + g * y1, y3 - y0 + h * y3, y0, g, h, 1];
  }
  function inv3(m) {
    const [a, b, c, d, e, f, g, h, i] = m;
    const A = e * i - f * h, B = -(d * i - f * g), C = d * h - e * g;
    const det = a * A + b * B + c * C;
    if (Math.abs(det) < 1e-12) return null;
    return [A / det, -(b * i - c * h) / det, (b * f - c * e) / det, B / det, (a * i - c * g) / det, -(a * f - c * d) / det, C / det, -(a * h - b * g) / det, (a * e - b * d) / det];
  }
  const dist = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]);

  function render() {
    if (!gl || !canvas.width) return;
    gl.viewport(0, 0, canvas.width, canvas.height);
    gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
    const sys = SYSTEMS.find((s) => s.id === state.sys);
    const sysIdx = { hexfold: 0, fixed: 1, clearfixed: 2, clearfold: 3, hybrid: 4 }[sys.id];
    let crossed = false;
    for (const o of state.openings) {
      if (!convex(o.pts)) { crossed = true; continue; }
      const Hi = inv3(homography(o.pts)); if (!Hi) continue;
      gl.uniformMatrix3fv(loc.uHinv, false, [Hi[0], Hi[3], Hi[6], Hi[1], Hi[4], Hi[7], Hi[2], Hi[5], Hi[8]]);
      gl.uniform2f(loc.uRes, canvas.width, canvas.height);
      const w = (dist(o.pts[0], o.pts[1]) + dist(o.pts[3], o.pts[2])) / 2;
      const h = (dist(o.pts[0], o.pts[3]) + dist(o.pts[1], o.pts[2])) / 2;
      gl.uniform2f(loc.uSize, Math.max(w, 1), Math.max(h, 1));
      gl.uniform1f(loc.uPanels, o.panels);
      gl.uniform1f(loc.uSys, sysIdx);
      gl.uniform1f(loc.uWft, o.w || 10);
      gl.uniform1f(loc.uTint, state.tint === 'blue' ? 1 : 0);
      gl.uniform1f(loc.uOpen, state.open && sys.folds ? 1 : 0);
      gl.uniform3fv(loc.uFrame, FRAME[state.frame]);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }
    const st = $('status');
    if (crossed) { st.dataset.prev = st.dataset.prev || st.textContent; st.textContent = 'Two corners are crossed. Drag them back so the outline makes a box.'; }
    else if (st.dataset.prev) { st.textContent = st.dataset.prev; delete st.dataset.prev; }
  }
  // true when the four corners make a box shape (no crossed or folded corners)
  function convex(p) {
    let sign = 0;
    for (let i = 0; i < 4; i++) {
      const a = p[i], b = p[(i + 1) % 4], c = p[(i + 2) % 4];
      const z = (b[0] - a[0]) * (c[1] - b[1]) - (b[1] - a[1]) * (c[0] - b[0]);
      if (Math.abs(z) < 1e-6) return false;
      if (sign === 0) sign = Math.sign(z); else if (Math.sign(z) !== sign) return false;
    }
    return true;
  }

  // ---------- handles and outlines ----------
  const toPct = (p) => [(p[0] / canvas.width) * 100, (p[1] / canvas.height) * 100];
  function drawUI() {
    outline.setAttribute('viewBox', `0 0 ${canvas.width} ${canvas.height}`);
    outline.innerHTML = '';
    state.openings.forEach((o, i) => {
      const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      poly.setAttribute('points', o.pts.map((p) => p.join(',')).join(' '));
      if (i !== state.sel) poly.setAttribute('class', 'other');
      poly.addEventListener('pointerdown', (e) => { if (i !== state.sel) { state.sel = i; syncPanel(); drawUI(); } else startMove(e); });
      outline.appendChild(poly);
    });
    handlesEl.innerHTML = '';
    const o = state.openings[state.sel]; if (!o) return;
    const names = ['top left', 'top right', 'bottom right', 'bottom left'];
    o.pts.forEach((p, k) => {
      const h = document.createElement('button');
      h.type = 'button'; h.className = 'handle';
      h.setAttribute('aria-label', `Move the ${names[k]} corner (arrow keys)`);
      const [x, y] = toPct(p); h.style.left = x + '%'; h.style.top = y + '%';
      h.addEventListener('pointerdown', (e) => startDrag(e, k, h));
      h.addEventListener('keydown', (e) => {
        const step = e.shiftKey ? 10 : 2; const d = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
        if (!d) return; e.preventDefault(); p[0] = clampX(p[0] + d[0]); p[1] = clampY(p[1] + d[1]); render(); drawUI(); handlesEl.children[k].focus();
      });
      handlesEl.appendChild(h);
    });
  }
  const clampX = (v) => Math.max(0, Math.min(canvas.width, v));
  const clampY = (v) => Math.max(0, Math.min(canvas.height, v));
  function toCanvas(e) { const r = stage.getBoundingClientRect(); return [clampX(((e.clientX - r.left) / r.width) * canvas.width), clampY(((e.clientY - r.top) / r.height) * canvas.height)]; }
  function startDrag(e, k, h) {
    e.preventDefault(); h.setPointerCapture(e.pointerId);
    const o = state.openings[state.sel];
    const move = (ev) => { o.pts[k] = toCanvas(ev); const [x, y] = toPct(o.pts[k]); h.style.left = x + '%'; h.style.top = y + '%'; outline.children[state.sel].setAttribute('points', o.pts.map((p) => p.join(',')).join(' ')); render(); };
    const up = () => { h.removeEventListener('pointermove', move); h.removeEventListener('pointerup', up); h.removeEventListener('pointercancel', up); };
    h.addEventListener('pointermove', move); h.addEventListener('pointerup', up); h.addEventListener('pointercancel', up);
  }
  function startMove(e) {
    e.preventDefault(); const tgt = e.target; tgt.setPointerCapture(e.pointerId);
    const o = state.openings[state.sel]; let last = toCanvas(e);
    const move = (ev) => { const c = toCanvas(ev); const dx = c[0] - last[0], dy = c[1] - last[1]; last = c; o.pts.forEach((p) => { p[0] = clampX(p[0] + dx); p[1] = clampY(p[1] + dy); }); render(); drawUI(); };
    const up = () => { tgt.removeEventListener('pointermove', move); tgt.removeEventListener('pointerup', up); };
    tgt.addEventListener('pointermove', move); tgt.addEventListener('pointerup', up);
  }

  // ---------- controls ----------
  const sysSeg = $('sysSeg');
  SYSTEMS.forEach((s) => { const b = document.createElement('button'); b.type = 'button'; b.textContent = s.name; b.dataset.sys = s.id; sysSeg.appendChild(b); });
  function setPressed(seg, attr, val) { seg.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset[attr] === String(val)))); }
  sysSeg.addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; state.sys = b.dataset.sys; refresh(); });
  $('frameSeg').addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; state.frame = b.dataset.frame; refresh(); });
  $('tintSeg').addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; state.tint = b.dataset.tint; refresh(); });
  $('openSeg').addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b || b.disabled) return; state.open = b.dataset.open === '1'; refresh(); });
  $('cleanBtn').addEventListener('click', () => { const on = stage.classList.toggle('clean'); $('cleanBtn').setAttribute('aria-pressed', String(on)); $('cleanBtn').textContent = on ? 'Show corners' : 'Hide corners'; });
  $('beforeBtn').addEventListener('click', () => { state.before = !state.before; canvas.style.opacity = state.before ? '0' : '1'; $('beforeBtn').setAttribute('aria-pressed', String(state.before)); $('beforeBtn').textContent = state.before ? 'Show with screens' : 'Show before'; });
  $('panMinus').addEventListener('click', () => { const o = state.openings[state.sel]; if (o) { o.panels = Math.max(1, o.panels - 1); syncPanel(); render(); } });
  $('panPlus').addEventListener('click', () => { const o = state.openings[state.sel]; if (o) { o.panels = Math.min(16, o.panels + 1); syncPanel(); render(); } });
  $('addBtn').addEventListener('click', () => { state.openings.push(defaultOpening(state.openings.length)); state.sel = state.openings.length - 1; syncPanel(); render(); drawUI(); });
  $('delBtn').addEventListener('click', () => { if (state.openings.length <= 1) return; state.openings.splice(state.sel, 1); state.sel = Math.max(0, state.sel - 1); syncPanel(); render(); drawUI(); });
  ['wIn', 'hIn'].forEach((id) => $(id).addEventListener('input', () => { const o = state.openings[state.sel]; if (o) { o.w = parseFloat($('wIn').value) || 0; o.h = parseFloat($('hIn').value) || 0; } price(); render(); }));

  function price() {
    const sys = SYSTEMS.find((s) => s.id === state.sys);
    const w = parseFloat($('wIn').value) || 0, h = parseFloat($('hIn').value) || 0;
    const total = Math.round((sys.rate * w * h) / 100) * 100;
    $('priceOut').textContent = total > 0 ? '$' + total.toLocaleString('en-US') : '—';
    $('priceNote').textContent = `${sys.name} at $${sys.rate} per sq ft of opening, installed`;
    const all = state.openings.reduce((t, o) => t + (o.w || 0) * (o.h || 0), 0);
    const tot = Math.round((sys.rate * all) / 100) * 100;
    $('totalOut').hidden = state.openings.length < 2;
    $('totalOut').textContent = `All ${state.openings.length} openings: about $${tot.toLocaleString('en-US')} (${Math.round(all)} sq ft)`;
  }
  function syncPanel() {
    const o = state.openings[state.sel]; if (!o) return;
    $('panOut').textContent = o.panels;
    $('openingLabel').textContent = `Opening ${state.sel + 1} of ${state.openings.length}`;
    $('delBtn').disabled = state.openings.length <= 1;
    $('wIn').value = o.w; $('hIn').value = o.h; price();
  }
  function refresh() {
    const sys = SYSTEMS.find((s) => s.id === state.sys);
    setPressed(sysSeg, 'sys', state.sys); setPressed($('frameSeg'), 'frame', state.frame);
    $('openSeg').querySelector('[data-open="1"]').disabled = !sys.folds;
    if (!sys.folds) state.open = false;
    setPressed($('openSeg'), 'open', state.open ? 1 : 0);
    setPressed($('tintSeg'), 'tint', state.tint);
    $('tintField').hidden = !['clearfixed', 'clearfold', 'hybrid'].includes(sys.id);
    $('panRow').hidden = !['fixed', 'clearfixed'].includes(sys.id);
    price(); render();
  }
  function defaultOpening(i) {
    const W = canvas.width, H = canvas.height, off = i * 0.06;
    const x0 = W * (0.3 + off), x1 = W * (0.7 + off), y0 = H * (0.3 + off), y1 = H * (0.78 + off);
    return { pts: [[x0, y0], [x1, y0], [x1, y1], [x0, y1]].map(([x, y]) => [clampX(x), clampY(y)]), panels: 4, w: 10, h: 8 };
  }

  // ---------- photo loading ----------
  let sample = true, pendingFind = false, findSeq = 0, aiOn = false;
  // Photo reading switches itself on only when the Worker has its Claude key.
  fetch('/api/find-opening/', { cache: 'no-store' }).then((r) => r.ok ? r.json() : null).then((j) => {
    if (!j || !j.enabled) return;
    aiOn = true; $('aiNote').hidden = false;
    $('stepCorners').textContent = 'We find the opening and its size for you. Drag the yellow corners to fine-tune.';
  }).catch(() => {});
  function setup() {
    // draw at the screen's real sharpness (up to 2200 px), even when the photo is smaller
    const want = Math.max(photo.naturalWidth, Math.min(2200, (stage.clientWidth || 800) * (window.devicePixelRatio || 1)));
    const s = Math.min(want / photo.naturalWidth, 2200 / Math.max(photo.naturalWidth, photo.naturalHeight));
    canvas.width = Math.round(photo.naturalWidth * s); canvas.height = Math.round(photo.naturalHeight * s);
    if (sample) {
      const k = canvas.width / 874;
      state.openings = [{ pts: [[332, 195], [545, 152], [545, 520], [332, 462]].map(([x, y]) => [x * k, y * k]), panels: 4, w: 14, h: 8 }];
    } else {
      state.openings = [defaultOpening(0)];
    }
    state.sel = 0; syncPanel(); refresh(); drawUI();
    if (pendingFind && !sample) { pendingFind = false; findOpening(); }
  }
  // keep the whole photo on screen (desktop): limit the stage width by the window height
  function fitStage() {
    if (!photo.naturalWidth) return;
    const narrow = window.matchMedia('(max-width: 900px)').matches;
    stage.style.maxWidth = narrow ? '' : Math.max(320, (window.innerHeight - 170) * (photo.naturalWidth / photo.naturalHeight)) + 'px';
    stage.style.marginInline = narrow ? '' : 'auto';
  }
  window.addEventListener('resize', fitStage);
  photo.addEventListener('load', fitStage);
  if (photo.complete) fitStage();
  photo.addEventListener('load', setup);
  if (photo.complete && photo.naturalWidth) setup();
  $('file').addEventListener('change', (e) => {
    const f = e.target.files && e.target.files[0]; if (!f) return;
    if (!f.type.startsWith('image/')) { $('status').textContent = 'That file is not a photo. Try a JPG or PNG.'; return; }
    sample = false; pendingFind = aiOn; photo.src = URL.createObjectURL(f);
    delete $('status').dataset.prev; $('status').textContent = aiOn ? 'Your photo. Looking for the opening…' : 'Your photo. Drag the yellow corners onto an opening.';
  });

  // Ask the AE photo reader (Claude, via our Cloudflare Worker) to find the opening and estimate its size.
  // The photo is shrunk first, sent once, read and not stored. If anything fails, the customer places the corners by hand.
  async function findOpening() {
    const seq = ++findSeq, st = $('status');
    stage.classList.add('reading');
    try {
      const max = 1280, sc = Math.min(1, max / Math.max(photo.naturalWidth, photo.naturalHeight));
      const c = document.createElement('canvas'); c.width = Math.round(photo.naturalWidth * sc); c.height = Math.round(photo.naturalHeight * sc);
      c.getContext('2d').drawImage(photo, 0, 0, c.width, c.height);
      const image = c.toDataURL('image/jpeg', 0.85).split(',')[1];
      const ctl = new AbortController(); const timer = setTimeout(() => ctl.abort(), 30000);
      const r = await fetch('/api/find-opening/', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ image, width: c.width, height: c.height }), signal: ctl.signal });
      clearTimeout(timer);
      if (seq !== findSeq || sample) return;
      const j = await r.json().catch(() => ({}));
      const found = r.ok && Array.isArray(j.openings) ? j.openings.filter((o) => convex(o.corners)) : [];
      if (!found.length) { st.textContent = r.status === 429 ? 'Too many photos at once. Drag the yellow corners onto an opening.' : (r.ok ? "Couldn't spot the opening on its own. Drag the yellow corners onto it." : 'Your photo. Drag the yellow corners onto an opening.'); return; }
      state.openings = found.map((o) => ({ pts: o.corners.map(([x, y]) => [x * canvas.width, y * canvas.height]), w: o.width_ft, h: o.height_ft, panels: Math.max(1, Math.ceil(o.width_ft / 3.5)) }));
      state.sel = 0; syncPanel(); refresh(); drawUI();
      const o = found[0], more = found.length > 1 ? ` We found ${found.length} openings; switch between them on the right.` : '';
      const layout = state.sys === 'hexfold' ? (o.width_ft > 10.25 ? ' Two Hexfold screens meet in the middle.' : ' One Hexfold screen pulls across.') : '';
      st.textContent = `Looks about ${o.width_ft} ft wide and ${o.height_ft} ft tall.${layout}${more} Drag the corners to fine-tune.`;
    } catch {
      if (seq === findSeq && !sample) st.textContent = 'Your photo. Drag the yellow corners onto an opening.';
    } finally {
      if (seq === findSeq) stage.classList.remove('reading');
    }
  }
})();

</script>
