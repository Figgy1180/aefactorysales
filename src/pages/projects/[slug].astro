---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { PROJECTS, photos, altFor, fit, type Project } from '../../data/projects';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return PROJECTS.filter((p) => photos(p).length).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
const ph = photos(p);
const pair = p.openClosed ? p.openClosed.map((k) => ph.find((x) => x.key === k)!) : null;
const rest = ph.filter((x) => !p.openClosed?.includes(x.key));
const href = `/projects/${p.slug}/`;
const crumbs = [{ name: 'Projects', href: '/projects/' }, { name: `${p.city}: ${p.title}`, href }];
const others = PROJECTS.filter((x) => x.id !== p.id && photos(x).length).slice(0, 3);
const ld = {
  '@context': 'https://schema.org', '@type': 'ImageGallery',
  name: `${p.title} in ${p.city}, TX`, description: p.note,
  contentLocation: { '@type': 'Place', name: `${p.city}, TX` },
  author: { '@id': `${SITE.url}/#business` },
  image: ph.map((x) => new URL(x.img.src, SITE.url).href),
};
---
<Base
  title={`${p.city} ${p.title} | A&E Projects`}
  description={`${p.title} in ${p.city}, TX with ${p.systems.join(' and ').toLowerCase()}. Built in Houston, installed by our crew.`}
  crumbs={crumbs}
  schema={[ld]}
  image={ph[0].img.src}
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <h1 class="display">{p.title} <span class="y">{p.city}, TX</span></h1>
        {p.note && <p class="sub">{p.note}</p>}
        <ul class="sys">{p.systems.map((s) => <li>{s}</li>)}</ul>
      </div>
      <figure class="dim-frame draw" style="margin:30px 0 0">
        <span class="dim h" aria-hidden="true"><span>{p.city}, TX</span></span>
        <Image src={ph[0].img} widths={fit([600, 1000, 1280], ph[0].img)} sizes="(max-width: 820px) 100vw, 560px" alt={altFor(p, ph[0].caption)} loading="eager" fetchpriority="high" style="aspect-ratio:4/3;object-fit:cover" />
      </figure>
    </div>
  </PageHero>

  {p.goal && (
    <section class="band-tight raised">
      <div class="wrap goal">
        <h2 class="h3">What the homeowners wanted</h2>
        <p class="lede">{p.goal}</p>
      </div>
    </section>
  )}

  {pair && (
    <section class="band on-paper">
      <div class="wrap stack-lg">
        <h2 class="h2">Closed <span class="y">and open</span></h2>
        <div class="pair">
          {pair.map((x, i) => <figure><Image src={x.img} widths={fit([560, 1000], x.img)} sizes="(max-width: 640px) 100vw, 560px" alt={altFor(p, x.caption)} loading="lazy" /><figcaption>{i === 0 ? 'Closed' : 'Open'}: {x.caption}</figcaption></figure>)}
        </div>
      </div>
    </section>
  )}

  <section class="band">
    <div class={`wrap ${p.facts ? 'split' : ''}`} style="align-items:start">
      {p.facts && (
        <div>
          <span class="facts-label">The facts</span>
          <table class="facts"><caption>{p.city} project</caption><tbody>{p.facts.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table>
        </div>
      )}
      <div class={`more-photos${p.facts ? '' : ' wide'}`}>
        {rest.slice(1).map((x) => <figure><Image src={x.img} widths={fit([480, 900], x.img)} sizes="(max-width: 820px) 100vw, 540px" alt={altFor(p, x.caption)} loading="lazy" /><figcaption class="fine">{x.caption}</figcaption></figure>)}
      </div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="band raised">
      <div class="wrap stack">
        <h2 class="h3">More projects</h2>
        <ul class="olist">{others.map((o) => <li><a href={`/projects/${o.slug}/`}>{o.city}: {o.title}</a></li>)}<li><a href="/projects/">All projects</a></li></ul>
      </div>
    </section>
  )}

  <section class="band raised" id="quote">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Want one <span class="y">like this?</span></h2>
        <p class="lede">Free site visit. We measure every opening and give you a number you can plan around.</p>
        <p><a href="/free-quote/">Or price your patio in 4 steps</a></p>
      </div>
      <QuoteForm id="project-visit" source={`Project: ${p.city} ${p.title}`} />
    </div>
  </section>
</Base>
<style>
  .sys { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sys li { border: 1px solid var(--line); padding: 5px 11px; font-size: 0.9rem; }
  .more-photos { display: grid; gap: 18px; }
  .more-photos.wide { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .more-photos figure { margin: 0; min-width: 0; }
  @media (max-width: 640px) { .more-photos.wide { grid-template-columns: minmax(0, 1fr); } }
  .more-photos img { width: 100%; border: 2px solid var(--yellow); }
  .more-photos figcaption { padding-top: 8px; }
  .goal { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: 24px; align-items: baseline; border-left: 6px solid var(--yellow); padding-left: 20px; }
  @media (max-width: 760px) { .goal { grid-template-columns: minmax(0, 1fr); gap: 10px; } }
  .olist { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 24px; }
</style>
