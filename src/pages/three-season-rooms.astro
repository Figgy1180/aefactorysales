---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import CompareBars from '../components/CompareBars.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { FAQ, FACTS, SITE, byId, SIZES, range } from '../data/site';
import clearfixed from '../assets/photos/clearfixed-polycarbonate-panels.jpg';
import smoke from '../assets/photos/showroom-polycarbonate-smoke.jpg';
import interior from '../assets/photos/showroom-room-interior.jpg';
import rack from '../assets/photos/factory-pc.jpg';

const crumbs = [{ name: '3-season rooms', href: '/three-season-rooms/' }];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Polycarbonate 3-season room installation',
  serviceType: 'Patio enclosure',
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'City', name: 'Houston, TX' },
  offers: ['clearfixed', 'clearfold', 'hybrid'].map((id) => {
    const p = byId(id);
    return {
      '@type': 'Offer',
      name: p.name,
      description: p.kind,
      priceSpecification: { '@type': 'UnitPriceSpecification', price: p.msrp, priceCurrency: 'USD', unitText: 'square foot of opening, installed' },
    };
  }),
};
const cf = byId('clearfixed'), cfo = byId('clearfold');
---
<Base
  title="Polycarbonate 3-Season Rooms in Houston | A&E Factory Sales"
  description="Turn your covered patio into a 3-season room with tinted polycarbonate panels for a fraction of a glass sunroom. Built in Houston. From $31 per sq ft."
  crumbs={crumbs}
  schema={[service]}
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <h1 class="display">A 3-season room <span class="y">for a fraction of glass</span></h1>
        <p class="sub">Tinted polycarbonate panels in a heat-welded frame, with screen doors and doors that open on both sides so air moves through. Built for existing roofed patios.</p>
        <div class="actions"><a class="btn" href="/free-quote/">Get my price</a><a class="btn btn-line" href="#vs-glass">Compare to glass</a></div>
      </div>
      <figure class="dim-frame draw" style="margin:30px 30px 0 0">
        <span class="dim h" aria-hidden="true"><span>Panels up to 3.5 ft wide</span></span>
        <span class="dim v" aria-hidden="true"><span>Up to 10 ft tall</span></span>
        <Image src={clearfixed} alt="Clearfixed tinted polycarbonate panels on an A&E patio enclosure" widths={[420, 720]} sizes="(max-width: 820px) 100vw, 520px" loading="eager" style="aspect-ratio:4/5" />
      </figure>
    </div>
  </PageHero>

  <section class="band on-paper" id="vs-glass">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 class="h2">Same room, <span class="y">a different bill</span></h2>
        <p class="lede">Glass sunrooms are priced like a home addition. A polycarbonate enclosure uses the patio roof you already have.</p>
      </div>
      <div class="table-wrap">
        <table class="tbl">
          <thead><tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">A&amp;E 3-season room</th><th scope="col">3-season sunroom</th><th scope="col">4-season glass sunroom</th></tr></thead>
          <tbody>
            <tr><th scope="row">16 × 14 ft patio, two open sides</th><td class="ours">$7,400 to $9,600</td><td>$18,000 to $52,000</td><td>$45,000 to $90,000</td></tr>
            <tr><th scope="row">If something hits it</th><td class="ours">Polycarbonate flexes instead of shattering</td><td colspan="2">Glass can crack or shatter</td></tr>
            <tr><th scope="row">Weight</th><td class="ours">Much lighter than glass at comparable thickness, which makes folding panels practical</td><td colspan="2">Heavy; may need extra structure</td></tr>
            <tr><th scope="row">Order to install</th><td class="ours">Within a month, CNC-cut to fit the first time</td><td colspan="2">Often a multi-week construction project</td></tr>
            <tr><th scope="row">Opens up</th><td class="ours">Clearfold and Hybrid fold to the side</td><td colspan="2">Depends on how many windows open</td></tr>
            <tr><th scope="row">Scratches</th><td class="ours">Needs gentle cleaning: soft cloth, mild soap</td><td colspan="2">Glass resists scratching better</td></tr>
          </tbody>
        </table>
      </div>
      <p class="fine">Sunroom ranges from the HomeGuide cost guide (Oct 2026) on 224 sq ft of floor. A&amp;E range uses Clearfixed (${cf.msrp}) to Clearfold (${cfo.msrp}) per sq ft on 240 sq ft of openings. Weight and impact resistance are general properties of polycarbonate (Palram Industries), not test results for a complete enclosure.</p>
      <CompareBars />
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <div class="stack">
        <h2 class="h2">Bend it. <span class="y">It comes back.</span></h2>
        <p class="lede">Polycarbonate is far more impact resistant than ordinary glass. Flex a panel hard and it springs back flat, so a stray ball or a falling branch doesn't turn into broken glass on your patio.</p>
        <p class="muted">Two tints, named like sunglass lenses. <strong style="color:var(--ink)">Midnight Smoke</strong> is darker from outside while you still see the yard. <strong style="color:var(--ink)">Storm Blue</strong> is the other option. We bring real samples to your site visit.</p>
        <div class="tints"><span><i style="background:#2a2a2c"></i>Midnight Smoke</span><span><i style="background:#3d6a9a"></i>Storm Blue</span></div>
      </div>
      <figure class="dim-frame video-frame">
        <video width="480" height="854" src="/video/bend-test.mp4" poster="/video/bend-poster.jpg" autoplay muted loop playsinline preload="metadata" aria-label="A&E polycarbonate panel being flexed by hand and springing back flat"></video>
        <span class="tag">Real panel, real hands</span>
      </figure>
    </div>
  </section>

  <section class="band raised">
    <div class="wrap">
      <div class="split" style="align-items:start">
        <div>
          <span class="facts-label">The facts</span>
          <table class="facts">
            <caption>Midnight Smoke polycarbonate</caption>
            <tbody>
              <tr><th scope="row">Visible light</th><td>{FACTS.vlt} transmission*</td></tr>
              <tr><th scope="row">Solar heat gain</th><td>{FACTS.shgc} SHGC*</td></tr>
              <tr><th scope="row">Fixed panel wind rating</th><td>Up to {FACTS.fixedWind}</td></tr>
              <tr><th scope="row">Folding panels</th><td>Operate to {FACTS.foldWind}; retract and secure for {FACTS.foldStowed}</td></tr>
              <tr><th scope="row">Panel thickness</th><td>4 mm (Clearfixed)</td></tr>
              <tr><th scope="row">Frame</th><td>Heat welded, no screws. PVC-fiber blend, aluminum core, scratch-resistant ceramic coating. Night Gray or Bright White.</td></tr>
            </tbody>
          </table>
          <p class="fine" style="margin-top:10px">*Tested on Midnight Smoke panels.</p>
        </div>
        <div class="stack">
          <h2 class="h3">What a 3-season room is, and isn't</h2>
          <p class="muted">It is shaded, sheltered and ventilated through screen doors and doors that open on both sides. It is not air-conditioned. On the hottest August afternoons it feels close to the outdoor temperature, just out of the sun, wind and rain. Spring, fall and most of winter are when it shines.</p>
          <p class="muted">Want the breeze on the hottest days? Put polycarbonate on the sunny or windy side and <a href="/hexfold/">Hexfold</a> screens facing the yard, or choose the Hybrid.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2">Three ways <span class="y">to build it</span></h2>
        <p class="lede">Typical medium patio (about 16 × 14 ft, two open sides): Clearfixed {range(31, 200, 300)}, Clearfold {range(40, 200, 300)}, Hybrid {range(56, 200, 300)}.</p>
      </div>
      <div class="lineup">
        <ProductCard p={byId('clearfixed')} img={clearfixed} alt="Clearfixed polycarbonate panels" link={false} />
        <ProductCard p={byId('clearfold')} img={smoke} alt="Folding polycarbonate panels in the A&E showroom" link={false} />
        <ProductCard p={byId('hybrid')} img={interior} alt="Showroom room with polycarbonate panels and metal mesh" link={false} />
      </div>
      <p class="fine" style="margin-top:16px">Arched and angled fixed panels are priced at 1.5 times the base rate. Locks and some track upgrades are extra; your quote lists every item.</p>
    </div>
  </section>

  <section class="band on-paper">
    <div class="wrap split" style="align-items:start">
      <div class="stack-lg">
        <h2 class="h2">Straight <span class="y">answers</span></h2>
        <figure style="margin:0"><Image src={rack} alt="Blue polycarbonate panels on a rack in the A&E panel room" widths={[480, 800]} sizes="(max-width: 820px) 100vw, 540px" loading="lazy" style="border:2px solid var(--paper-ink)" /><figcaption class="fine" style="padding-top:8px">Polycarbonate panels cut in our own panel room on William Tell Street.</figcaption></figure>
      </div>
      <Faq items={[...FAQ.room, FAQ.general[0], FAQ.general[1]]} />
    </div>
  </section>

  <section class="band raised" id="quote">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Get your <span class="y">exact price</span></h2>
        <p class="lede">Free site visit. We measure every opening, bring tint samples and give you a number you can plan around.</p>
      </div>
      <QuoteForm id="room-visit" source="3-season rooms page" />
    </div>
  </section>
</Base>

<style>
  .video-frame video { aspect-ratio: 9 / 16; max-height: 560px; width: auto; margin-inline: auto; background: var(--honey); }
  .video-frame { justify-self: center; }
  .tints { display: flex; flex-wrap: wrap; gap: 10px 22px; color: var(--ink-2); }
  .tints span { display: inline-flex; align-items: center; gap: 8px; }
  .tints i { width: 22px; height: 22px; border: 2px solid var(--yellow); display: inline-block; }
</style>
