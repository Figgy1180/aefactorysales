---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site';
---
<Base title="Thanks for Your Review | A&E Factory Sales" description="Thank you for reviewing A&E Factory Sales." noindex>
  <section class="band blueprint">
    <div class="wrap stack-lg" style="max-width:46em">
      <h1 class="display">Thank you. <span class="y">It means a lot.</span></h1>
      <p class="sub">Your review went straight to our team.</p>
      {SITE.googleReviewUrl && <div class="stack"><p class="lede">Would you post the same words on Google? It helps Houston homeowners find us.</p><div class="actions"><a class="btn" href={SITE.googleReviewUrl} rel="noopener">Post it on Google</a></div></div>}
      <div class="actions"><a class="btn btn-line" href="/projects/">See our projects</a><a class="btn btn-line" href="/">Home</a></div>
    </div>
  </section>
</Base>
