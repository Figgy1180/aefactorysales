---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { FAQ, SITE, byId, SIZES, range } from '../data/site';
import doorsOpen from '../assets/photos/fixed-screen-doors-open.jpg';
import doorsClosed from '../assets/photos/fixed-screen-doors-closed.jpg';
import colors from '../assets/photos/fixed-screen-frame-colors.jpg';
import roomCorner from '../assets/photos/screened-patio-room-corner.jpg';
import doorWhite from '../assets/photos/fixed-screen-doors-white.jpg';
import doorFrame from '../assets/photos/fixed-screen-door-frame.jpg';

const fx = byId('fixed');
const crumbs = [{ name: 'Stainless steel screens', href: '/screens/' }];
const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Fixed Screen stainless steel patio screen',
  brand: { '@type': 'Brand', name: 'AE Factory Sales' },
  manufacturer: { '@id': `${SITE.url}/#business` },
  description: 'Fixed patio screen panels with 304 stainless steel mesh in a heat-welded frame: PVC-fiber blend with an aluminum core and ceramic coating. Panels up to 3.5 × 10 ft, arches and angles available, pet doors available.',
  material: '304 stainless steel mesh, heat-welded PVC-fiber frame with aluminum core and ceramic coating',
  offers: {
    '@type': 'Offer', priceCurrency: 'USD', availability: 'https://schema.org/InStock', seller: { '@id': `${SITE.url}/#business` },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: fx.msrp, priceCurrency: 'USD', unitText: 'square foot of opening, installed' },
  },
};
---
<Base
  title="Stainless Steel Patio Screens in Houston | AE Factory Sales"
  description="Fixed Screen: 304 stainless steel mesh in a metal-reinforced, heat-welded frame, with an optional doggy door. From $24 per sq ft of opening installed."
  crumbs={crumbs}
  schema={[product]}
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <h1 class="display">Stainless steel screens <span class="y">for your covered patio</span></h1>
        <p class="sub">Fixed Screen uses stainless steel mesh for openings you want to keep screened. See the material beside a soft-mesh sample and choose the panel layout that fits your patio. For patios, French doors, front doors and garages.</p>
        <div class="actions"><a class="btn" href="#quote">Compare screen samples at my home</a><a class="btn btn-line" href="#vs-nylon">Compare the mesh</a><a class="btn btn-line" href="#pets">Doggy door</a></div>
      </div>
      <div class="pair" style="padding-top:30px">
        <figure class="dim-frame draw"><span class="dim h" aria-hidden="true"><span>Open</span></span><Image src={doorsOpen} alt="French doors with AE stainless steel screen doors open" widths={[320, 600]} sizes="(max-width: 820px) 46vw, 270px" loading="eager" style="aspect-ratio:3/5" /></figure>
        <figure class="dim-frame draw"><span class="dim h" aria-hidden="true"><span>Closed</span></span><Image src={doorsClosed} alt="The same French doors with stainless steel screens closed" widths={[320, 600]} sizes="(max-width: 820px) 46vw, 270px" loading="eager" style="aspect-ratio:3/5" /></figure>
      </div>
    </div>
  </PageHero>

  <section class="band on-paper" id="vs-nylon">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 class="h2">Compare the mesh, <span class="y">not just the frame</span></h2>
        <p class="lede">A metal frame does not tell you what the screen itself is made of. Ask which mesh you are buying. Our fixed screen uses stainless steel; our folding screen uses honeycomb aluminum.</p>
      </div>
      <div class="table-wrap">
        <table class="tbl">
          <thead><tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">AE Fixed Screen</th><th scope="col">Typical soft-mesh screen</th></tr></thead>
          <tbody>
            <tr><th scope="row">Mesh</th><td class="ours">304 stainless steel</td><td>Fiberglass, polyester or nylon</td></tr>
            <tr><th scope="row">Pets</th><td class="ours">Doggy door add-on for a compatible panel</td><td>Varies by product</td></tr>
            <tr><th scope="row">Frame</th><td class="ours">Metal-reinforced: aluminum core inside a heat-welded PVC-fiber blend, ceramic coating, no screws</td><td>Usually screwed or snapped together</td></tr>
            <tr><th scope="row">Fit</th><td class="ours">CNC-cut to your openings, checked before install</td><td>Cut on site</td></tr>
            <tr><th scope="row">Price</th><td class="ours">From ${fx.msrp} per sq ft of opening, installed</td><td>About $10 to $25 per floor sq ft (HomeGuide)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="fine">Soft-mesh pricing from HomeGuide. Soft-mesh products vary; compare the actual mesh you are offered. A 16 × 14 ft patio with two open sides runs about $5,800 in Fixed Screen.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap split" style="align-items:start">
      <div>
        <span class="facts-label">The facts</span>
        <table class="facts">
          <caption>Fixed Screen</caption>
          <tbody>
            {fx.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
            <tr><th scope="row">Arches and angles</th><td>Cut on a dedicated angle saw, priced at 1.5 times the base rate</td></tr>
            <tr><th scope="row">Typical patio</th><td class="tnum">{SIZES.map((s) => `${s.name} ${range(fx.msrp, s.low, s.high)}`).join('; ')}</td></tr>
            <tr><th scope="row">Frame colors</th><td>Night Gray or Bright White</td></tr>
            <tr><th scope="row">Warranty</th><td>Lifetime on the frame, 3 years on parts</td></tr>
          </tbody>
        </table>
      </div>
      <figure style="margin:0"><Image src={colors} alt="Two Fixed Screen panels with 304 stainless steel mesh, one in Night Gray and one in Bright White" widths={[480, 1000]} sizes="(max-width: 820px) 100vw, 540px" loading="lazy" style="border:2px solid var(--yellow)" /><figcaption class="fine" style="padding-top:8px">Frames in Night Gray or Bright White. We bring samples to your site visit.</figcaption></figure>
    </div>
  </section>

  <section class="band raised" id="pets" aria-labelledby="pets-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="pets-title" class="h2">A doggy door <span class="y">belongs in the plan</span></h2>
        <p class="lede">Add a dedicated doggy door in a compatible screen panel. We check the available size and placement with you, along with screen doors and shaped openings.</p>
      </div>
      <div class="pets">
        <div><h3>Stainless steel mesh</h3><p>304 stainless steel instead of fabric, so your dog lives with metal mesh, not a soft screen.</p></div>
        <div><h3>A metal-reinforced frame</h3><p>Heat welded around an aluminum core, with no screws, and CNC-cut to your opening.</p></div>
        <div><h3>A door of its own</h3><p>The doggy door is an add-on. Ask how its closure affects unwanted animal access, since any pet opening is also a way in.</p></div>
      </div>
      <p class="pets-note"><b>Straight talk:</b> no screen is indestructible, and we do not sell anything as pet-proof. What we can promise is metal mesh instead of fabric, a lifetime warranty on the frame and 3 years on parts. The warranty excludes accidents and intentional damage.</p>
      <div class="actions"><a class="btn" href="#quote">Get my price</a><a class="btn btn-line" href="/pet-proof-patio-screens/">Screens for homes with pets</a></div>
    </div>
  </section>

  <section class="band" aria-labelledby="pest-title">
    <div class="wrap split" style="align-items:center">
      <div class="stack">
        <h2 id="pest-title" class="h2">Metal screens fitted to help keep <span class="y">bugs and small pests</span> outside</h2>
        <p class="lede">Your patio may need more than mosquito screening. Tell us about mice, snakes or raccoons around your home. We look at the mesh, frame, bottom edges, doors and any pet opening when recommending your enclosure.</p>
        <p>The fit around the screen matters as much as the screen itself. Ask us to show how the edges and entry points are handled on your patio.</p>
        <div class="actions"><a class="btn" href="#quote">Check my patio's openings</a></div>
      </div>
      <p class="fine" style="align-self:end">We do not promise a pest-free patio or snake- or raccoon-proof screens.</p>
    </div>
  </section>

  <section class="band on-paper">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 class="h2">Where <span class="y">it goes</span></h2>
        <p class="lede">Full patio walls, French doors, front doors and garage openings. Want the screen to disappear when you're not using it? Look at <a href="/hexfold/">Hexfold</a>.</p>
      </div>
      <div class="gallery">
        <figure><Image src={roomCorner} alt="Patio enclosed with fixed metal mesh screens" widths={[360, 700]} sizes="(max-width: 640px) 50vw, 380px" loading="lazy" /><figcaption>Patio walls</figcaption></figure>
        <figure><Image src={doorWhite} alt="Stainless steel screen door on a white French door" widths={[360, 700]} sizes="(max-width: 640px) 50vw, 380px" loading="lazy" /><figcaption>French doors</figcaption></figure>
        <figure><Image src={doorFrame} alt="Screen door frame detail on a brick wall" widths={[360, 700]} sizes="(max-width: 640px) 50vw, 380px" loading="lazy" /><figcaption>Frame detail</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap split" style="align-items:start">
      <h2 class="h2">Screen <span class="y">questions</span></h2>
      <Faq items={[FAQ.screens[1], FAQ.screens[2], FAQ.screens[4], FAQ.general[1], FAQ.general[3], FAQ.general[4]]} />
    </div>
  </section>

  <RelatedLinks match="fixed" title="Screens on real Houston homes" />

  <section class="band raised" id="quote">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 class="h2">Get your <span class="y">screen quote</span></h2>
        <p class="lede">Tell us about your openings and a rep will call you with a quote.</p>
      </div>
      <QuoteForm id="screen-visit" kind="screens" source="Screens page" />
    </div>
  </section>
</Base>
<style>
  .pets { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .pets > div { border-top: 2px solid var(--yellow); padding-top: 14px; min-width: 0; }
  .pets h3 { font-weight: 800; font-stretch: 78%; font-size: 1.3rem; text-transform: uppercase; }
  .pets p { color: var(--ink-2); margin-top: 6px; }
  .pets-note { border-left: 6px solid var(--yellow); padding: 14px 18px; max-width: 820px; color: var(--ink-2); }
  @media (max-width: 760px) { .pets { grid-template-columns: minmax(0, 1fr); } }
</style>
