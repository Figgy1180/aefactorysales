---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CompareBars from '../components/CompareBars.astro';
import { SITE, EXAMPLE } from '../data/site';

const crumbs = [{ name: 'Compare', href: '/compare/' }];
type Row = { name: string; ours?: boolean; cost: string; bugs: string; weather: string; opens: string; parts: string; ongoing: string; href?: string };
const rows: Row[] = [
  { name: 'AE Fixed Screen', ours: true, href: '/patio-screens/fixed-screen/', cost: '$5,800', bugs: 'Yes: 304 stainless steel mesh', weather: 'No', opens: 'No, stays in place', parts: 'None', ongoing: 'Lifetime frame warranty' },
  { name: 'AE Hexfold', ours: true, href: '/patio-screens/hexfold/', cost: '$6,700', bugs: 'Yes: honeycomb aluminum mesh', weather: 'No', opens: 'Yes, folds by hand', parts: 'Wheels and track, no motor', ongoing: 'Lifetime frame warranty' },
  { name: 'AE 3-season room', ours: true, href: '/patio-enclosures/three-season-rooms/', cost: '$7,400 to $9,600', bugs: 'Yes', weather: 'Yes: tinted polycarbonate', opens: 'Clearfold and Hybrid fold open', parts: 'No motor', ongoing: 'Lifetime frame warranty' },
  { name: 'Nylon or fiberglass screen', cost: '$2,200 to $5,600', bugs: 'Insects; varies by mesh', weather: 'No', opens: 'Usually no', parts: 'None', ongoing: 'Rescreening over time (HomeGuide: every 5 to 10 years)' },
  { name: 'Motorized roll-down screens', cost: '$9,600 to $10,800', bugs: 'Insects; varies by mesh', weather: 'Varies by product', opens: 'Yes, by motor', parts: 'Motor, wiring, remote', ongoing: 'Motor and electronics to maintain' },
  { name: '3-season sunroom', cost: '$18,000 to $52,000', bugs: 'Yes', weather: 'Yes', opens: 'Depends on windows', parts: 'Windows and doors', ongoing: 'Varies' },
  { name: '4-season glass sunroom', cost: '$45,000 to $90,000', bugs: 'Yes', weather: 'Yes, and conditioned', opens: 'Depends on windows', parts: 'Windows, doors, HVAC', ongoing: 'Conditioned space to heat and cool' },
  { name: 'Mosquito yard spraying', cost: '$350 to $1,000 per season', bugs: 'Reduces mosquitoes only', weather: 'No', opens: 'Not applicable', parts: 'None', ongoing: '$3,500 to $10,000 over 10 years' },
];
const bars = [
  ...EXAMPLE.rows,
  { name: 'Nylon screen, one rescreen', low: 2700, high: 6600, ours: false },
  { name: 'Mosquito spraying, 10 years', low: 3500, high: 10000, ours: false },
].sort((a, b) => b.high - a.high);
const vs = [
  {
    id: 'nylon', t: 'Metal screens vs nylon screens',
    lead: 'Fabric screen costs less up front. Metal mesh is what you get with ours, standard.',
    rows: [['Mesh', '304 stainless (Fixed Screen) or honeycomb aluminum (Hexfold)', 'Nylon or fiberglass fabric'], ['Upkeep', 'Lifetime frame warranty, 5 years on parts', 'Rescreen every 5 to 10 years'], ['Example patio', '$5,800 to $6,700', '$2,200 to $5,600']],
    pick: 'Lowest price today: fabric. Metal mesh and a lifetime frame: us.',
    link: ['/patio-screens/fixed-screen/', 'Stainless steel screens'],
  },
  {
    id: 'motorized', t: 'Hexfold vs motorized screens',
    lead: 'Both disappear when you want the view. One rolls on a motor, one folds by hand.',
    rows: [['Example patio', 'About $6,700', '$9,600 to $10,800'], ['Power needed', 'None', 'Yes, at each opening'], ['What can fail', 'Wheels and track', 'Motor, wiring, remote']],
    pick: 'Push-button convenience: motorized. The retractable look with less to break, for about a third less: Hexfold.',
    link: ['/guides/folding-vs-motorized-patio-screens/', 'Folding vs motorized guide'],
  },
  {
    id: 'glass', t: '3-season room vs glass sunroom',
    lead: 'A sunroom builds a new room. We close in the patio you already have, so prices are not like for like.',
    rows: [['Example patio', '$7,400 to $9,600', '$18,000 to $90,000'], ['Panels', 'Polycarbonate: light, tough, folds; scratches easier', 'Glass: clearer, heavier'], ['Air conditioning', 'No, ventilated', '4-season rooms are conditioned']],
    pick: 'Need an air-conditioned room in August: a 4-season sunroom. Shade and shelter on your existing patio: us.',
    link: ['/guides/polycarbonate-vs-glass-patio-enclosure-cost/', 'Polycarbonate vs glass guide'],
  },
  {
    id: 'spraying', t: 'Screens vs mosquito spraying',
    lead: 'Spraying lowers mosquitoes across the yard for a season. Screens cover the patio itself.',
    rows: [['Cost', '$5,800 to $9,600 once', '$350 to $1,000 per season'], ['Over 10 years', 'Same one-time price', '$3,500 to $10,000'], ['Covers', 'The enclosed patio', 'The whole yard']],
    pick: 'Time all over the yard: spraying. Time on the patio: screens. They work fine together.',
    link: ['/pricing/', 'See our prices'],
  },
];
const ld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: 'Patio enclosure options compared: screens, sunrooms, motorized and spraying (Houston, 2026)',
  datePublished: '2026-11-09', dateModified: '2026-11-23', author: { '@id': `${SITE.url}/#business` }, publisher: { '@id': `${SITE.url}/#business` },
  mainEntityOfPage: `${SITE.url}/compare/`,
};
const retrofit = {
  cols: ['AE polycarbonate room', 'Vinyl porch windows', 'Glass enclosure', 'Fabric screens', 'Motorized shades'],
  rows: [
    ['Material', ['Tinted polycarbonate, heat-welded frame', 'Flexible vinyl', 'Glass', 'Fiberglass or polyester mesh', 'Fabric on a motorized roller']],
    ['Opens', ['Fixed, or folds by hand', 'Slides or stacks to vent', 'Depends on the system', 'Usually fixed', 'Rolls up by motor']],
    ['Wind and rain', ['Blocks it; fold open for air', 'Blocks it', 'Blocks it', 'Little protection', 'Depends on the product']],
  ] as [string, string[]][],
};
---
<Base
  title="Patio Enclosure Options Compared: Houston Costs (2026) | AE"
  description="AE metal screens and 3-season rooms compared with nylon screens, motorized screens, glass sunrooms and mosquito spraying, with real Houston costs."
  crumbs={crumbs}
  schema={[ld]}
>
  <PageHero crumbs={crumbs}>
    <div class="stack-lg" style="max-width:56em">
      <h1 class="display">Every option, <span class="y">side by side</span></h1>
      <p class="sub">The same 16 × 14 ft Houston patio, every way you could do it, with real costs.</p>
      <nav aria-label="On this page"><ul class="jump">
        <li><a href="#table">At a glance</a></li><li><a href="#cost">Cost</a></li>
        {vs.map((v) => <li><a href={`#${v.id}`}>{v.t}</a></li>)}
      </ul></nav>
    </div>
  </PageHero>

  <section class="band" id="retrofit" aria-labelledby="retrofit-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="retrofit-title" class="h2">Options for an existing covered patio</h2>
        <p class="lede">In general terms; specific products vary.</p>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-label="Retrofit options compared, scrollable">
        <table class="tbl">
          <thead><tr><th scope="col">Feature</th>{retrofit.cols.map((c, i) => <th scope="col" class={i === 0 ? 'ours' : undefined}>{c}</th>)}</tr></thead>
          <tbody>
            {retrofit.rows.map(([k, v]) => <tr><th scope="row">{k}</th>{v.map((x, i) => <td class={i === 0 ? 'ours' : undefined}>{x}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band on-paper" id="table" aria-labelledby="table-title">
    <div class="wrap stack-lg">
      <div class="sec-head" style="margin-bottom:0">
        <h2 id="table-title" class="h2">At <span class="y">a glance</span></h2>
        <p class="lede">Example patio: {EXAMPLE.label} (about {EXAMPLE.openings} sq ft of openings, {EXAMPLE.floor} sq ft of floor).</p>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-label="At a glance (table 1)">
        <table class="tbl matrix">
          <thead><tr><th scope="col">Option</th><th scope="col">Example patio</th><th scope="col">Bugs</th><th scope="col">Wind and rain</th><th scope="col">Opens up</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr class={r.ours ? 'mine' : ''}>
                <th scope="row">{r.href ? <a href={r.href}>{r.name}</a> : r.name}</th>
                <td class="tnum">{r.cost}</td><td>{r.bugs}</td><td>{r.weather}</td><td>{r.opens}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">AE: our lowest installed prices on 240 sq ft of openings. Others: HomeGuide and Bob Vila (Oct 2026); motorized at $40 to $45 per sq ft of opening, Houston pricing.</p>
    </div>
  </section>

  <section class="band on-paper" id="cost" style="padding-top:0">
    <div class="wrap">
      <CompareBars rows={bars} title="What the same patio costs" footnote="Nylon includes one rescreen. Spraying is 10 seasons. Sources as above." />
    </div>
  </section>

  {vs.map((v, i) => (
    <section class={`band${i % 2 ? ' raised' : ''}`} id={v.id} aria-labelledby={`${v.id}-t`}>
      <div class="wrap stack-lg">
        <div class="sec-head" style="margin-bottom:0">
          <h2 id={`${v.id}-t`} class="h2">{v.t}</h2>
          <p class="lede">{v.lead}</p>
        </div>
        <div class="table-wrap" tabindex="0" role="region" aria-label={`${v.t} (table)`}>
          <table class="tbl">
            <thead><tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">AE</th><th scope="col">The alternative</th></tr></thead>
            <tbody>{v.rows.map(([k, a, b]) => <tr><th scope="row">{k}</th><td class="ours">{a}</td><td>{b}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="pick">{v.pick}</p>
        <p><a href={v.link[0]}>{v.link[1]}</a></p>
      </div>
    </section>
  ))}

  <section class="band on-paper">
    <div class="wrap split">
      <div class="stack">
        <h2 class="h2">Still deciding? <span class="y">See it first.</span></h2>
        <div class="actions"><a class="btn" href="/patio-visualizer/">See it on my patio</a><a class="btn btn-line" href="/book-visit/">Book free design visit</a></div>
      </div>
      <p class="muted">Or call {SITE.phone}.</p>
    </div>
  </section>
</Base>

<style>
  .jump { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a { display: inline-block; border: 1px solid var(--line); padding: 8px 14px; color: var(--ink); text-decoration: none; font-weight: 600; }
  .jump a:hover { border-color: var(--yellow); color: var(--yellow); }
  .matrix { min-width: 720px; }
  .matrix tr.mine th, .matrix tr.mine td { background: rgba(242, 194, 48, 0.28); }
  .matrix tbody th a { color: var(--paper-ink); }
  .pick { border-left: 6px solid var(--yellow); background: var(--honey-2); padding: 14px 18px; max-width: 72ch; margin: 0; }
  .raised .pick { background: var(--honey); }
  .pick-k { font-weight: 800; font-stretch: 80%; text-transform: uppercase; color: var(--yellow); }
</style>
