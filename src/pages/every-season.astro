---
// Landing page for the every-season door hanger (QR: /every-season/?src=hanger-every-qr, typed: /every-season).
// Every form lead from here is tagged "Every-season door hanger" in the email to info@.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE, FACTS, WARRANTY, byId, range, type QA } from '../data/site';
import freestanding from '../assets/projects/p34/1-corner-closed.jpg';
import panels from '../assets/photos/clearfixed-polycarbonate-panels.jpg';
import hexOpen from '../assets/photos/hexfold-patio-open.jpg';
import hexClosed from '../assets/photos/hexfold-patio-closed.jpg';

const crumbs = [{ name: 'Every season', href: '/every-season/' }];
const faq: QA[] = [
  { q: 'Can I mix panels and screens on one patio?', a: 'Yes, opening by opening. A common setup is tinted panels on the windy or sunny side and Hexfold screens facing the yard. We lay it out with you at the site visit.' },
  { q: 'What is the Hybrid?', a: `Polycarbonate panels and honeycomb aluminum mesh in one folding system, so each opening can be a wall or a screen. It is our top shelf at $${byId('hybrid').msrp} per sq ft of opening.` },
  { q: 'What about storms?', a: `Fixed panels are rated to ${FACTS.fixedWind}. Folding panels and Hexfold screens operate to about ${FACTS.foldWind}, and you retract and secure them for ${FACTS.foldStowed} winds.` },
  { q: 'How soon can it be installed?', a: `Within a month of your order. Book a free site visit at ${SITE.phone} or with the form on this page.` },
];
---
<Base
  title="Patio Panels + Screens for Every Season | A&E Factory Sales"
  description="Tinted panels for cold snaps, Hexfold screens for mosquito season. Mix them opening by opening or get both in one Hybrid system. Built and installed in Houston."
  crumbs={crumbs}
  defaultSrc="hanger-every-url"
>
  <PageHero crumbs={crumbs}>
    <div class="split">
      <div class="stack-lg">
        <p class="eyebrow">Panels + screens</p>
        <h1 class="display">One patio. <span class="y">Every season.</span></h1>
        <p class="sub">Tinted panels for the cold snaps. Hexfold screens for mosquito season. Mix them opening by opening, or get both in one folding Hybrid system.</p>
        <div class="actions"><a class="btn" href="/free-quote/?use=all">Get my price in 60 seconds</a><a class="btn btn-line" href={SITE.phoneHref}>Call {SITE.phone}</a></div>
        <p class="fine">Free design and estimate. Built in our Houston factory. {WARRANTY}.</p>
      </div>
      <figure class="dim-frame draw" style="margin:30px 0 0">
        <span class="dim h" aria-hidden="true"><span>Built and installed in Houston</span></span>
        <Image src={freestanding} alt="Houston A&E enclosure with tinted polycarbonate panels and Hexfold screens" widths={[480, 900]} sizes="(max-width: 820px) 100vw, 540px" loading="eager" style="aspect-ratio:4/3;object-fit:cover" />
      </figure>
    </div>
  </PageHero>

  <section class="band on-paper" aria-labelledby="e-year">
    <div class="wrap stack-lg">
      <h2 id="e-year" class="h2">Your patio, <span class="y">all year</span></h2>
      <div class="seasons">
        <article><figure><Image src={panels} alt="Tinted polycarbonate panel wall" widths={[320, 600]} sizes="(max-width: 700px) 100vw, 280px" loading="lazy" /></figure><p class="k">Winter</p><h3>Panels closed</h3><p>Wind and rain stay out. Midnight Smoke lets {FACTS.vlt} of daylight through.</p></article>
        <article><figure><Image src={hexOpen} alt="Hexfold screens folded open on a brick patio" widths={[320, 600]} sizes="(max-width: 700px) 100vw, 280px" loading="lazy" /></figure><p class="k">Spring and fall</p><h3>Fold it open</h3><p>Folding panels and screens slide to the side for a fully open patio.</p></article>
        <article><figure><Image src={hexClosed} alt="Hexfold screens closed across a brick patio" widths={[320, 600]} sizes="(max-width: 700px) 100vw, 280px" loading="lazy" /></figure><p class="k">Summer</p><h3>Screens closed</h3><p>Hexfold honeycomb mesh, about 115 holes per sq in. Breeze in, mosquitoes out.</p></article>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="e-ways">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="e-ways" class="h2">Three ways <span class="y">to combine</span></h2>
        <p class="lede">Typical medium patio (about 20 × 12 ft, two open sides): Clearfold {range(byId('clearfold').msrp, 200, 300)}, Hexfold {range(byId('hexfold').msrp, 200, 300)}, Hybrid {range(byId('hybrid').msrp, 200, 300)}. Mix and match is priced opening by opening.</p>
      </div>
      <div class="lineup">
        <ProductCard p={byId('clearfold')} img={panels} alt="Tinted polycarbonate panels" link={false} />
        <ProductCard p={byId('hexfold')} img={hexClosed} alt="Hexfold retractable screens on a Houston patio" link={false} />
        <ProductCard p={byId('hybrid')} img={freestanding} alt="Enclosure with panels and screens" link={false} />
      </div>
      <p style="margin-top:22px"><a class="btn" href="/free-quote/?use=all">Compare all five systems for my patio</a></p>
    </div>
  </section>

  <section class="band on-paper" id="visit" aria-labelledby="e-form">
    <div class="wrap split" style="align-items:start">
      <div class="stack">
        <h2 id="e-form" class="h2">Book your <span class="y">free site visit</span></h2>
        <p class="lede">We measure, show you samples and lay out panels and screens opening by opening. Rather talk now? Call {SITE.phone}.</p>
        <Faq items={faq} />
      </div>
      <QuoteForm id="every-visit" source="Every-season landing page" />
    </div>
  </section>
</Base>

<style>
  .eyebrow { font-family: var(--mono); font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; color: var(--yellow); }
  .seasons { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .seasons article { min-width: 0; display: grid; gap: 6px; align-content: start; }
  .seasons figure { margin: 0 0 8px; }
  .seasons :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 2px solid var(--paper-ink); }
  .seasons .k { font-family: var(--mono); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--paper-2); }
  .seasons h3 { font-weight: 800; font-stretch: 78%; font-size: 1.35rem; text-transform: uppercase; }
  .seasons p:not(.k) { color: var(--paper-2); }
  @media (max-width: 820px) { .seasons { grid-template-columns: minmax(0, 1fr); } }
</style>
